#!/usr/bin/env bash
# Portfolio's half of `deploy`: the push is what kicks the build off, so there
# is normally nothing to do here, and bin/wait-for-deploy watches for it to
# land. Everything else — the commit message, the `eq` queue, the push, the
# prodExec scripts afterwards — is the generic `deploy` in
# ~/code/scripts/helpers/deploy.sh.
#
# Called as: bin/deploy-trigger <branch> <env>   ($DEPLOY_BRANCH / $DEPLOY_ENV)
# $DEPLOY_PUSHED=0 means the push moved nothing (`deploy -f`), so no workflow
# is coming on its own — it gets started by hand, which redeploys what is live.
set -euo pipefail

branch="${1:-${DEPLOY_BRANCH:-master}}"
env="${2:-${DEPLOY_ENV:-production}}"

if [[ "$env" != "production" ]]; then
  echo "deploy-trigger: Portfolio only deploys production, not '$env'" >&2
  exit 1
fi

if [[ "${DEPLOY_PUSHED:-1}" == 0 ]]; then
  echo "deploy-trigger: nothing new pushed — starting the deploy workflow on $branch"
  gh workflow run deploy.yml --ref "$branch"
fi
