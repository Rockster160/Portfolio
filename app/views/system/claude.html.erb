<%= meta_title "Claude on the Mini", include_name: false %>
<%= meta_description "Claude sessions working on Portfolio on the Mac Mini, and every /feature build." %>

<%
  zone = current_user.timezone
  stamp = ->(time) { time ? time.in_time_zone(zone).strftime("%b %-d, %-I:%M %p") : "—" }
  parse = ->(iso) { Time.zone.parse(iso.to_s) if iso.present? }
  thread_url = ->(conversation) { byte_root_url(subdomain: :byte, conversation_id: conversation.id) }
  builds_by_id = @builds.index_by(&:id)
  kind_label = { audit: "Daily audit", builder: "Feature build", claude: "Claude thread", questions: "Questions" }
  build_state = ->(build) { FeatureBuilder.stage(build, @live[build.id]) }
  queue_label = {
    landing:  "merging now",
    held:     "held",
    approved: "approved, in line",
    answer:   "waiting on your answer",
    review:   "waiting on your review",
  }
  # Each build is listed once, in the first section that has it: the merge
  # queue, waiting on you, then running, then the rest of the history.
  shown = @queue.map(&:id)
  waiting = [
    *@pending[:questions].map { |build| [build, "waiting on you"] },
    *@pending[:prs].map { |build| [build, "PR open"] },
  ].reject { |build, _| shown.include?(build.id) }
  shown += waiting.map { |build, _| build.id }
  running = @sessions.reject { |session| shown.include?(session["build_id"].to_i) }
  shown += running.filter_map { |session| session["build_id"]&.to_i }
  history = @builds.reject { |build| shown.include?(build.id) }
%>

<div class="system-page">
  <div class="lists-title">
    <small><%= link_to "System", system_path %> / Claude on the Mini</small>
  </div>

  <div class="cs-ask">
    <%= button_to "Ask Claude", system_claude_questions_path,
          class: "cs-ask-btn", form_class: "cs-ask-form",
          data: { disable_with: "Opening Claude…" } %>
    <span class="cs-ask-note">One Claude session on the Mini for questions. It opens the running one, or starts it.</span>
  </div>

  <% if @queue.any? || @deploying.any? %>
    <h3 class="cs-heading" id="merge-queue">Merge queue</h3>
    <p class="cs-empty">Approved PRs merge one at a time, top first. Each one's session catches up with master and makes it fit before it merges, closes, or asks you for another review. After a merge the line waits until production is running it and answering.</p>
    <% @deploying.each do |build| %>
      <div class="cs-row cs-queue cs-queue-deploying">
        <div class="cs-head">
          <div class="cs-title"><%= build.title %></div>
          <div class="cs-meta"><span class="cs-badge">merged, waiting on its deploy since <%= stamp.call(build.finished_at) %></span></div>
        </div>
        <div class="cs-links">
          <%= link_to "PR ##{build.pr_number}", build.pr_url, class: "cs-link", target: :_blank, rel: :noopener %>
        </div>
      </div>
    <% end %>
    <% @queue.each_with_index do |build, index| %>
      <% state = MergeQueue.state(build) %>
      <div class="cs-row cs-queue cs-queue-<%= state %>">
        <div class="cs-head">
          <div class="cs-title"><span class="cs-queue-number"><%= index + 1 %></span><%= build.title %></div>
          <div class="cs-meta">
            <span class="cs-badge"><%= queue_label[state] %></span>
            <% if @live.dig(build.id, "working") %><span class="cs-badge">working</span><% end %>
          </div>
        </div>
        <div class="cs-links">
          <%= link_to "PR ##{build.pr_number}", build.pr_url, class: "cs-link", target: :_blank, rel: :noopener %>
          <% if build.rc_url.present? %>
            <%= link_to "Open in Claude", build.rc_url, class: "cs-link", target: :_blank, rel: :noopener %>
          <% end %>
          <span class="cs-queue-moves">
            <% { top: "⤒", up: "↑", down: "↓", bottom: "⤓" }.each do |move, arrow| %>
              <%= button_to arrow, system_claude_queue_path(id: build.id, act: move),
                    class: "cs-link cs-queue-move", form_class: "cs-stop-form basic", title: "Move #{move}" %>
            <% end %>
          </span>
          <% unless state == :landing %>
            <% if build.approved_at %>
              <%= button_to "Unapprove", system_claude_queue_path(id: build.id, act: :unapprove), class: "cs-link", form_class: "cs-stop-form basic" %>
            <% else %>
              <%= button_to "Approve to merge", system_claude_queue_path(id: build.id, act: :approve), class: "cs-link cs-queue-approve", form_class: "cs-stop-form basic",
                    data: { confirm: "Merge this when its turn comes? Its session catches up with master first." } %>
            <% end %>
            <% if build.held? %>
              <%= button_to "Release", system_claude_queue_path(id: build.id, act: :release), class: "cs-link", form_class: "cs-stop-form basic" %>
            <% else %>
              <%= button_to "Hold", system_claude_queue_path(id: build.id, act: :hold), class: "cs-link", form_class: "cs-stop-form basic" %>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>

  <% if waiting.any? %>
    <h3 class="cs-heading">Waiting on you</h3>
    <% waiting.each do |build, reason| %>
      <div class="cs-row cs-waiting">
        <div class="cs-head">
          <div class="cs-title"><%= build.title %></div>
          <div class="cs-meta"><span class="cs-badge"><%= reason %></span></div>
        </div>
        <div class="cs-links">
          <% if build.rc_url.present? %>
            <%= link_to "Open in Claude", build.rc_url, class: "cs-link", target: :_blank, rel: :noopener %>
          <% end %>
          <% if build.pr_url.present? %>
            <%= link_to "PR ##{build.pr_number}", build.pr_url, class: "cs-link", target: :_blank, rel: :noopener %>
          <% end %>
          <%= render "system/claude_stop", build: build %>
        </div>
      </div>
    <% end %>
  <% end %>

  <h3 class="cs-heading">Running now</h3>
  <% if running.none? %>
    <p class="cs-empty">Nothing is running on Portfolio on the Mini.</p>
  <% end %>

  <% running.each do |session| %>
    <%
      kind = FeatureBuilder.kind_of(session, @conversations)
      build = builds_by_id[session["build_id"].to_i] || FeatureBuild.find_by(id: session["build_id"])
      conversation = @conversations[session["conversation_id"].to_i]
    %>
    <div class="cs-row <%= session["working"] ? "cs-working" : "cs-waiting" %>">
      <div class="cs-head">
        <div class="cs-title">
          <%= kind_label.fetch(kind) %>
          <% if build %>
            · <%= build.title %>
          <% elsif conversation %>
            · <%= link_to conversation.display_name, thread_url.call(conversation) %>
          <% end %>
        </div>
        <div class="cs-meta">
          <span class="cs-badge"><%= session["working"] ? "working" : "waiting on you" %></span>
          since <%= stamp.call(parse.call(session["started_at"])) %>
        </div>
      </div>
      <% if build %>
        <div class="cs-links">
          <% if build.rc_url.present? %>
            <%= link_to "Open in Claude", build.rc_url, class: "cs-link", target: :_blank, rel: :noopener %>
          <% end %>
          <%= render "system/claude_stop", build: build %>
        </div>
      <% end %>
    </div>
  <% end %>

  <% if history.any? || @builds.none? %>
    <h3 class="cs-heading">Feature builds</h3>
  <% end %>
  <% if @builds.none? %>
    <p class="cs-empty">No builds yet. Start one in any thread with <code>/feature add ...</code>.</p>
  <% end %>

  <% history.each do |build| %>
    <% state = build_state.call(build) %>
    <div class="cs-row cs-build-<%= state.parameterize %>">
      <div class="cs-head">
        <div class="cs-title"><%= build.title %></div>
        <div class="cs-meta">
          <span class="cs-badge"><%= state %></span>
          <%= stamp.call(build.created_at) %>
        </div>
      </div>
      <% if build.branch.present? %>
        <div class="cs-branch"><code><%= build.branch %></code></div>
      <% end %>
      <% if build.status_failed? %>
        <div class="cs-branch"><%= build.error %></div>
      <% end %>
      <div class="cs-links">
        <% if build.rc_url.present? && !build.status_finished? %>
          <%= link_to "Open in Claude", build.rc_url, class: "cs-link", target: :_blank, rel: :noopener %>
        <% end %>
        <% if build.pr_url.present? %>
          <%= link_to "PR ##{build.pr_number}", build.pr_url, class: "cs-link", target: :_blank, rel: :noopener %>
        <% end %>
        <%= render "system/claude_stop", build: build %>
      </div>
    </div>
  <% end %>
</div>

<%= content_for :head do %>
  <style>
    .system-page { max-width: 1000px; width: 95%; margin: 0 auto; padding: 20px; }
    .system-page .lists-title { font-size: 24px; margin-bottom: 16px; color: #E2E8F0; }
    .system-page .lists-title a { color: #8B949E; text-decoration: none; }

    .cs-heading { color: #C9D1D9; font-size: 16px; margin: 24px 0 10px; }
    .cs-empty { color: #8B949E; }

    .cs-row {
      background-color: #161B22; border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 8px; padding: 14px 16px; margin-bottom: 10px;
    }
    .cs-row.cs-working, .cs-row.cs-build-working, .cs-row.cs-build-planning, .cs-row.cs-build-building { border-color: rgba(88, 214, 141, 0.45); }
    .cs-row.cs-waiting, .cs-row.cs-build-waiting-on-you, .cs-row.cs-build-pr-open { border-color: rgba(245, 176, 65, 0.45); }
    .cs-row.cs-build-failed { border-color: rgba(236, 112, 99, 0.45); }
    .cs-row.cs-build-finished { opacity: 0.55; }

    .cs-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap; }
    .cs-title { font-size: 15px; font-weight: bold; color: #C9D1D9; }
    .cs-title a { color: #5DADE2; text-decoration: none; }
    .cs-meta { font-size: 12px; color: #8B949E; }
    .cs-badge {
      margin-right: 6px; padding: 1px 8px; border-radius: 10px;
      background-color: rgba(255, 255, 255, 0.08); color: #C9D1D9; font-size: 11px;
    }
    .cs-branch { margin-top: 6px; font-size: 12px; color: #8B949E; }

    .cs-links { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin-top: 10px; }
    .cs-links:empty { display: none; }
    .cs-link, .cs-stop {
      font-size: 12px; padding: 4px 10px; border-radius: 6px; text-decoration: none;
      border: 1px solid rgba(255, 255, 255, 0.12); background-color: #21262D; color: #C9D1D9; cursor: pointer;
    }
    .cs-stop {
      margin: 0; font-family: inherit; font-weight: normal; line-height: normal;
      box-shadow: none; text-shadow: none; color: #EC7063 !important; border-color: rgba(236, 112, 99, 0.4);
    }
    .cs-stop:hover, .cs-stop:active { background-color: #2D333B; box-shadow: none; }
    .cs-stop-form { display: flex; margin: 0; }

    .cs-row.cs-queue-landing { border-color: rgba(88, 214, 141, 0.7); }
    .cs-row.cs-queue-approved { border-color: rgba(88, 214, 141, 0.45); }
    .cs-row.cs-queue-answer, .cs-row.cs-queue-review { border-color: rgba(245, 176, 65, 0.45); }
    .cs-row.cs-queue-held { opacity: 0.6; }
    .cs-row.cs-queue-deploying { border-color: rgba(93, 173, 226, 0.6); }
    .cs-queue-number { display: inline-block; min-width: 22px; color: #8B949E; }
    .cs-queue-moves { display: inline-flex; gap: 4px; }
    .cs-queue-move { padding: 4px 8px; }
    .cs-queue-approve { color: #58D68D; border-color: rgba(88, 214, 141, 0.45); }

    .cs-ask { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; margin-bottom: 8px; }
    .cs-ask-form { margin: 0; }
    .cs-ask-btn {
      padding: 8px 16px; border-radius: 6px; font-size: 14px; font-weight: bold; cursor: pointer;
      background-color: #5DADE2; border: 1px solid #5DADE2; color: #0D1117;
    }
    .cs-ask-btn:disabled { opacity: 0.6; cursor: wait; }
    .cs-ask-note { font-size: 12px; color: #8B949E; }
  </style>
<% end %>
