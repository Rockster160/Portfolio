<%= meta_title "Claude on the Mini", include_name: false %>
<%= meta_description "Claude sessions working on Portfolio on the Mac Mini, and every Feature Builder." %>

<%
  zone = current_user.timezone
  stamp = ->(iso) {
    time = Time.zone.parse(iso.to_s) if iso.present?
    time ? time.in_time_zone(zone).strftime("%b %-d, %-I:%M %p") : "—"
  }
  thread_url = ->(conversation) { byte_root_url(subdomain: :byte, conversation_id: conversation.id) }
  kind_label = { audit: "Daily audit", builder: "Feature Builder", claude: "Claude thread" }
%>

<div class="system-page">
  <div class="lists-title">
    <small><%= link_to "System", system_path %> / Claude on the Mini</small>
  </div>

  <h3 class="cs-heading">Running now</h3>
  <% if @sessions.none? %>
    <p class="cs-empty">Nothing is running on Portfolio on the Mini.</p>
  <% end %>

  <% @sessions.each do |session| %>
    <% conversation = @conversations[session["conversation_id"].to_i] %>
    <% kind = FeatureBuilder.kind_of(session, @conversations) %>
    <div class="cs-row <%= session["working"] ? "cs-working" : "cs-waiting" %>">
      <div class="cs-head">
        <div class="cs-title">
          <%= kind_label.fetch(kind) %>
          <% if conversation %>
            · <%= link_to conversation.display_name, thread_url.call(conversation) %>
          <% end %>
        </div>
        <div class="cs-meta">
          <span class="cs-badge"><%= session["working"] ? "working" : "waiting on you" %></span>
          since <%= stamp.call(session["started_at"]) %>
        </div>
      </div>
      <div class="cs-links">
        <% if session["rc_url"].present? %>
          <%= link_to "Open in Claude", session["rc_url"], class: "cs-link", target: :_blank, rel: :noopener %>
        <% end %>
        <% if session["pr_url"].present? %>
          <%= link_to "Pull request", session["pr_url"], class: "cs-link", target: :_blank, rel: :noopener %>
        <% end %>
        <% if kind == :builder && conversation %>
          <%= button_to "Stop", system_claude_stop_path(conversation_id: conversation.id),
                class: "cs-stop", form_class: "cs-stop-form",
                data: { confirm: "Close this builder's session? Its work is kept, and a message in its thread picks it back up." } %>
        <% end %>
      </div>
    </div>
  <% end %>

  <h3 class="cs-heading">Feature Builders</h3>
  <% if @builders.none? %>
    <p class="cs-empty">No Feature Builder threads yet. Start one from Byte's new conversation menu.</p>
  <% end %>

  <% @builders.each do |conversation| %>
    <%
      info = conversation.metadata.to_h["builder"].to_h
      live = @live[conversation.id]
      status = (
        if info["finished_at"].present? then "finished"
        elsif live.nil? then (info["branch"].present? ? "stopped" : "not started")
        elsif live["working"] then "working"
        else "waiting on you"
        end
      )
    %>
    <div class="cs-row cs-builder-<%= status.parameterize %>">
      <div class="cs-head">
        <div class="cs-title"><%= link_to conversation.display_name, thread_url.call(conversation) %></div>
        <div class="cs-meta">
          <span class="cs-badge"><%= status %></span>
          <%= stamp.call(conversation.created_at.iso8601) %>
        </div>
      </div>
      <% if info["branch"].present? %>
        <div class="cs-branch"><code><%= info["branch"] %></code></div>
      <% end %>
      <div class="cs-links">
        <% if info["rc_url"].present? && info["finished_at"].blank? %>
          <%= link_to "Open in Claude", info["rc_url"], class: "cs-link", target: :_blank, rel: :noopener %>
        <% end %>
        <% if info["pr_url"].present? %>
          <%= link_to "Pull request", info["pr_url"], class: "cs-link", target: :_blank, rel: :noopener %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>

<%= content_for :head do %>
  <style>
    .system-page { max-width: 1000px; width: 95%; margin: 0 auto; padding: 20px; }
    .system-page .lists-title { font-size: 24px; margin-bottom: 16px; color: #E2E8F0; }
    .system-page .lists-title a { color: #8B949E; text-decoration: none; }

    .cs-heading { color: #C9D1D9; font-size: 16px; margin: 24px 0 10px; }
    .cs-empty { color: #8B949E; }

    .cs-row {
      background-color: #161B22; border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 8px; padding: 14px 16px; margin-bottom: 10px;
    }
    .cs-row.cs-working, .cs-row.cs-builder-working { border-color: rgba(88, 214, 141, 0.45); }
    .cs-row.cs-waiting, .cs-row.cs-builder-waiting-on-you { border-color: rgba(245, 176, 65, 0.45); }
    .cs-row.cs-builder-finished { opacity: 0.55; }

    .cs-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap; }
    .cs-title { font-size: 15px; font-weight: bold; color: #C9D1D9; }
    .cs-title a { color: #5DADE2; text-decoration: none; }
    .cs-meta { font-size: 12px; color: #8B949E; }
    .cs-badge {
      margin-right: 6px; padding: 1px 8px; border-radius: 10px;
      background-color: rgba(255, 255, 255, 0.08); color: #C9D1D9; font-size: 11px;
    }
    .cs-branch { margin-top: 6px; font-size: 12px; color: #8B949E; }

    .cs-links { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin-top: 10px; }
    .cs-links:empty { display: none; }
    .cs-link, .cs-stop {
      font-size: 12px; padding: 4px 10px; border-radius: 6px; text-decoration: none;
      border: 1px solid rgba(255, 255, 255, 0.12); background-color: #21262D; color: #C9D1D9; cursor: pointer;
    }
    .cs-stop { color: #EC7063; border-color: rgba(236, 112, 99, 0.4); }
    .cs-stop-form { display: inline; margin: 0; }
  </style>
<% end %>
