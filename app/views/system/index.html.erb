<%= meta_title "System", include_name: false %>
<%= meta_description "System tools and dashboards." %>

<%
  # The blip counts what still needs deciding; the unread treatment is about
  # whether this page has been looked at since the last one landed. They're
  # different questions and they answer at different times — a request marked
  # `planned` stops needing a decision without becoming unseen again.
  open_requests   = FeatureRequest.status_open.count
  unseen_requests = FeatureRequest.where(seen_at: nil).count
  # Follow-ups owed today or already missed, on applications still in play.
  # Same idea as the requests blip: a number that means "go and do something",
  # not a count of how much is stored.
  due_follow_ups  = JobNote.follow_ups_for(current_user).due_now.count

  links = [
    {
      title: "Feature Requests",
      path:  system_feature_requests_path,
      desc:  "What the companions were asked for and couldn't do",
      icon:  :"paper-plane",
      blip:  open_requests,
      unread: unseen_requests.positive?,
    },
    { title: "GPT Spending", path: system_gpt_spending_path, desc: "Buddy GPT API cost per day or hour", icon: :dollar },
    { title: "Banking", path: system_banking_path, desc: "SimpleFIN accounts, balances, transactions", icon: :bank },
    { title: "Buddy Memories", path: system_memories_path, desc: "Everything the companions are holding, and their check-ins", svg: "buddy/byte/silhouette" },
    { title: "Custom Charts", path: custom_charts_path, desc: "Saved charts over logged events", icon: :"bar-chart" },
    {
      title: "Interview Tracker",
      path:  interviews_path,
      desc:  "Applications, their timelines, and what's owed a follow-up",
      icon:  :briefcase,
      blip:  due_follow_ups,
    },
    { title: "Tasks", path: jil_tasks_path, desc: "Jil automation task list", icon: :code },
    { title: "Cache", path: jil_user_cache_index_path, desc: "User cache key/value store", icon: :archive },
    { title: "All Executions", path: jil_executions_path, desc: "Recent run history with filters", icon: :history },
    { title: "Execution Dashboard", path: dashboard_jil_executions_path, desc: "Top tasks, time-series, rapid-fire detector", icon: :tachometer },
    { title: "Connections", path: system_connections_path, desc: "Live DB and WebSocket connections", icon: :plug },
    { title: "PgHero", path: "/pghero", desc: "Postgres performance, slow queries, indexes", icon: :database },
    { title: "Sidekiq", path: "/sidekiq", desc: "Background job queues, retries, scheduled", icon: :tasks },
  ]
%>

<div class="system-page">
  <div class="lists-title">
    <small>System</small>
  </div>

  <div class="system-grid">
    <% links.each do |link| %>
      <a class="system-card<%= " unread" if link[:unread] %>" href="<%= link[:path] %>">
        <div class="system-card-icon">
          <% if link[:svg] %>
            <%= svg(link[:svg], title: link[:title]) %>
          <% else %>
            <i class="fa fa-<%= link[:icon] %>"></i>
          <% end %>
        </div>
        <div class="system-card-body">
          <div class="system-card-title">
            <%= link[:title] %>
            <% if link[:blip].to_i.positive? %>
              <span class="system-card-blip"><%= link[:blip] %></span>
            <% end %>
          </div>
          <div class="system-card-desc"><%= link[:desc] %></div>
        </div>
      </a>
    <% end %>
  </div>
</div>

<%= content_for :head do %>
  <style>
    .system-page {
      max-width: 1200px;
      width: 95%;
      margin: 0 auto;
      padding: 20px;
    }

    .system-page .lists-title {
      font-size: 24px;
      margin-bottom: 24px;
      color: #E2E8F0;
    }

    .system-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 16px;
    }

    .system-card {
      display: flex;
      align-items: center;
      gap: 16px;
      background-color: #161B22;
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 8px;
      padding: 18px 20px;
      text-decoration: none;
      color: inherit;
      transition: border-color 0.15s ease, transform 0.15s ease;
    }

    .system-card:hover {
      border-color: #5DADE2;
      transform: translateY(-1px);
    }

    .system-card-icon {
      font-size: 28px;
      color: #5DADE2;
      width: 40px;
      text-align: center;
      flex-shrink: 0;
    }

    .system-card-icon svg {
      width: 1.1em;
      height: 1.1em;
      vertical-align: -0.12em;
      fill: currentColor;
    }

    .system-card-title {
      font-size: 16px;
      font-weight: bold;
      color: #C9D1D9;
    }

    .system-card-desc {
      font-size: 13px;
      color: #8B949E;
      margin-top: 2px;
    }

    .system-card.unread {
      border-color: #5DADE2;
      background-color: #18222C;
    }

    .system-card.unread .system-card-title {
      color: #FFF;
    }

    .system-card-blip {
      display: inline-block;
      min-width: 20px;
      padding: 1px 6px;
      margin-left: 8px;
      border-radius: 10px;
      background-color: #5DADE2;
      color: #0D1117;
      font-size: 12px;
      font-weight: bold;
      text-align: center;
      vertical-align: 1px;
    }
  </style>
<% end %>
