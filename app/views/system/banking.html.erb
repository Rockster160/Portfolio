<%= meta_title "System Banking", include_name: false %>
<%= meta_description "SimpleFIN accounts and transactions." %>
<%# Chart.js plus the `cc-` chart chrome the custom charts page already
    defines. The over-time chart here is the same reading as CustomChart 4, so
    it should be the same controls and the same surface, not a second set. %>
<%= render "custom_charts/chart_assets" %>

<%
  # number_to_currency handles both asks at once: thousands delimiters and a
  # fixed 2dp, so 9.7 renders "$9.70" rather than "$9.7".
  money = ->(decimal) {
    next "—" if decimal.nil?
    number_to_currency(decimal, unit: "$", delimiter: ",", precision: 2)
  }
  cents = ->(amount) { money.call(BigDecimal(amount.to_i) / 100) }
  sign_class = ->(value) { value.to_i.negative? ? "neg" : "pos" }
  # Only when it is not the default, so an ordinary link stays clean.
  chart_bucket = (@bucket unless @bucket == BankChart::DEFAULT_BUCKET)
%>

<div class="system-page" data-query-scope>
  <div class="btn-container">
    <a href="<%= system_path %>" class="btn">System Index</a>
    <a href="<%= request.path %>" class="btn btn-refresh">Refresh</a>
  </div>

  <div class="lists-title">
    <small>System:</small> Banking
  </div>

  <% if @accounts.none? %>
    <p class="bank-empty">
      No accounts yet.
    </p>
  <% else %>
    <% if @unclassified.any? %>
      <p class="bank-warn">
        <%= pluralize(@unclassified.size, "account") %> still unclassified, and left out of the
        dashboard figure until a kind is set.
      </p>
    <% end %>
    <%# Two very different reasons the figure can be blank, and saying the wrong
        one sends you looking in the wrong place. It read "no classified account
        outside a loan" while three were sitting right there — the actual cause
        was an account that had not reported a balance. %>
    <% if @dashboard_available.blank? %>
      <p class="bank-warn">
        <% if @dashboard_missing.any? %>
          <%= @dashboard_missing.map(&:display_name).to_sentence %>
          <%= @dashboard_missing.one? ? "has" : "have" %> reported no balance, so the dashboard
          figure has nothing to total. It fills in on the next successful sync.
        <% else %>
          No classified account outside a loan, so the dashboard figure has nothing to read.
        <% end %>
      </p>
    <% end %>

    <%# The figure carries forward everything since the bank's own snapshot, and
        it can only carry forward what it can attribute to an account. Named
        rather than quietly omitted — for eighteen months every paycheque landed
        here, because the deposit alert writes its account on a line of its own
        and the extractor was looking for one after a space. %>
    <% if @unattributed.any? %>
      <p class="bank-warn">
        <%= link_to(pluralize(@unattributed.size, "recent transaction"),
              system_banking_path(q: "account:none")) %>
        <%= @unattributed.one? ? "names" : "name" %> no account, so
        <%= @unattributed.one? ? "it is" : "they are" %> left out of the projected figure
        (<%= cents.call(@unattributed.sum(&:amount_cents)) %>).
      </p>
    <% end %>

    <table class="bank-table bank-accounts">
      <thead>
        <tr>
          <th>Account</th>
          <th>Kind</th>
          <%# The available figure carried forward over everything that has
              happened since the bank worked it out, which is what the dashboard
              publishes. A card reports "0.00" available — a placeholder, not
              headroom — so it starts from its balance instead; see
              BankAccount#spendable_cents. %>
          <th class="right"
              title="Available, plus anything the bank's figure is too old to include">
            Available
          </th>
          <th>Reported</th>
        </tr>
      </thead>
      <tbody>
        <% @accounts.each do |account| %>
          <%
            # Loaded once and totalled here rather than calling
            # `projected_cents`, which would ask the same question a second
            # time — the rows themselves are wanted for the count.
            unsettled = account.unsettled.to_a
            since_cents = unsettled.sum(&:amount_cents)
            projected = (account.spendable_cents + since_cents unless account.spendable_cents.nil?)
            drifted = projected.present? && since_cents != 0

            # Clicking the row adds this account to the listing below, keeping
            # whatever else has been typed into the search. Pick several and
            # they OR together; click one already picked to drop it.
            filter = @account_filters[account.id]
            filter_title = (
              if filter.blank?
                nil
              elsif filter[:active]
                "Showing this account — click to drop it"
              else
                "Click to add this account to the search"
              end
            )
          %>
          <tr data-row data-url="<%= system_bank_account_path(account) %>"
              data-filter-url="<%= system_banking_path(q: filter[:query].presence, bucket: chart_bucket) if filter %>"
              <% if filter %>
                data-query-chip data-query-manual data-query-on="picked"
                data-query-field="account" data-query-value="<%= filter[:value] %>"
              <% end %>
              class="<%= "picked" if filter&.dig(:active) %>"
              title="<%= filter_title %>">
            <td class="acct-name">
              <%# The chosen name is the editable line; the institution's own
                  name sits under it as the thing that never changes. %>
              <span class="edit-text" data-text data-field="friendly_name" contenteditable="true"
                    spellcheck="false"
                    title="Click to edit · Enter saves · Esc cancels"><%= account.friendly_name %></span>
              <span class="sub"><%= account.name %></span>
            </td>
            <td class="kind">
              <%= select_tag(:kind, options_for_select(BankAccount.kind_options, account.kind),
                    id: nil, class: "inline-select", data: { select: true, field: :kind }) %>
            </td>
            <%# Nothing reported is not zero. Two closed cards will never be
                reported by anyone, and "$0.00" reads as a real balance. %>
            <td class="right <%= sign_class.call(projected) if projected %><%= " projected" if drifted %>"
                title="<%= "#{cents.call(account.spendable_cents)} reported, #{pluralize(unsettled.size, "transaction")} since" if drifted %>">
              <%= projected.nil? ? "—" : cents.call(projected) %>
            </td>
            <td class="meta">
              <span class="age">
                <%= account.balance_date.present? ? "#{time_ago_in_words(account.balance_date)} ago" : "—" %>
              </span>
              <span class="sub">
                <%# What the estimate was built on, and only while it IS an
                    estimate — once the bank catches up the two are the same
                    number and printing it twice says nothing. The balance is
                    the fallback comparison for the same reason. %>
                <% if drifted %>
                  <%= cents.call(account.spendable_cents) %> reported
                <% elsif account.balance_cents.present? && account.balance_cents != account.spendable_cents %>
                  <%= cents.call(account.balance_cents) %> balance
                <% end %>
                <% if SimpleFin::DashboardCache.included?(account) %>
                  <em class="tag primary" title="Counted in the dashboard figure">dashboard</em>
                <% end %>
              </span>
            </td>
          </tr>
        <% end %>
      </tbody>
      <%# The dashboard reads a sum that appears on no single row, so show it
          here rather than leaving it derivable only by adding them up. %>
      <tfoot>
        <tr>
          <%# The headline column IS what the dashboard publishes now, so the
              label names it rather than a chip pointing at another cell. %>
          <%
            projected_total = @dashboard_projected
            total_drifted = (
              projected_total.present? && @dashboard_available.present? &&
                projected_total != @dashboard_available
            )
          %>
          <td colspan="2" class="total-label">
            Dashboard figure
            <span class="sub">Available, cumulative, excluding loans and unclassified</span>
          </td>
          <td class="right <%= sign_class.call(projected_total) if projected_total.present? %><%= " projected" if total_drifted %>">
            <%= projected_total.present? ? cents.call(projected_total) : "—" %>
          </td>
          <td class="meta">
            <span class="sub">
              <% if total_drifted %>
                <%= cents.call(@dashboard_available) %> reported
              <% elsif @dashboard_cents.present? && @dashboard_cents != @dashboard_available %>
                <%= cents.call(@dashboard_cents) %> balance
              <% end %>
            </span>
          </td>
        </tr>
      </tfoot>
    </table>

    <div class="lists-title bank-section">
      <small>Transactions</small>
      <%# Uncategorized, not unlinked. Whether an alert happened to arrive for a
          row stopped mattering once the category moved onto the row itself —
          what's actionable is how many still have none, and that is a link
          straight to them. %>
      <% if @uncategorized_count.positive? %>
        <%= link_to("#{@uncategorized_count} uncategorized", system_banking_path(q: "category:none"),
              class: "bank-warn-inline") %>
      <% end %>
    </div>

    <%# How far back the history walk has reached. Otherwise the only way to
        know is SimpleFin::Backfill.state in a console. %>
    <% unless @backfill.idle? %>
      <div class="bank-progress">
        <div class="bank-progress-row">
          <div class="bank-progress-label">History</div>
          <div class="bank-progress-track">
            <div class="bank-progress-fill<%= " done" if @backfill.done %>"
                 style="width: <%= @backfill.percent %>%;"></div>
          </div>
          <div class="bank-progress-value"><%= @backfill.percent %>%</div>
        </div>
        <div class="bank-progress-note">
          <% if @backfill.done %>
            Complete — nothing older to fetch.
          <% else %>
            <%# .utc.to_date, not .to_date — the cursor is UTC and the request
                renders in Mountain, where a bare to_date lands a day early. %>
            Back to <strong><%= @backfill.cursor.utc.to_date.strftime("%b %-d, %Y") %></strong>,
            up to <%= pluralize(@backfill.windows_remaining, "window") %> to go.
          <% end %>
        </div>
      </div>
    <% end %>

    <% if @stray_categories.any? %>
      <p class="bank-warn">
        Categories outside the vocabulary, uncolored on the chart:
        <%= @stray_categories.join(", ") %>
      </p>
    <% end %>

    <%# The id is what lets the bucket select down in the chart submit this
        form: a control anywhere in the document can belong to it by `form=`. %>
    <%= form_with(url: system_banking_path, method: :get, class: "basic bank-search",
          id: "bank-search-form") do %>
      <input type="search" name="q" value="<%= @query %>" data-query-input
             data-query-initial="<%= @query %>"
             placeholder="payee:amazon category:groceries amount&gt;50 direction:withdrawal">
      <%# In the search row rather than above it: the dates ARE part of the
          search. Picking one writes a `timestamp` term into the box beside it,
          so it is visible, editable by hand, and carried by every link and page
          of results like any other term. Typing one fills these back in.

          `basic` is not decoration — it opts out of the `input[type=date]` rule
          in forms.scss, which forces width:100% and an 18px font and put each
          picker on a line of its own. `cc-daterange` then supplies the compact
          look the charts page already uses. %>
      <span class="cc-daterange bank-dates">
        <input type="date" class="basic" data-date-from value="<%= @date_from %>"
               aria-label="From date">
        <span class="cc-daterange-sep">–</span>
        <input type="date" class="basic" data-date-to value="<%= @date_to %>"
               aria-label="To date">
      </span>
      <button type="submit" class="btn" data-query-submit>Search</button>
      <% if @query.present? %>
        <a class="btn" href="<%= system_banking_path %>">Clear</a>
      <% end %>
    <% end %>

    <%# A reference table, not an explanation. Values that have a fixed set are
        rendered FROM that set — the categories from TransactionCategory and the
        direction words from BankTransaction — so the docs cannot drift from
        what the search actually accepts. `mcc` is deliberately absent: it is a
        real search term but SimpleFIN never sends one, so every row is nil. %>
    <details class="bank-drawer bank-syntax">
      <summary>Search syntax</summary>

      <table class="bank-syntax-table">
        <tbody>
          <tr>
            <th>payee</th>
            <td><code>payee:amazon</code></td>
            <td></td>
          </tr>
          <tr>
            <th>memo</th>
            <td><code>memo:cable</code></td>
            <td></td>
          </tr>
          <tr>
            <th>description</th>
            <td><code>description:mktplace</code></td>
            <td></td>
          </tr>
          <tr>
            <th>category</th>
            <td><code>category:groceries</code></td>
            <td><%= (TransactionCategory::ALL.map(&:to_s) + ["none"]).join(" · ") %></td>
          </tr>
          <tr>
            <th>account</th>
            <td><code>account:prime</code> <code>account:7283</code> <code>account:none</code></td>
            <td>chosen name, bank name, or last four</td>
          </tr>
          <tr>
            <th>amount</th>
            <td><code>amount&gt;50</code> <code>amount::40</code></td>
            <td>dollars, always positive</td>
          </tr>
          <tr>
            <th>timestamp</th>
            <td><code>timestamp:2026-07</code></td>
            <td>when it happened — see below</td>
          </tr>
          <tr>
            <th>posted_at</th>
            <td><code>posted_at&gt;2026-07-01</code></td>
            <td>when it cleared</td>
          </tr>
          <tr>
            <th>transacted_at</th>
            <td><code>transacted_at:2026-07-01</code></td>
            <td>the bank's raw value</td>
          </tr>
          <tr>
            <th>direction</th>
            <td><code>direction:withdrawal</code></td>
            <td><%= (BankTransaction::WITHDRAWAL_WORDS + BankTransaction::DEPOSIT_WORDS).join(" · ") %></td>
          </tr>
          <tr>
            <th>pending</th>
            <td><code>pending:true</code></td>
            <td>true · false</td>
          </tr>
          <tr>
            <th>linked</th>
            <td><code>linked:false</code></td>
            <td>true · false — has a Chase alert behind it</td>
          </tr>
          <tr>
            <th>transfer</th>
            <td><code>transfer:true</code></td>
            <td>true · false — between your own accounts</td>
          </tr>
          <tr>
            <th>voided</th>
            <td><code>voided:true</code></td>
            <td>true · false — cancelled before it posted, and not counted</td>
          </tr>
          <tr>
            <th>id</th>
            <td><code>id:2652</code></td>
            <td></td>
          </tr>
          <tr>
            <th>simplefin_id</th>
            <td><code>simplefin_id:TRN-0dcb</code></td>
            <td></td>
          </tr>
        </tbody>
      </table>

      <div class="bank-syntax-notes">
        <div>
          <strong>Operators</strong>
          <code>field:contains</code> <code>field::exact</code>
          <code>amount&gt;50</code> <code>amount&lt;50</code> <code>amount&gt;=50</code>
          <code>-payee:amazon</code> <code>NOT payee:amazon</code>
          <code>AND</code> <code>OR</code>
        </div>
        <div>
          <strong>Dates</strong>
          <code>timestamp:2026-07-01</code> that day ·
          <code>timestamp:2026-07</code> that month ·
          <code>timestamp:2026</code> that year ·
          <code>timestamp:7-15</code> this year ·
          <code>timestamp&gt;=2026-07-01 timestamp&lt;=2026-07-31</code> a range
        </div>
        <div>
          <strong>Watch out</strong>
          <code>&gt;</code> and <code>&lt;</code> skip the whole unit named —
          <code>timestamp&gt;2026-07-01</code> starts on the 2nd,
          <code>timestamp&lt;2026-07-31</code> ends on the 30th. Use
          <code>&gt;=</code> and <code>&lt;=</code> to keep both ends. No times of day.
        </div>
      </div>
    </details>

    <% if @search_error.present? %>
      <p class="bank-error">Could not parse that search: <%= @search_error %></p>
    <% end %>

    <div class="bank-totals">
      <div><span class="bank-totals-label">Results</span><%= number_with_delimiter(@result_count) %></div>
      <div><span class="bank-totals-label">Spent</span>
        <span class="neg"><%= cents.call(@spend_cents) %></span></div>
      <div><span class="bank-totals-label">In</span>
        <span class="pos"><%= cents.call(@income_cents) %></span></div>
      <div><span class="bank-totals-label">Net</span>
        <span class="<%= sign_class.call(@spend_cents + @income_cents) %>">
          <%= cents.call(@spend_cents + @income_cents) %></span></div>
      <% if @transfer_count.positive? %>
        <div title="Money moved between your own accounts — excluded from the figures above so it isn't counted twice">
          <span class="bank-totals-label">Transfers</span>
          <span class="bank-muted"><%= @transfer_count %> excluded</span>
        </div>
      <% end %>
    </div>

    <%# The same reading as CustomChart 4 — a series per category, money out and
        money in in their own stacks side by side per bucket — over whatever the
        search matched rather than over a saved query. %>
    <details class="bank-drawer bank-over-time" open>
      <summary>
        Over time
        <span class="bank-drawer-note">by <%= @bucket %></span>
      </summary>

      <div class="cc-controls bank-chart-controls">
        <label class="cc-bucket">
          Bucket
          <%= select_tag(:bucket,
                options_for_select(BankChart::BUCKETS.map { |unit| [unit.to_s.titleize, unit] }, @bucket),
                id: nil, form: "bank-search-form", data: { bucket_select: true }) %>
        </label>
      </div>

      <div class="chart-wrapper bank-chart-wrapper">
        <canvas data-bank-canvas></canvas>
        <div class="cc-empty-overlay" data-bank-chart-empty></div>
      </div>

      <%# The legend IS the category picker. Clicking one ORs it into the search;
          clicking it again drops it. It lists everything the rest of the search
          allows rather than only what is on the chart — pick one category and a
          chart-derived legend would have nothing left to click. %>
      <div class="cc-legend bank-legend"
           data-any-picked="<%= @legend.any? { |entry| entry[:active] } %>">
        <% @legend.each do |entry| %>
          <a class="cc-legend-row bank-legend-row<%= " picked" if entry[:active] %>"
             data-query-chip data-query-field="category" data-query-value="<%= entry[:value] %>"
             data-query-on="picked"
             href="<%= system_banking_path(q: entry[:query].presence, bucket: chart_bucket) %>"
             title="<%= entry[:active] ? "Showing this — click to drop it" : "Click to add this to the search" %>">
            <span class="cc-swatch" style="background-color: <%= entry[:color] %>;"></span>
            <span class="cc-legend-label"><%= entry[:label] %></span>
            <span class="cc-legend-total"><%= cents.call(entry[:cents].abs) %></span>
          </a>
        <% end %>
      </div>
    </details>

    <script type="application/json" data-bank-chart-payload><%= raw JSON.generate(@chart_data) %></script>

    <% if @category_totals.any? %>
      <%
        chart_max = @category_totals.first.last.to_f
      %>
      <%# Closed on arrival. It answers a question worth asking occasionally,
          not one worth re-reading every visit, and open it pushed the
          transactions themselves off the first screen. %>
      <details class="bank-drawer bank-chart">
        <summary>
          Spending by category<%= " · matching search" if @query.present? %>
          <span class="bank-drawer-note"><%= pluralize(@category_totals.size, "category") %></span>
        </summary>
        <% @category_totals.each do |category, total| %>
          <%
            width = chart_max.positive? ? ((total / chart_max) * 100).round(1) : 0
            known = TransactionCategory.valid?(category)
          %>
          <div class="bank-bar-row" title="<%= TransactionCategory.label(category) %>: <%= cents.call(total) %>">
            <div class="bank-bar-label">
              <%= TransactionCategory.label(category) %><%= " (unknown)" unless known %>
            </div>
            <div class="bank-bar-track">
              <div class="bank-bar-fill"
                   style="width: <%= width %>%; background: <%= TransactionCategory.color(category) %>;"></div>
            </div>
            <div class="bank-bar-value"><%= cents.call(total) %></div>
          </div>
        <% end %>
      </details>
    <% end %>

    <% if @transactions.none? %>
      <p class="bank-empty">
        <%= @query.present? ? "Nothing matched that search." : "No transactions synced yet." %>
      </p>
    <% else %>
      <%# Recategorising in bulk is rare and deliberate. As a permanent row of
          controls above the table it read as a second search bar and cost the
          page a band of vertical space on every visit; it is now one quiet
          button that produces the form when it is actually wanted.

          The checkboxes stay in the table and reach the form through `form=`,
          which associates by id from anywhere in the document — so the form
          being inside a closed modal changes nothing about what submits. %>
      <div class="bank-list-tools">
        <div class="bank-page-info"><%= page_entries_info @transactions %></div>
        <button type="button" class="bank-bulk-open" data-modal="#bank-bulk">
          Set category<span data-bulk-count></span>
        </button>
      </div>

      <%= render_modal("bank-bulk", "Set category") do %>
        <%= form_with(url: system_bank_transactions_bulk_path, method: :patch,
              class: "basic bank-bulk") do %>
          <input type="hidden" name="q" value="<%= @query %>">
          <p class="bank-bulk-count">
            <strong data-bulk-selected>0</strong> selected on this page
          </p>
          <%= select_tag(:category, options_for_select(TransactionCategory.options),
                include_blank: "Choose…") %>
          <div class="bank-bulk-actions">
            <button type="submit" class="btn" data-bulk-apply>Apply to selected</button>
            <button type="submit" class="btn" name="apply_to_search" value="1"
                    data-confirm-count="<%= @result_count %>">
              Apply to all <%= number_with_delimiter(@result_count) %> matching
            </button>
          </div>
        <% end %>
      <% end %>

      <table class="bank-table">
        <thead>
          <tr>
            <th class="tick"><input type="checkbox" data-check-all></th>
            <th>When</th>
            <th>Payee</th>
            <th>Memo</th>
            <th>Category</th>
            <th class="right">Amount</th>
          </tr>
        </thead>
        <tbody>
          <% @transactions.each do |transaction| %>
            <tr data-row data-url="<%= system_bank_transaction_path(transaction) %>"
                class="<%= "voided" if transaction.voided? %>">
              <td class="tick">
                <input type="checkbox" name="transaction_ids[]"
                       value="<%= transaction.id %>" form="bank-bulk-form">
              </td>
              <%# Which feed the row came from, on hover. Two rows that read the
                  same on screen are exactly what you need to tell apart. %>
              <td class="when" title="<%= transaction.source_summary %>">
                <span class="date"><%= transaction.occurred_local&.strftime("%b %-d, %Y") %></span>
                <%# Only when the bank actually gave a clock time — see
                    occurred_time_known?. A third of rows are date-only. %>
                <% if transaction.occurred_time_known? %>
                  <span class="time"><%= transaction.occurred_local.strftime("%-I:%M %p") %></span>
                <% end %>
              </td>
              <td class="payee">
                <span class="name"><%= transaction.display_payee %></span>
                <span class="sub">
                  <% if transaction.transfer_destination.present? %>
                    <span class="acct route"
                          title="Moved between your own accounts — listed once, and not counted as spending or income">
                      <%= transaction.display_account %><span class="arrow">→</span><%= transaction.transfer_destination %>
                    </span>
                  <% else %>
                    <%# An alert-sourced row can name no account at all. It says so
                        rather than borrowing the likeliest one. %>
                    <% unattributed = transaction.bank_account.blank? %>
                    <%= tag.span(transaction.display_account,
                          class: ["acct", ("unattributed" if unattributed)],
                          title: ("The alert this came from named no account" if unattributed)) %>
                  <% end %>
                  <% if transaction.pending? %>
                    <em class="tag pending">pending</em>
                  <% end %>
                  <%# The arrow already says "transfer", and says where to. The chip is
                      for the hand-flagged ones, which have no counterpart to point at. %>
                  <% if transaction.transfer? && transaction.transfer_destination.blank? %>
                    <em class="tag xfer"
                        title="Between your own accounts — not counted as spending or income">transfer</em>
                  <% end %>
                  <%# Only where there is something to show. A button that opens
                      an empty drawer is worse than no button. %>
                  <% if transaction.metadata.present? %>
                    <button type="button" class="tag meta" data-meta-toggle
                            title="What is known about this purchase">metadata</button>
                  <% end %>
                  <%# An authorization that was cancelled before it posted. The
                      chip is always present rather than appearing on hover: it
                      is the only thing that says a row is or is not counted,
                      and a control you have to discover is one nobody uses.
                      Unstyled until set, so it recedes on the ninety-nine rows
                      it does not apply to. %>
                  <button type="button"
                          class="tag void<%= " on" if transaction.voided? %>"
                          data-void data-voided="<%= transaction.voided? %>"
                          title="<%= transaction.voided? ? "Cancelled — not counted. Click to count it again." : "Mark cancelled: keeps the row, stops counting it" %>">
                    <%= transaction.voided? ? "cancelled" : "void" %>
                  </button>
                </span>
              </td>
              <td class="memo">
                <span class="edit-text" data-text data-field="memo" contenteditable="true"
                      spellcheck="false"
                      title="Click to edit · Enter saves · Esc cancels"><%= transaction.display_memo %></span>
              </td>
              <%# Every row holds its own category now, including the ones no alert
                  ever covered — which is the whole point of the column. %>
              <td class="cat">
                <span class="bank-cat-dot<%= " empty" if transaction.category.blank? %>" data-dot
                      style="background: <%= TransactionCategory.color(transaction.category) %>;"></span>
                <%= select_tag(:category,
                      options_for_select(TransactionCategory.options, transaction.category),
                      include_blank: transaction.category.blank?,
                      id: nil, class: "inline-select",
                      data: { select: true, field: :category }) %>
              </td>
              <td class="right <%= sign_class.call(transaction.amount_cents) %>">
                <%= cents.call(transaction.amount_cents) %>
              </td>
            </tr>
            <%# Rendered with the row and hidden, rather than fetched on click.
                It is a few dozen bytes already loaded, and a drawer that cannot
                fail to open is worth more than one that saves them.

                Grouped by source key, and driven by whatever `metadata` holds —
                so a second source appears here without this template changing. %>
            <% if transaction.metadata.present? %>
              <tr class="bank-meta-row hidden" data-meta-row>
                <td colspan="6">
                  <% transaction.metadata.each do |source, values| %>
                    <div class="bank-meta">
                      <div class="bank-meta-source"><%= source.to_s.titleize %></div>
                      <dl>
                        <% Hash(values).each do |key, value| %>
                          <dt><%= key.to_s.tr("_", " ") %></dt>
                          <dd><%= Array.wrap(value).join(", ").presence || "—" %></dd>
                        <% end %>
                      </dl>
                    </div>
                  <% end %>
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>

      <div class="bank-pagination"><%= paginate @transactions %></div>
    <% end %>
  <% end %>
</div>

<%= content_for :after_body do %>
  <script>
    (function () {
      // The checkboxes live inside the table, not the bulk form, so they are
      // associated by `form=`. Give that form the id the inputs point at.
      var bulk = document.querySelector(".bank-bulk");
      if (bulk) { bulk.id = "bank-bulk-form"; }

      // The form is behind a modal now, so ticking a box has to say so out
      // here — otherwise a selection is invisible until you go looking for it.
      var boxes = document.querySelectorAll('input[name="transaction_ids[]"]');
      var badge = document.querySelector("[data-bulk-count]");
      var selectedLabel = document.querySelector("[data-bulk-selected]");
      var applySelected = document.querySelector("[data-bulk-apply]");

      function countSelected() {
        var picked = 0;
        boxes.forEach(function (box) { if (box.checked) { picked += 1; } });

        if (badge) { badge.textContent = picked ? " \u00B7 " + picked + " selected" : ""; }
        if (selectedLabel) { selectedLabel.textContent = picked; }
        // With nothing ticked this reports "Categorised 0", which reads as a
        // failure rather than as nothing having been chosen.
        if (applySelected) { applySelected.disabled = picked === 0; }
      }

      boxes.forEach(function (box) { box.addEventListener("change", countSelected); });

      var all = document.querySelector("[data-check-all]");
      if (all) {
        all.addEventListener("change", function () {
          boxes.forEach(function (box) { box.checked = all.checked; });
          countSelected();
        });
      }

      countSelected();

      // Clicking an account scopes the listing to it. Interactive cells are
      // skipped: the chosen name is editable and the kind is a dropdown, so a
      // click landing on either of those means edit, not filter.
      document.querySelectorAll(".bank-accounts tr[data-filter-url]").forEach(function (row) {
        var url = row.getAttribute("data-filter-url");
        if (!url) { return; }

        row.addEventListener("click", function (event) {
          if (event.target.closest("[contenteditable], select, input, button, a")) { return; }
          // Writes the term into the search box; Search is what re-runs it.
          if (window.queryChips && window.queryChips.apply(row)) { return; }
          window.location.href = url;
        });
      });

      // Inline edits save one field on one row and patch the row in place.
      // Reloading after every category pick would lose scroll position on a
      // hundred-row table.
      var token = document.querySelector('meta[name="csrf-token"]');

      function flash(row, ok) {
        row.classList.remove("saved", "failed");
        row.classList.add(ok ? "saved" : "failed");
        window.setTimeout(function () { row.classList.remove("saved", "failed"); }, 1200);
      }

      // The drawer sits in the row immediately after its own, already rendered.
      // stopPropagation because the button lives inside an editable row and a
      // click here means only "show me this".
      document.querySelectorAll("[data-meta-toggle]").forEach(function (button) {
        button.addEventListener("click", function (event) {
          event.stopPropagation();
          var drawer = button.closest("tr").nextElementSibling;
          if (!drawer || !drawer.hasAttribute("data-meta-row")) { return; }

          drawer.classList.toggle("hidden");
          button.classList.toggle("open");
        });
      });

      function save(row, body) {
        return window.fetch(row.getAttribute("data-url"), {
          method: "PATCH",
          headers: {
            "Content-Type": "application/json",
            "Accept": "application/json",
            "X-CSRF-Token": token ? token.getAttribute("content") : "",
          },
          credentials: "same-origin",
          body: JSON.stringify(body),
        }).then(function (res) {
          return res.json().then(function (data) {
            if (!res.ok) { throw new Error(data.error || "Save failed"); }
            return data;
          });
        });
      }

      // A cancelled charge keeps its row and stops counting. stopPropagation
      // for the same reason the metadata button needs it: the click lands
      // inside an editable row and means only "this one never happened".
      document.querySelectorAll("[data-void]").forEach(function (button) {
        var row = button.closest("[data-row]");
        if (!row) { return; }

        button.addEventListener("click", function (event) {
          event.stopPropagation();
          var wanted = button.getAttribute("data-voided") !== "true";

          save(row, { voided: wanted }).then(function (data) {
            // Driven by what came back, not by what was asked for.
            button.setAttribute("data-voided", data.voided ? "true" : "false");
            button.classList.toggle("on", !!data.voided);
            button.textContent = data.voided ? "cancelled" : "void";
            row.classList.toggle("voided", !!data.voided);
            flash(row, true);
          }).catch(function (err) {
            flash(row, false);
            window.alert(err.message);
          });
        });
      });

      // Both tables edit the same way, so the handlers are driven by
      // `data-field` rather than written once per field. An account rename and
      // a transaction memo are the same interaction; two copies of the Escape
      // and paste handling would only be two places to fix it.
      document.querySelectorAll("[data-row]").forEach(function (row) {
        var dot = row.querySelector("[data-dot]");

        row.querySelectorAll("[data-select]").forEach(function (select) {
          var field = select.getAttribute("data-field");
          var previous = select.value;

          select.addEventListener("change", function () {
            var body = {};
            body[field] = select.value;

            save(row, body).then(function (data) {
              if (dot && data.color) {
                dot.style.background = data.color;
                // Was an outlined hole; it now holds a real category.
                dot.classList.remove("empty");
              }
              previous = select.value;
              flash(row, true);
            }).catch(function (err) {
              select.value = previous; // never leave a value showing that didn't save
              flash(row, false);
              window.alert(err.message);
            });
          });
        });

        row.querySelectorAll("[data-text]").forEach(function (cell) {
          var field = cell.getAttribute("data-field");
          var saved = cell.textContent.trim();
          var canceled = false;

          cell.addEventListener("focus", function () {
            saved = cell.textContent.trim();
            canceled = false;
          });

          // Escape abandons the edit outright — the point is that brushing a
          // row and typing into it by accident costs nothing. The flag is
          // needed because blur() fires the save handler straight after.
          cell.addEventListener("keydown", function (event) {
            if (event.key === "Escape") {
              event.preventDefault();
              canceled = true;
              cell.textContent = saved;
              cell.blur();
            } else if (event.key === "Enter") {
              event.preventDefault();
              cell.blur();
            }
          });

          cell.addEventListener("blur", function () {
            if (canceled) { canceled = false; return; }

            var value = cell.textContent.trim();
            if (value === saved) { cell.textContent = value; return; }

            var body = {};
            body[field] = value;

            save(row, body).then(function (data) {
              // Answer with what was stored, which may differ from what was
              // typed — a cleared memo falls back to the linked note.
              cell.textContent = data[field] || "";
              saved = cell.textContent.trim();
              flash(row, true);
            }).catch(function (err) {
              cell.textContent = saved;
              flash(row, false);
              window.alert(err.message);
            });
          });

          // Paste as text — a copied cell would otherwise drag markup in.
          cell.addEventListener("paste", function (event) {
            event.preventDefault();
            var text = (event.clipboardData || window.clipboardData).getData("text");
            document.execCommand("insertText", false, text.replace(/\s+/g, " "));
          });
        });
      });

      // Applying to a whole search can touch far more than is on screen.
      var wide = document.querySelector("[data-confirm-count]");
      if (wide) {
        wide.addEventListener("click", function (event) {
          var count = wide.getAttribute("data-confirm-count");
          if (!window.confirm("Set the category on all " + count + " matching transactions?")) {
            event.preventDefault();
          }
        });
      }
    })();
  </script>
<% end %>

<%= content_for :head do %>
  <style>
    .system-page { max-width: 1200px; width: 95%; margin: 0 auto; padding: 20px; }
    .system-page .lists-title { font-size: 24px; margin-bottom: 16px; color: #E2E8F0; }
    .bank-section { margin-top: 36px; }

    .bank-empty, .bank-warn, .bank-error { margin: 12px 0; color: #94A3B8; }

    /* Both drawers on this page disclose the same way, and both arrive closed:
       each is something you go and get, not something to read past on every
       visit. One marker style, so opening either feels like the same control. */
    .bank-drawer > summary {
      cursor: pointer; color: #64748B; font-size: 13px;
      list-style: none; user-select: none; width: max-content;
    }
    .bank-drawer > summary::-webkit-details-marker { display: none; }
    .bank-drawer > summary::before { content: "▸ "; }
    .bank-drawer[open] > summary::before { content: "▾ "; }
    .bank-drawer > summary:hover { color: #CBD5E1; }
    /* How much is behind the summary, so it is worth deciding about unopened. */
    .bank-drawer-note { color: #475569; margin-left: 6px; }

    .bank-syntax { margin: 12px 0; font-size: 12px; color: #94A3B8; }
    .bank-syntax code {
      background: rgba(148, 163, 184, 0.1); border-radius: 3px;
      padding: 1px 4px; color: #CBD5E1; white-space: nowrap;
    }
    .bank-syntax-table { border-collapse: collapse; margin: 10px 0 0; }
    .bank-syntax-table th {
      text-align: left; font-weight: normal; color: #64748B;
      padding: 3px 16px 3px 0; vertical-align: top; white-space: nowrap;
    }
    .bank-syntax-table td { padding: 3px 16px 3px 0; vertical-align: top; }
    /* The values column wraps — 22 categories is a paragraph, not a cell. */
    .bank-syntax-table td:last-child { color: #64748B; }
    .bank-syntax-notes { margin-top: 12px; }
    .bank-syntax-notes > div { margin-bottom: 5px; }
    .bank-syntax-notes strong {
      display: inline-block; min-width: 76px; color: #64748B; font-weight: normal;
    }
    .bank-warn { color: #F5B041; }
    .bank-error { color: #EC7063; }
    .bank-warn-inline { font-size: 14px; color: #F5B041; margin-left: 8px; }
    .bank-muted { color: #64748B; }

    /* Four accounts do not need four cards. Same table shape as the
       transactions below, so the page reads as one list of rows rather than a
       stack of panels above a table. */
    .bank-accounts { margin-bottom: 8px; }
    .bank-accounts td.acct-name { min-width: 180px; }
    /* The row is the filter control. Only the cells that are not already an
       editable field say so, which is also where the click actually works. */
    .bank-accounts tr[data-filter-url] td.kind,
    .bank-accounts tr[data-filter-url] td.right,
    .bank-accounts tr[data-filter-url] td.meta { cursor: pointer; }
    .bank-accounts tr[data-filter-url]:hover { background: rgba(148, 163, 184, 0.05); }
    /* Which accounts the listing below is currently scoped to — several at a
       time. A left edge rather than a fill, so it marks the row without
       recoloring its numbers. */
    .bank-accounts tr.picked { background: rgba(93, 173, 226, 0.08); }
    .bank-accounts tr.picked td:first-child { box-shadow: inset 2px 0 0 #5DADE2; }
    .bank-accounts td.meta .age { display: block; white-space: nowrap; }
    .bank-accounts .tag.primary { color: #58D68D; background: rgba(88, 214, 141, 0.13); }
    .bank-accounts tfoot td { border-bottom: none; border-top: 1px solid #334155; color: #E2E8F0; }
    .bank-accounts tfoot .total-label { color: #94A3B8; }

    /* The line under an editable value: the institution's own account name,
       and whatever else is context rather than content. Scoped to these two
       cells — td.payee has its own .sub, laid out as a flex row of chips. */
    .bank-accounts td.acct-name .sub, .bank-accounts td.meta .sub,
    .bank-accounts .total-label .sub {
      display: block; font-size: 11px; color: #64748B; line-height: 1.3; margin-top: 2px;
    }

    /* Wraps rather than compressing: on a narrow screen the pickers drop to a
       second line instead of squeezing the query box to nothing. */
    .bank-search {
      display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-bottom: 6px;
    }
    /* The query box is the only thing that grows. 260px keeps it from being
       shorter than the pickers beside it once the row wraps. The margin goes
       because `margin: 4px auto` from forms.scss sets the row's height AND
       absorbs the free space the flex-grow is there to hand out. */
    .bank-search input[type="search"] { flex: 1 1 260px; min-width: 0; margin: 0; }
    /* Stretched rather than sized: the pickers take their height from the
       query box beside them, so nothing has to be kept matching by hand. */
    .bank-dates { flex: 0 0 auto; align-self: stretch; }
    .bank-dates input[type="date"] { align-self: stretch; }

    /* Shorter than the charts page's 360px: this one shares the screen with a
       table, and the table is what the page is for. */
    .bank-over-time { margin: 18px 0 24px; }
    .bank-chart-controls { margin: 10px 0 8px; }
    .bank-chart-wrapper { height: 260px; padding: 12px; }

    .bank-totals { display: flex; flex-wrap: wrap; gap: 24px; margin: 16px 0; }
    .bank-totals > div { font-size: 16px; font-variant-numeric: tabular-nums; color: #E2E8F0; }
    .bank-totals-label { display: block; font-size: 11px; text-transform: uppercase;
      letter-spacing: 0.06em; color: #64748B; }

    /* Same row shape as the category bars, but with a visible track: this one
       is a fraction of a whole, so the part not yet done has to be there to
       read the part that is. */
    .bank-progress { margin: 10px 0 16px; }
    .bank-progress-row { display: flex; align-items: center; gap: 10px; }
    .bank-progress-label {
      flex: 0 0 60px; font-size: 11px; text-transform: uppercase;
      letter-spacing: 0.06em; color: #64748B;
    }
    .bank-progress-track {
      flex: 1 1 auto; min-width: 0; height: 8px;
      background: #1E293B; border-radius: 4px; overflow: hidden;
    }
    .bank-progress-fill {
      height: 100%; background: #5DADE2; border-radius: 4px;
      min-width: 2px; transition: width 0.3s ease;
    }
    .bank-progress-fill.done { background: #58D68D; }
    .bank-progress-value {
      flex: 0 0 44px; text-align: right; font-size: 12px; color: #94A3B8;
      font-variant-numeric: tabular-nums;
    }
    .bank-progress-note { font-size: 11px; color: #64748B; margin: 4px 0 0 70px; }

    .bank-chart { margin: 20px 0 28px; }
    .bank-chart > summary { margin-bottom: 10px; }
    .bank-bar-row { display: flex; align-items: center; gap: 10px; margin-bottom: 4px; }
    .bank-bar-label { flex: 0 0 130px; font-size: 13px; color: #CBD5E1; text-align: right; }
    .bank-bar-track { flex: 1 1 auto; min-width: 0; }
    /* Rounded data-end, anchored flat to the baseline it grows from. */
    .bank-bar-fill { height: 12px; border-radius: 0 4px 4px 0; min-width: 2px; }
    .bank-bar-value { flex: 0 0 110px; font-size: 13px; color: #94A3B8;
      font-variant-numeric: tabular-nums; }

    /* The count and the way in, on one line above the table — the whole
       footprint bulk editing now has when it is not being used. */
    .bank-list-tools {
      display: flex; align-items: baseline; justify-content: space-between;
      gap: 12px; margin: 8px 0;
    }
    /* Deliberately not a .btn: a rare action should not carry the same weight
       as Search, which sits a few rows above it.

       forms.scss paints EVERY <button> as a blue pill with `color: white
       !important`, and `.dark-mode button` is (0,1,1) — which outranks a lone
       component class, so the reset has to be scoped under the page AND carry
       !important wherever the global rule does. Without that this rendered as
       a bold white-on-blue capsule. */
    /* The table and the chart are still answering the previous question until
       Search is pressed. Said on the button that resolves it. */
    .system-page.query-dirty .bank-search button[type="submit"] {
      box-shadow: 0 0 0 2px rgba(93, 173, 226, 0.65) !important;
    }
    .system-page .bank-search button[type="submit"]:disabled {
      background-color: rgba(127, 127, 127, 0.22) !important;
      color: #94A3B8 !important; opacity: 0.7; box-shadow: none !important;
    }

    .system-page .bank-bulk-open {
      margin: 0; border: 0; border-radius: 0; padding: 0;
      background: transparent; background-image: none;
      box-shadow: none !important; text-shadow: none !important;
      font-family: inherit; font-size: 12px; font-weight: normal;
      color: #64748B !important; cursor: pointer;
    }
    .system-page .bank-bulk-open:hover {
      background: transparent; color: #CBD5E1 !important;
    }

    /* Every category the rest of the search allows, picked or not, so the
       legend is somewhere to choose FROM rather than a readout of what is
       already chosen. Unpicked ones recede; nothing is hidden. */
    .bank-legend { gap: 6px 16px; }
    .bank-legend-row {
      text-decoration: none; padding: 2px 6px; border-radius: 4px;
      border: 1px solid transparent; opacity: 0.55; transition: opacity 0.15s;
    }
    .bank-legend-row:hover { opacity: 1; background: rgba(148, 163, 184, 0.08); }
    .bank-legend-row.picked {
      opacity: 1; border-color: rgba(93, 173, 226, 0.4); background: rgba(93, 173, 226, 0.1);
    }
    /* Nothing picked is not "nothing selected" — it is everything. Dimming the
       whole legend then would say the opposite of what is on the chart. Driven
       by an attribute rather than `:not(:has(...))`, which is newer than it
       needs to be for a fact the server already knows. */
    .bank-legend[data-any-picked="false"] .bank-legend-row { opacity: 1; }

    .bank-bulk-count { margin: 0 0 10px; font-size: 13px; color: #94A3B8; }
    .bank-bulk-count strong { color: #E2E8F0; }
    .bank-bulk-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
    /* Nothing ticked is a normal state to open this in, so the disabled button
       has to read as "not yet", not as broken. */
    .bank-bulk-actions .btn[disabled] { opacity: 0.4; cursor: not-allowed; }

    .bank-page-info { font-size: 12px; color: #64748B; margin: 0; }
    .bank-pagination { margin-top: 12px; }

    .bank-table { width: 100%; border-collapse: collapse; font-size: 14px; }
    .bank-table th, .bank-table td {
      text-align: left; padding: 8px 10px; border-bottom: 1px solid #1E293B;
    }
    .bank-table th { color: #94A3B8; font-weight: normal; }
    .bank-table td { color: #CBD5E1; vertical-align: top; }

    /* Date on top, time tucked under it small and tight — two lines in less
       vertical space than the one line was taking. */
    /* `help` so the tooltip is discoverable — nothing else on the page hints
       that the cell carries the row's id and which feed it came from. */
    .bank-table td.when { white-space: nowrap; line-height: 1.15; cursor: help; }
    .bank-table td.when .date { display: block; }
    .bank-table td.when .time { display: block; font-size: 11px; color: #64748B; }
    .bank-table .right { text-align: right; font-variant-numeric: tabular-nums; }
    .bank-table .tick { width: 28px; }

    /* Payee stacks the same way the date does: name on top, context under it.
       That reclaims the whole Account column for the columns that need width. */
    .bank-table td.payee { line-height: 1.15; }
    .bank-table td.payee .name { display: block; }
    .bank-table td.payee .sub {
      display: flex; align-items: center; gap: 6px; margin-top: 2px;
    }
    /* The account is plain muted text; states are chips. Distinguished by
       SHAPE, not just color — two grays side by side would read as one thing,
       and "Sapphire" is not a state. */
    .bank-table td.payee .acct { font-size: 11px; color: #64748B; }
    /* A transfer names both ends. The arrow is the direction AND the fact that
       it is a transfer, so the row needs no chip repeating it. */
    .bank-table td.payee .acct.route { white-space: nowrap; }
    .bank-table td.payee .acct .arrow { color: #475569; padding: 0 4px; }
    /* Dimmer than a named account, so "we don't know" doesn't read as a name. */
    .bank-table td.payee .acct.unattributed { color: #475569; }
    .bank-table .tag {
      font-style: normal;
      font-size: 9px;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      padding: 1px 5px;
      border-radius: 3px;
      white-space: nowrap;
    }
    .bank-table td.payee .tag.pending { color: #F5B041; background: rgba(245, 176, 65, 0.13); }
    .bank-table td.payee .tag.xfer { color: #94A3B8; background: rgba(148, 163, 184, 0.13); }
    /* Quiet until wanted: it sits on most Amazon rows, so it must not read as
       a status the way `pending` does. */
    /* Also a <button>, so it needs the same escape from the global pill —
       otherwise it sits bold and shadowed beside the plain <em> chips it is
       supposed to match. */
    .bank-table td.payee .tag.meta {
      margin: 0; border: 0; cursor: pointer; font-family: inherit;
      font-weight: normal; letter-spacing: 0.06em;
      background: rgba(100, 116, 139, 0.13);
      box-shadow: none !important; text-shadow: none !important;
      color: #64748B !important;
    }
    .bank-table td.payee .tag.meta:hover { color: #CBD5E1 !important; }
    .bank-table td.payee .tag.meta.open {
      color: #5DADE2 !important; background: rgba(93, 173, 226, 0.15);
    }

    /* Same escape from the global button pill as `.meta`, and quieter still
       while off: it is on every row, and ninety-nine of a hundred are not
       cancelled. Nearly invisible until the row is hovered or it is set. */
    .bank-table td.payee .tag.void {
      margin: 0; border: 0; cursor: pointer; font-family: inherit;
      font-weight: normal; letter-spacing: 0.06em;
      background: transparent; background-image: none;
      box-shadow: none !important; text-shadow: none !important;
      color: #334155 !important; opacity: 0; transition: opacity 0.12s;
    }
    .bank-table tr:hover td.payee .tag.void { opacity: 1; }
    .bank-table td.payee .tag.void:hover { color: #E74C3C !important; }
    /* Once set it is a state, not a control, so it reads like the other chips
       and stays visible whether or not the row is hovered. */
    .bank-table td.payee .tag.void.on {
      opacity: 1; color: #E74C3C !important; background: rgba(231, 76, 60, 0.13);
    }

    /* Struck through and dimmed: still there, plainly not counted. The amount
       is what the strike is FOR, so it is the part that must carry it. */
    .bank-table tr.voided td { opacity: 0.55; }
    .bank-table tr.voided td.payee .name,
    .bank-table tr.voided td.right { text-decoration: line-through; }
    .bank-table tr.voided td.payee .tag.void { opacity: 1; }

    /* An estimate, marked as one. Not a different color — it is the same
       number in the same column, and recoloring it would read as good or bad
       news rather than as provisional. */
    .bank-table td.right.projected { font-style: italic; }

    /* Scoped rather than relying on a global `.hidden`, which is defined in a
       stylesheet this page does not necessarily load. */
    .bank-meta-row.hidden { display: none; }
    .bank-meta-row td { padding: 10px 12px 12px; background: rgba(148, 163, 184, 0.05); }
    .bank-meta { margin-bottom: 8px; }
    .bank-meta:last-child { margin-bottom: 0; }
    .bank-meta-source {
      font-size: 10px; text-transform: uppercase; letter-spacing: 0.08em;
      color: #64748B; margin-bottom: 4px;
    }
    /* Two columns so the keys line up and the values can be scanned down. */
    .bank-meta dl {
      display: grid; grid-template-columns: max-content 1fr;
      gap: 2px 14px; margin: 0; font-size: 12px;
    }
    .bank-meta dt { color: #64748B; }
    .bank-meta dd { margin: 0; color: #CBD5E1; word-break: break-word; }

    .bank-cat-dot {
      width: 8px; height: 8px; border-radius: 2px;
      display: inline-block; vertical-align: middle; margin-right: 6px;
    }
    /* An outline rather than a filled gray chip: no category yet is a hole,
       and a solid swatch would read as a category whose color happens to be
       gray — which is what an out-of-vocabulary one actually looks like. */
    .bank-cat-dot.empty { background: none !important; box-shadow: inset 0 0 0 1px #334155; }

    /* The global `input[type=text]:not(.basic,.invisi-field)` rule forces
       18px / 2px border / 8px padding / width:100%, which is why the memo
       fields rendered as huge boxes. Editing is a contenteditable span
       instead: it reads as plain text until clicked into, and no global form
       styling can reach it. */
    .bank-table td.memo { max-width: 260px; }
    .bank-table .edit-text {
      display: block; min-height: 1.2em; outline: none; cursor: text;
      border-bottom: 1px solid transparent;
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .bank-table .edit-text:hover { border-bottom-color: #334155; }
    .bank-table .edit-text:focus {
      border-bottom-color: #58D68D; color: #E2E8F0; white-space: normal;
    }
    /* Only a genuinely empty value shows a placeholder. An inherited note is a
       real value and reads as one — styling it faintly was what made every
       row look unset. */
    .bank-table .edit-text:empty::before { content: "\2014"; color: #475569; }
    .bank-table tr.saved .edit-text { border-bottom-color: #58D68D; }
    .bank-table tr.failed .edit-text { border-bottom-color: #EC7063; }

    /* Dot inline with the label. `nowrap` on the cell is what stops the select
       wrapping onto its own line under the dot. */
    .bank-table td.cat, .bank-table td.kind { white-space: nowrap; }
    /* Beats the bare `select` in forms.scss, which paints a white box with a
       2px border and forces width:100%. */
    .bank-table select.inline-select {
      background: transparent; border: 1px solid transparent; color: #CBD5E1;
      margin: 0; padding: 1px 2px; height: auto; width: auto; max-width: 140px;
      font-size: 14px; line-height: normal; vertical-align: middle;
    }
    .bank-table select.inline-select:hover { border-color: #334155; }
    .bank-table tr.saved select.inline-select { border-color: #58D68D; }
    .bank-table tr.failed select.inline-select { border-color: #EC7063; }

    /* `.bank-table td` is (0,1,1) and beats a bare `.neg` (0,1,0), which is why
       every amount rendered white. Matching the element makes these win. */
    .pos, .bank-table td.pos { color: #58D68D; }
    .neg, .bank-table td.neg { color: #EC7063; }

    @media (max-width: 720px) {
      /* Memo, not column 5 — that used to be Account and is now Category,
         which carries the dropdown and must not disappear. Memo is the widest
         and the least useful for scanning. */
      .bank-table th:nth-child(4), .bank-table td:nth-child(4) { display: none; }
      .bank-bar-label { flex-basis: 90px; }
      .bank-bar-value { flex-basis: 90px; }
    }
  </style>
<% end %>
