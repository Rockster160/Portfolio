<%= meta_title "Feature Requests", include_name: false %>
<%= meta_description "What the companions were asked for and couldn't do." %>

<div class="system-page">
  <div class="lists-title">
    <small><%= link_to "System", system_path %> / Feature Requests</small>
  </div>

  <div class="fr-counts">
    <% FeatureRequest.statuses.each_key do |status| %>
      <span class="fr-count fr-<%= status %>"><%= @counts[status].to_i %> <%= status %></span>
    <% end %>
  </div>

  <% if @requests.none? %>
    <p class="fr-empty">Nothing on the list. The companions haven't hit a wall they couldn't describe.</p>
  <% end %>

  <% @requests.each do |request| %>
    <div class="fr-row fr-status-<%= request.status %>" id="fr-<%= request.id %>" data-fr-row data-fr-id="<%= request.id %>">
      <div class="fr-head">
        <div class="fr-title"><%= request.id %> <%= request.title %></div>
        <div class="fr-meta">
          <%= request.user&.first_name %>
          ·
          <%= request.created_at.in_time_zone(current_user.timezone).strftime("%b %-d, %-I:%M %p") %>
          <span class="fr-badge" data-fr-badge><%= request.status %></span>
        </div>
      </div>

      <div class="fr-body"><%= simple_format(request.body) %></div>

      <%# Every status is a button, including the one it's already on, so the %>
      <%# row can be moved back as readily as forward - a decision made from %>
      <%# this page is as reversible as one made anywhere else. %>
      <div class="fr-actions">
        <% FeatureRequest.statuses.each_key do |status| %>
          <button
            type="button"
            class="fr-btn fr-btn-<%= status %><%= " current" if request.status == status %>"
            data-fr-set="<%= status %>"
          ><%= status %></button>
        <% end %>
        <% if request.buildable? %>
          <button type="button" class="fr-btn fr-btn-build" data-fr-build-open>Build</button>
        <% end %>
      </div>

      <% build = request.latest_build %>
      <% if build && !request.buildable? %>
        <div class="fr-build">
          <span class="fr-build-label">Feature Builder</span>
          <span class="fr-badge"><%= FeatureBuilder.stage(build, @live[build.id]) %></span>
          <% if build.rc_url.present? && !build.status_finished? %>
            <%= link_to "Open in Claude", build.rc_url, class: "fr-link", target: :_blank, rel: :noopener %>
          <% end %>
          <% if build.pr_url.present? %>
            <%= link_to "PR ##{build.pr_number}", build.pr_url, class: "fr-link", target: :_blank, rel: :noopener %>
          <% end %>
        </div>
      <% end %>

      <% if request.buildable? %>
        <dialog class="fr-modal" data-fr-build-modal aria-labelledby="fr-modal-title-<%= request.id %>">
          <%= form_with url: system_feature_request_build_path(request), method: :post, local: true,
                class: "fr-modal-form basic" do |form| %>
            <div class="fr-modal-head">
              <div>
                <div class="fr-modal-kicker">Start a Feature Builder</div>
                <h2 class="fr-modal-title" id="fr-modal-title-<%= request.id %>"><%= request.title %></h2>
              </div>
              <button type="button" class="fr-modal-close" data-fr-build-close aria-label="Close">×</button>
            </div>

            <div class="fr-modal-request"><%= simple_format(request.body) %></div>

            <label class="fr-modal-label" for="fr-notes-<%= request.id %>">
              Notes for the builder <span>optional</span>
            </label>
            <%= render layout: "shared/image_field" do %>
              <%= form.text_area :notes, rows: 4, id: "fr-notes-#{request.id}",
                    placeholder: "Anything it should know. Paste or drop screenshots here too." %>
            <% end %>

            <div class="fr-modal-foot">
              <button type="button" class="fr-btn fr-btn-ghost" data-fr-build-close>Cancel</button>
              <%= form.submit "Start build", class: "fr-btn fr-btn-start", data: { disable_with: "Starting…" } %>
            </div>
          <% end %>
        </dialog>
      <% end %>
    </div>
  <% end %>
</div>

<%= content_for :head do %>
  <style>
    .system-page { max-width: 1000px; width: 95%; margin: 0 auto; padding: 20px; }
    .system-page .lists-title { font-size: 24px; margin-bottom: 16px; color: #E2E8F0; }
    .system-page .lists-title a { color: #8B949E; text-decoration: none; }

    .fr-counts { display: flex; gap: 10px; margin-bottom: 20px; flex-wrap: wrap; }
    .fr-count {
      font-size: 12px; color: #8B949E; background-color: #161B22;
      border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; padding: 3px 10px;
    }

    .fr-empty { color: #8B949E; }

    .fr-row {
      background-color: #161B22; border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 8px; padding: 16px 18px; margin-bottom: 12px;
      transition: opacity 0.15s ease, border-color 0.15s ease;
    }
    .fr-row.fr-status-shipped, .fr-row.fr-status-declined { opacity: 0.55; }
    .fr-row.fr-status-open { border-color: rgba(93, 173, 226, 0.4); }

    .fr-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap; }
    .fr-title { font-size: 16px; font-weight: bold; color: #C9D1D9; }
    .fr-meta { font-size: 12px; color: #8B949E; }

    .fr-badge {
      margin-left: 6px; padding: 1px 8px; border-radius: 10px;
      background-color: rgba(255, 255, 255, 0.08); color: #C9D1D9; font-size: 11px;
    }

    .fr-body { font-size: 14px; color: #8B949E; margin: 10px 0 14px; white-space: pre-wrap; }
    .fr-body p { margin: 0 0 8px; }

    .fr-actions { display: flex; gap: 8px; flex-wrap: wrap; }

    .fr-btn {
      padding: 5px 12px; border-radius: 6px; font-size: 12px; cursor: pointer;
      background-color: #21262D; border: 1px solid rgba(255, 255, 255, 0.12); color: #C9D1D9;
    }
    .fr-btn:hover { border-color: #5DADE2; }
    .fr-btn.current { background-color: #5DADE2; border-color: #5DADE2; color: #0D1117; font-weight: bold; }
    .fr-btn:disabled { opacity: 0.5; cursor: wait; }
    .fr-btn-build { margin-left: auto; border-color: rgba(88, 214, 141, 0.5); color: #58D68D; }
    .fr-btn-start { background-color: #58D68D; border-color: #58D68D; color: #0D1117; font-weight: bold; }

    .fr-build {
      display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin-top: 12px;
      font-size: 12px; color: #8B949E;
    }
    .fr-build .fr-badge { margin-left: 0; }
    .fr-link {
      font-size: 12px; padding: 4px 10px; border-radius: 6px; text-decoration: none;
      border: 1px solid rgba(255, 255, 255, 0.12); background-color: #21262D; color: #C9D1D9;
    }

    .fr-modal {
      width: min(560px, calc(100vw - 32px)); max-height: calc(100dvh - 48px);
      padding: 0; border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 14px;
      background-color: #161B22; color: #C9D1D9;
      box-shadow: 0 24px 64px rgba(0, 0, 0, 0.55);
    }
    .fr-modal[open] { animation: fr-modal-in 0.16s ease-out; }
    .fr-modal::backdrop { background-color: rgba(1, 4, 9, 0.66); backdrop-filter: blur(2px); }
    @keyframes fr-modal-in {
      from { opacity: 0; transform: translateY(8px) scale(0.98); }
      to   { opacity: 1; transform: none; }
    }

    .fr-modal-form { display: flex; flex-direction: column; gap: 14px; padding: 20px; }
    .fr-modal-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; }
    .fr-modal-kicker {
      font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; color: #58D68D; margin-bottom: 4px;
    }
    .fr-modal-title { margin: 0; font-size: 18px; line-height: 1.3; color: #E6EDF3; }
    .fr-modal .fr-modal-close {
      flex: 0 0 auto; width: 30px; height: 30px; margin: 0; padding: 0; border: 0; border-radius: 8px;
      box-shadow: none; background: transparent; color: #8B949E !important;
      font-size: 22px; font-weight: normal; line-height: 1; cursor: pointer;
    }
    .fr-modal .fr-modal-close:hover { background: rgba(255, 255, 255, 0.06); color: #E6EDF3 !important; }

    .fr-modal-request {
      font-size: 13px; line-height: 1.5; color: #8B949E; background-color: #0D1117;
      border: 1px solid rgba(255, 255, 255, 0.06); border-radius: 8px;
      padding: 10px 12px; max-height: 30vh; overflow-y: auto; white-space: pre-wrap;
    }
    .fr-modal-request p { margin: 0 0 6px; }
    .fr-modal-request p:last-child { margin-bottom: 0; }

    .fr-modal-label { font-size: 13px; font-weight: bold; color: #C9D1D9; margin-bottom: -6px; }
    .fr-modal-label span { font-weight: normal; color: #8B949E; margin-left: 4px; }
    .fr-modal .image-field textarea { color: #C9D1D9; }

    .fr-modal-foot { display: flex; justify-content: flex-end; gap: 8px; margin-top: 4px; }
    /* Two classes deep, to beat the app-wide button and submit look. */
    .fr-modal .fr-btn {
      margin: 0; padding: 9px 18px; font-family: inherit; font-size: 13px; border-radius: 8px;
      box-shadow: none; text-shadow: none;
    }
    .fr-modal .fr-btn-ghost {
      background: transparent; border: 1px solid rgba(255, 255, 255, 0.12); color: #C9D1D9 !important;
      font-weight: normal;
    }
    .fr-modal .fr-btn-ghost:hover { background: rgba(255, 255, 255, 0.05); }
    .fr-modal .fr-btn-start {
      background: #58D68D; border: 1px solid #58D68D; color: #0D1117 !important; font-weight: bold;
    }
    .fr-modal .fr-btn-start:hover { background: #6EE3A0; border-color: #6EE3A0; }

    @media (max-width: 520px) {
      .fr-modal-form { padding: 16px; }
      .fr-modal-foot .fr-btn { flex: 1; }
    }
  </style>
<% end %>

<%= content_for :after_body do %>
  <script>
    (function () {
      const token = document.querySelector('meta[name="csrf-token"]');

      document.querySelectorAll("[data-fr-row]").forEach(function (row) {
        const modal = row.querySelector("[data-fr-build-modal]");
        if (modal) {
          row.querySelector("[data-fr-build-open]")?.addEventListener("click", function () {
            modal.showModal();
            modal.querySelector("textarea")?.focus();
          });
          modal.querySelectorAll("[data-fr-build-close]").forEach(function (btn) {
            btn.addEventListener("click", function () { modal.close(); });
          });
          // A click on the backdrop lands on the dialog itself, outside the form.
          // Only one that also STARTED there closes it, so selecting text in
          // the notes and letting go past the edge doesn't throw them away.
          let pressedOutside = false;
          modal.addEventListener("pointerdown", function (e) { pressedOutside = e.target === modal; });
          modal.addEventListener("click", function (e) {
            if (pressedOutside && e.target === modal) modal.close();
          });
        }

        row.querySelectorAll("[data-fr-set]").forEach(function (btn) {
          btn.addEventListener("click", async function () {
            const status = btn.dataset.frSet;
            const buttons = row.querySelectorAll("[data-fr-set]");
            buttons.forEach(function (b) { b.disabled = true; });

            try {
              const res = await fetch("/system/feature_requests/" + row.dataset.frId, {
                method: "PATCH",
                credentials: "same-origin",
                headers: {
                  "Content-Type": "application/json",
                  "Accept": "application/json",
                  "X-CSRF-Token": token ? token.getAttribute("content") : "",
                },
                body: JSON.stringify({ status: status }),
              });
              if (!res.ok) throw new Error("HTTP " + res.status);
              const data = await res.json();

              // Repaint the row in place rather than reloading — the page is a
              // working list and a reload throws away where you were in it.
              row.className = "fr-row fr-status-" + data.status;
              row.querySelector("[data-fr-badge]").textContent = data.status;
              buttons.forEach(function (b) {
                b.classList.toggle("current", b.dataset.frSet === data.status);
              });
            } catch (e) {
              console.warn("[system] feature request update failed", e);
            } finally {
              buttons.forEach(function (b) { b.disabled = false; });
            }
          });
        });
      });
    })();
  </script>
<% end %>
