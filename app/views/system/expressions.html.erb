<%= meta_title "Expression Lab", include_name: false %>
<%= meta_description "Every companion's expressions and the mood values that pick them." %>

<%
  # Everything on this page is read straight off the companion classes, so a pet
  # or an emotion added there shows up here with no edit:
  #   Buddy::Companion.all  — the companions (name, summary, chrome)
  #   pet.faces / pet.summaries — each emotion's mood values and its sentence
  #   Buddy::Faces          — the resting/system/transitional groupings
  axes = Buddy::Faces::AXES                       # warmth play weight strain

  # The faces the pet does NOT choose: its resting default, the "thinking"
  # overlay shown mid-reply, and the "sleeping" outage/cap face. Pulled from the
  # same constants that drive them, and shown first because they are the ones
  # that are always on and never a mood.
  # The faces that are always on and never a mood: the resting default, the
  # "thinking" overlay, the "sleeping" outage/cap face, and the wave gesture.
  # Every one is a slot shown for every pet — one the pet has no pose of its own
  # for draws blank, so the gaps in a set are visible rather than hidden.
  system_order = ([Buddy::Faces.default] + Buddy::Faces::TRANSITIONAL + Buddy::Faces::SYSTEM + Buddy::Faces::GESTURES).uniq
  system_role  = {
    Buddy::Faces.default             => ["rests here", "The resting default — where the pet sits when nothing has moved it."],
    Buddy::Faces::TRANSITIONAL.first => ["transitional", "Shown while a reply is being written, never as a mood."],
    Buddy::Faces::SYSTEM.first       => ["system", "Shown when the connection drops or the usage cap is hit."],
    Buddy::Faces::GESTURES.first     => ["gesture", "A hello/goodbye wave — played on a bare greeting and at the top of the briefing, never as a mood."],
  }
  axis_hint = {
    warmth: "how good the moment is",
    play:   "how light it is",
    weight: "how much is at stake",
    strain: "how much friction is in the room",
    reach:  "how far from its centre this face still answers — tighter is louder",
  }

  pets = Buddy::Companion.all.values.select { |pet| pet.faces.present? }

  # What the vibe sliders need to run the picker in the page: every pet's mood
  # table and face images, and the picker's own tuning, so the odds shown are
  # Buddy::Faces.pool + .pick's weights rather than a second guess at them.
  vibe = {
    axes:     axes,
    weights:  Buddy::Faces::AXIS_WEIGHTS,
    reach:    Buddy::Faces::AXIS_REACH,
    softness: Buddy::Faces::SOFTNESS,
    pets:     pets.to_h { |pet|
      [pet.theme, pet.faces.to_h { |name, vals| [name, vals.merge(url: buddy_face_url(pet.theme, name))] }]
    },
  }
%>

<div class="exlab" data-exlab>
  <div class="lists-title">
    <small>Expression Lab</small>
  </div>
  <p class="exlab-intro">
    Every companion's expressions, and the four mood axes plus reach that decide
    when each one is worn. Each pet sets its own emotions in its
    <code>Buddy::Companion</code> class — add an emotion or a pet and it appears
    here.
  </p>

  <ul class="exlab-legend">
    <% axes.each do |axis| %>
      <li><span class="exlab-dot exlab-dot-<%= axis %>"></span><b><%= axis %></b> — <%= axis_hint[axis] %></li>
    <% end %>
    <li><span class="exlab-dot exlab-dot-reach"></span><b>reach</b> — <%= axis_hint[:reach] %></li>
  </ul>

  <div class="exlab-chips" role="tablist">
    <% pets.each_with_index do |pet, i| %>
      <button type="button" class="exlab-chip<%= " is-active" if i.zero? %>" data-exlab-chip="<%= pet.theme %>" role="tab" aria-selected="<%= i.zero? %>">
        <img src="<%= image_path(pet.chrome[:avatar]) %>" alt="" aria-hidden="true">
        <%= pet.display_name %>
      </button>
    <% end %>
  </div>

  <section class="exlab-vibe" data-exlab-vibe data-exlab-vibe-data="<%= vibe.to_json %>">
    <div class="exlab-group-label">Try a vibe</div>
    <div class="exlab-vibe-body">
      <div class="exlab-vibe-sliders">
        <% axes.each do |axis| %>
          <label class="exlab-vibe-slider">
            <span><span class="exlab-dot exlab-dot-<%= axis %>"></span><%= axis %></span>
            <input type="range" min="0" max="1" step="0.01" value="0.5" data-exlab-axis="<%= axis %>">
            <em data-exlab-axis-value="<%= axis %>">0.50</em>
          </label>
        <% end %>
      </div>
      <ol class="exlab-vibe-odds" data-exlab-odds></ol>
    </div>
  </section>

  <div class="exlab-stage">
    <% pets.each_with_index do |pet, i| %>
      <%
        theme     = pet.theme
        faces     = pet.faces
        # Every system slot is shown for every pet (a missing one draws blank),
        # then every mood it chooses and every other pose it has art for (a held
        # state like hiding), minus any already shown above.
        moods     = (faces.keys.map(&:to_sym) | Buddy::Faces.all(theme)).sort_by(&:to_s) - system_order
      %>
      <section class="exlab-pet" data-exlab-pet="<%= theme %>"<%= " hidden".html_safe unless i.zero? %>>
        <header class="exlab-pet-head">
          <img class="exlab-avatar" src="<%= image_path(pet.chrome[:avatar]) %>" alt="<%= pet.display_name %>">
          <div>
            <h2><%= pet.display_name %></h2>
            <% if pet.summary.present? %><p class="exlab-summary"><%= pet.summary %></p><% end %>
            <span class="exlab-meta">
              tone <%= pet.tone %> · <%= faces.size %> <%= "expression".pluralize(faces.size) %>
            </span>
          </div>
        </header>

        <div class="exlab-group-label">System</div>
        <div class="exlab-grid">
          <% system_order.each do |name| %>
            <%
              vals     = faces[name]
              tag, say = system_role[name]
              has_art  = Buddy::Faces.valid?(theme, name)
            %>
            <article class="exlab-card exlab-card-system<%= " is-blank" unless has_art %>" data-exlab-face="<%= name %>">
              <div class="exlab-face">
                <% if has_art %>
                  <img src="<%= buddy_face_url(theme, name) %>" alt="<%= pet.display_name %> — <%= name %>" loading="lazy">
                <% else %>
                  <span class="exlab-blank" aria-hidden="true">no pose</span>
                <% end %>
              </div>
              <div class="exlab-name">
                <%= name.to_s.tr("_", " ") %>
                <% if tag %><span class="exlab-tag"><%= tag %></span><% end %>
              </div>
              <p class="exlab-say">
                <%= say || pet.summaries[name] %>
                <% unless has_art %><em class="exlab-fallback">· no pose of its own</em><% end %>
              </p>
              <% if vals %>
                <%= render "system/expression_axes", vals: vals, axes: axes %>
              <% end %>
            </article>
          <% end %>
        </div>

        <% if moods.any? %>
          <div class="exlab-group-label">Expressions</div>
          <div class="exlab-grid">
            <% moods.each do |name| %>
              <% vals = faces[name] %>
              <article class="exlab-card" data-exlab-face="<%= name %>">
                <div class="exlab-face">
                  <img src="<%= buddy_face_url(theme, name) %>" alt="<%= pet.display_name %> — <%= name %>" loading="lazy">
                </div>
                <div class="exlab-name">
                  <%= name.to_s.tr("_", " ") %>
                  <% unless vals %><span class="exlab-tag">pose</span><% end %>
                </div>
                <% if pet.summaries[name] %>
                  <p class="exlab-say"><%= pet.summaries[name] %></p>
                <% elsif vals.nil? %>
                  <p class="exlab-say">Worn on cue, never picked as a mood.</p>
                <% end %>
                <% if vals %>
                  <%= render "system/expression_axes", vals: vals, axes: axes %>
                <% end %>
              </article>
            <% end %>
          </div>
        <% end %>
      </section>
    <% end %>
  </div>
</div>

<%# Chip → pet. Generic: no per-theme anything, so a new companion just works. %>
<script>
  (function () {
    var root = document.querySelector("[data-exlab]");
    if (!root) return;
    var chips = root.querySelectorAll("[data-exlab-chip]");
    var pets  = root.querySelectorAll("[data-exlab-pet]");
    var vibeEl = root.querySelector("[data-exlab-vibe]");
    var vibe = JSON.parse(vibeEl.dataset.exlabVibeData);
    var oddsEl = root.querySelector("[data-exlab-odds]");
    var sliders = root.querySelectorAll("[data-exlab-axis]");
    var theme = chips[0] && chips[0].dataset.exlabChip;

    // The picker, as Buddy::Faces has it: a face answers a reading when the
    // reading sits inside its reach on every axis (covers?), the nearest face
    // always answers (pool), and the draw among them is weighted
    // 1 / (distance + SOFTNESS) (pick).
    function distance(point, reading) {
      return vibe.axes.reduce(function (sum, axis) {
        var d = point[axis] - reading[axis];
        return sum + vibe.weights[axis] * d * d;
      }, 0);
    }
    function covers(point, reading) {
      return vibe.axes.every(function (axis) {
        return Math.abs(point[axis] - reading[axis]) <= point.reach * vibe.reach[axis];
      });
    }
    function odds(faces, reading) {
      var rows = Object.keys(faces).sort().map(function (name) {
        return { name: name, gap: distance(faces[name], reading), inRange: covers(faces[name], reading) };
      });
      var nearest = rows.reduce(function (best, row) { return !best || row.gap < best.gap ? row : best; }, null);
      var pool = rows.filter(function (row) { return row.inRange || row === nearest; });
      pool.sort(function (a, b) { return a.gap - b.gap; });
      var total = pool.reduce(function (sum, row) { return sum + 1 / (row.gap + vibe.softness); }, 0);
      pool.forEach(function (row) { row.chance = (1 / (row.gap + vibe.softness)) / total; });
      return pool;
    }

    function reading() {
      var r = {};
      sliders.forEach(function (input) { r[input.dataset.exlabAxis] = Number(input.value); });
      return r;
    }

    function render() {
      var r = reading();
      sliders.forEach(function (input) {
        root.querySelector('[data-exlab-axis-value="' + input.dataset.exlabAxis + '"]').textContent = r[input.dataset.exlabAxis].toFixed(2);
      });
      var faces = vibe.pets[theme] || {};
      var pool = odds(faces, r);
      oddsEl.replaceChildren.apply(oddsEl, pool.map(function (row) {
        var li = document.createElement("li");
        var img = document.createElement("img");
        img.src = faces[row.name].url;
        img.alt = "";
        var name = document.createElement("span");
        name.className = "exlab-odds-name";
        name.textContent = row.name.replace(/_/g, " ");
        var bar = document.createElement("span");
        bar.className = "exlab-odds-track";
        var fill = document.createElement("span");
        fill.className = "exlab-odds-fill";
        fill.style.width = (row.chance * 100).toFixed(1) + "%";
        bar.appendChild(fill);
        var pct = document.createElement("em");
        pct.textContent = Math.round(row.chance * 100) + "%";
        li.append(img, name, bar, pct);
        if (!row.inRange) li.title = "Outside every range — worn as the nearest face";
        return li;
      }));
      var chance = {};
      pool.forEach(function (row) { chance[row.name] = row.chance; });
      var petEl = root.querySelector('[data-exlab-pet="' + theme + '"]');
      petEl.querySelectorAll("[data-exlab-face]").forEach(function (card) {
        card.classList.toggle("is-picked", chance[card.dataset.exlabFace] != null);
      });
    }

    root.querySelector(".exlab-chips").addEventListener("click", function (e) {
      var chip = e.target.closest("[data-exlab-chip]");
      if (!chip) return;
      theme = chip.dataset.exlabChip;
      chips.forEach(function (c) {
        var on = c === chip;
        c.classList.toggle("is-active", on);
        c.setAttribute("aria-selected", String(on));
      });
      pets.forEach(function (p) { p.hidden = p.dataset.exlabPet !== theme; });
      render();
    });
    sliders.forEach(function (input) { input.addEventListener("input", render); });
    render();
  })();
</script>

<style>
  .exlab {
    --exlab-bg: #0E1116;
    --exlab-card: #161B22;
    --exlab-line: #262D38;
    --exlab-text: #E6EDF3;
    --exlab-muted: #8B98A8;
    --exlab-warmth: #F2B84B;
    --exlab-play: #6FCF72;
    --exlab-weight: #5C9BF2;
    --exlab-strain: #F0756B;
    --exlab-reach: #9B8CCB;
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 16px 48px;
    color: var(--exlab-text);
  }
  .exlab-intro {
    color: var(--exlab-muted);
    max-width: 62ch;
    line-height: 1.5;
    margin: 4px 0 18px;
  }
  .exlab code {
    background: var(--exlab-card);
    border: 1px solid var(--exlab-line);
    border-radius: 5px;
    padding: 1px 5px;
    font-size: 0.86em;
  }
  .exlab-legend {
    list-style: none;
    padding: 12px 14px;
    margin: 0 0 18px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    background: var(--exlab-card);
    border: 1px solid var(--exlab-line);
    border-radius: 10px;
    color: var(--exlab-muted);
    font-size: 0.86rem;
  }
  .exlab-legend li { display: flex; align-items: baseline; gap: 7px; }
  .exlab-legend b { color: var(--exlab-text); font-weight: 600; text-transform: capitalize; }
  .exlab-dot { width: 9px; height: 9px; border-radius: 50%; flex: 0 0 auto; align-self: center; }
  .exlab-dot-warmth { background: var(--exlab-warmth); }
  .exlab-dot-play   { background: var(--exlab-play); }
  .exlab-dot-weight { background: var(--exlab-weight); }
  .exlab-dot-strain { background: var(--exlab-strain); }
  .exlab-dot-reach  { background: var(--exlab-reach); }

  /* Chips — one per pet, wrapping onto as many rows as they need. The app's
     global button styling paints every <button> blue (background, a blue glow
     box-shadow, a text-shadow, and `color: white !important`), so each of those
     is explicitly neutralised here; the colour needs !important to win. */
  .exlab-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 22px;
  }
  .exlab-chip {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin: 0;
    padding: 5px 13px 5px 5px;
    border-radius: 999px;
    border: 1px solid var(--exlab-line);
    background: var(--exlab-card);
    color: var(--exlab-muted) !important;
    box-shadow: none;
    text-shadow: none;
    font: inherit;
    font-size: 0.86rem;
    font-weight: 600;
    cursor: pointer;
    transition: border-color 120ms ease, color 120ms ease, background 120ms ease;
  }
  .exlab-chip img { width: 24px; height: 24px; border-radius: 50%; object-fit: contain; background: #0B0E13; }
  .exlab-chip:hover,
  .exlab-chip:active {
    background: var(--exlab-card);
    box-shadow: none;
    color: var(--exlab-text) !important;
  }
  .exlab-chip.is-active {
    color: var(--exlab-text) !important;
    border-color: var(--exlab-reach);
    background: color-mix(in srgb, var(--exlab-reach) 16%, var(--exlab-card));
    box-shadow: inset 0 0 0 1px var(--exlab-reach);
  }
  .exlab-chip:focus-visible { outline: 2px solid var(--exlab-reach); outline-offset: 2px; }

  .exlab-pet[hidden] { display: none; }
  .exlab-pet-head {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-bottom: 12px;
    margin-bottom: 8px;
    border-bottom: 1px solid var(--exlab-line);
  }
  .exlab-avatar {
    width: 52px;
    height: 52px;
    border-radius: 12px;
    object-fit: contain;
    background: var(--exlab-card);
    border: 1px solid var(--exlab-line);
    flex: 0 0 auto;
  }
  .exlab-pet-head h2 { margin: 0; font-size: 1.3rem; }
  .exlab-summary { margin: 2px 0 3px; color: var(--exlab-text); font-size: 0.9rem; line-height: 1.4; }
  .exlab-meta { color: var(--exlab-muted); font-size: 0.85rem; text-transform: capitalize; }

  .exlab-group-label {
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--exlab-muted);
    margin: 18px 0 10px;
  }
  .exlab-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 14px;
  }
  .exlab-card {
    background: var(--exlab-card);
    border: 1px solid var(--exlab-line);
    border-radius: 12px;
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }
  .exlab-card-system { border-style: dashed; }
  .exlab-card.is-blank { opacity: 0.72; }
  .exlab-blank {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--exlab-muted);
    border: 1px dashed var(--exlab-line);
    border-radius: 999px;
    padding: 3px 10px;
  }
  .exlab-face {
    aspect-ratio: 1;
    border-radius: 10px;
    background:
      radial-gradient(circle at 50% 45%, rgba(255, 255, 255, 0.05), transparent 70%),
      #0B0E13;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .exlab-face img { width: 86%; height: 86%; object-fit: contain; }
  .exlab-name {
    font-weight: 600;
    text-transform: capitalize;
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .exlab-tag {
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--exlab-muted);
    border: 1px solid var(--exlab-line);
    border-radius: 999px;
    padding: 1px 7px;
    font-weight: 600;
  }
  .exlab-say { margin: 0; color: var(--exlab-muted); font-size: 0.8rem; line-height: 1.45; }
  .exlab-fallback { color: var(--exlab-reach); font-style: normal; }

  .exlab-axes { margin: 2px 0 0; display: flex; flex-direction: column; gap: 5px; }
  .exlab-axis { display: grid; grid-template-columns: 52px 1fr auto; align-items: center; gap: 8px; }
  .exlab-axis dt { margin: 0; font-size: 0.72rem; color: var(--exlab-muted); text-transform: capitalize; }
  .exlab-axis dd { margin: 0; display: contents; }
  .exlab-track { height: 6px; border-radius: 3px; background: #0B0E13; overflow: hidden; }
  .exlab-bar { display: block; height: 100%; border-radius: 3px; }
  .exlab-bar-warmth { background: var(--exlab-warmth); }
  .exlab-bar-play   { background: var(--exlab-play); }
  .exlab-bar-weight { background: var(--exlab-weight); }
  .exlab-bar-strain { background: var(--exlab-strain); }
  .exlab-bar-reach  { background: var(--exlab-reach); }
  .exlab-axis em {
    font-style: normal;
    font-size: 0.72rem;
    color: var(--exlab-muted);
    font-variant-numeric: tabular-nums;
    min-width: 2.4ch;
    text-align: right;
  }

  .exlab-vibe {
    background: var(--exlab-card);
    border: 1px solid var(--exlab-line);
    border-radius: 12px;
    padding: 4px 14px 14px;
    margin-bottom: 22px;
  }
  .exlab-vibe-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: 18px;
    align-items: start;
  }
  .exlab-vibe-sliders { display: flex; flex-direction: column; gap: 10px; }
  .exlab-vibe-slider {
    display: grid;
    grid-template-columns: 76px 1fr 3ch;
    align-items: center;
    gap: 10px;
    font-size: 0.82rem;
    color: var(--exlab-muted);
    text-transform: capitalize;
  }
  .exlab-vibe-slider > span { display: flex; align-items: center; gap: 6px; }
  .exlab-vibe-slider input { width: 100%; margin: 0; accent-color: var(--exlab-reach); }
  .exlab-vibe-slider em { font-style: normal; font-variant-numeric: tabular-nums; color: var(--exlab-text); }
  .exlab-vibe-odds { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; }
  .exlab-vibe-odds li {
    display: grid;
    grid-template-columns: 34px minmax(0, 8rem) 1fr 4ch;
    align-items: center;
    gap: 10px;
    font-size: 0.84rem;
  }
  .exlab-vibe-odds img { width: 34px; height: 34px; object-fit: contain; border-radius: 8px; background: #0B0E13; }
  .exlab-odds-name { text-transform: capitalize; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .exlab-odds-track { height: 8px; border-radius: 4px; background: #0B0E13; overflow: hidden; }
  .exlab-odds-fill { display: block; height: 100%; border-radius: 4px; background: var(--exlab-reach); }
  .exlab-vibe-odds em { font-style: normal; text-align: right; font-variant-numeric: tabular-nums; color: var(--exlab-muted); }
  .exlab-card.is-picked { border-color: var(--exlab-reach); box-shadow: inset 0 0 0 1px var(--exlab-reach); }

  @media (max-width: 720px) {
    .exlab-vibe-body { grid-template-columns: 1fr; }
  }

  @media (max-width: 480px) {
    .exlab-grid { grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); }
  }
</style>
