<%= meta_title @page.name, include_name: false %>
<%= meta_description strip_tags(Markdown.new(@page.content.to_s).to_html).squish.truncate(160) %>

<div class="wide-container">
  <div class="btn-container">
    <%= link_to "Back", @page.folder || :folders, class: :btn %>
    <% if @page.user == current_user %>
      <%= link_to "Edit", [:edit, @page], class: "btn pull-right" %>
      <% if @page.short_key.present? %>
        <button type="button" class="btn pull-right btn-copy-link" data-url="https://<%= @page.short_url %>" title="<%= @page.short_url %>">Copy link</button>
      <% end %>
    <% end %>
  </div>
  <div class="breadcrumbs text-center">
    <%= link_to :root, :folders %>
    <% @page.breadcrumbs.reverse.each do |parent, idx| %>
      &gt;
      <%= link_to parent.name, parent %>
    <% end %>
  </div>
  <h1 style="text-align: center;"><%= @page.name %></h1>
  <div class="tag-list">
    <% @page.tags.each do |tag| %>
      <span class="tag"><%= tag.name %></span>
    <% end %>
  </div>
  <hr>
  <%= Markdown.new(@page.content, user: current_user).to_html %>
</div>

<script>
  document.querySelectorAll(".btn-copy-link").forEach(btn => {
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.url);
        btn.textContent = "Copied";
      } catch {
        btn.textContent = "Couldn't copy";
      }
      setTimeout(() => { btn.textContent = "Copy link"; }, 1500);
    });
  });
</script>
