<div class="skinny-container">
  <a href="<%= new_email_path %>" class="btn">New Email</a>
  <div class="flex-container">
    <div class="flex-field flex-10">
      <input type="text" name="" value="<%= params[:q] %>" class="search">
    </div>
    <div class="flex-field flex-2 flex-vert-align">
      <button type="button" name="button" class="search-button">Go</button>
    </div>
  </div>
  <div class="email-filter-buttons-container">
    <div title="archived" class="email-filter" data-filter="in:archived"><i class="ti ti-oct-trashcan"></i></div>
    <div title="read" class="email-filter" data-filter="in:read"><i class="ti ti-oct-mail_read"></i></div>
    <div title="sent" class="email-filter" data-filter="in:sent"><i class="ti ti-mdi-mailbox"></i></div>
    <div title="failed" class="email-filter" data-filter="in:failed"><i class="ti ti-mdi-email_alert"></i></div>
    <div title="all" class="email-filter" data-filter="in:all"><i class="ti ti-oct-mail"></i></div>
  </div>
  <% @search_notes.each do |note| %>
    <div class="email-search-note">Search: <%= note %></div>
  <% end %>
  <details class="email-search-help">
    <summary>Search syntax</summary>
    <ul>
      <li><code>from:amazon.com</code> <code>to:rocco@rdjn.com</code> <code>address:billy</code> &mdash; name or address, either side</li>
      <li><code>subject:invoice</code> &mdash; bare words search subject, snippet, addresses, and tags</li>
      <li><code>tag:receipts</code> <code>is:tagged</code> <code>is:untagged</code></li>
      <li><code>is:read</code> <code>is:unread</code> <code>is:archived</code> <code>is:sent</code> <code>is:inbound</code> <code>is:job</code> <code>has:attachment</code></li>
      <li><code>in:inbox</code> <code>in:sent</code> <code>in:archived</code> <code>in:all</code></li>
      <li><code>after:2026-10-01</code> <code>before:2026-10-15</code> <code>timestamp:2026-10</code> <code>read_at&gt;2026-10-01</code></li>
      <li><code>-tag:x</code>, <code>OR</code>, and <code>( )</code> combine terms. A search stays in received, unarchived mail unless it names a direction, an address, or an archive state.</li>
    </ul>
  </details>
</div>

<div class="emails-container">
  <div class="text-center">
    <%= paginate @emails, params: params.to_unsafe_h %>
  </div>
  <div class="text-right">
    <%= page_entries_info @emails %>
  </div>

  <div class="email-batch-bar" data-batch-url="<%= batch_emails_path %>" data-query="<%= params[:q] %>" data-total="<%= @emails.total_count %>">
    <label title="Select this page"><input type="checkbox" class="email-select-page"></label>
    <select class="email-batch-target">
      <option value="selected" class="email-batch-selected-option">Selected (0)</option>
      <option value="page" selected>This page (<%= @emails.size %>)</option>
      <option value="all">All <%= @emails.total_count %> matching</option>
    </select>
    <button type="button" class="email-batch" data-operation="archive" title="Archive"><i class="ti ti-oct-trashcan"></i></button>
    <button type="button" class="email-batch" data-operation="unarchive" title="Unarchive"><i class="ti ti-oct-inbox"></i></button>
    <button type="button" class="email-batch" data-operation="read" title="Mark read"><i class="ti ti-oct-mail_read"></i></button>
    <button type="button" class="email-batch" data-operation="unread" title="Mark unread"><i class="ti ti-oct-mail"></i></button>
    <button type="button" class="email-batch" data-operation="add_tags" title="Add tags">+ Tag</button>
    <button type="button" class="email-batch" data-operation="remove_tags" title="Remove tags">&minus; Tag</button>
  </div>

  <% @emails.each do |email| %>
    <div class="email-wrapper">
      <input type="checkbox" class="email-select" value="<%= email.id %>">
      <a href="<%= email_path(email) %>" class="email-container <%= :unread unless email.read? %>">
        <div class="timestamp"><%= email.timestamp.in_time_zone("Mountain Time (US & Canada)").to_formatted_s(:simple_with_time) %></div>
        <div class="from">
          <% if email.archived? %>
            <i class="ti ti-oct-trashcan"></i>
          <% end %>
          <% if email.has_attachments? %>
            <div class="attachments"><i class="ti ti-mdi-paperclip"></i></div>
          <% end %>
          <% if email.inbound? %>
            <i class="ti ti-fa-arrow_right"></i>
          <% end %>
          <%= email.show_mailboxes(:outbound) %>
        </div>
        <div class="to"><%= email.show_mailboxes(:inbound) %></div>
        <div class="subject">
          <% email.tags.each do |tag| %>
            <span class="email-tag" data-tag="<%= tag %>"><%= tag %></span>
          <% end %>
          <%= email.subject.presence || "<No Subject>" %>
        </div>
        <div class="body"><%= email.blurb.presence || "<No Content>" %></div>
      </a>
      <div class="controls">
        <%= link_to email_path(email, email: { archived: true }), method: :patch, remote: true, class: "remote-email archived" do %><i class="ti ti-oct-trashcan"></i><% end %>
        <%= link_to email_path(email, email: { read: true }), method: :patch, remote: true, class: "remote-email read" do %><i class="ti ti-fa-check"></i><% end %>
      </div>
    </div>
  <% end %>

  <div class="text-center">
    <%= paginate @emails, params: params.to_unsafe_h %>
  </div>
</div>
