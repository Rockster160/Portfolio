<%= content_for(:head) do %>
  <script type="text/javascript">
    resizeIframe = function(evt) {
      let iframe = document.querySelector(".display-email-container")

      iframe.style.height = iframe.contentWindow.document.body.scrollHeight + 50 + "px"
    }
  </script>
<% end %>

<div class="skinny-container">
  <a href="<%= emails_path %>" class="btn">All Emails</a>
</div>
<div class="email-details">
  <table>
    <tr class="timestamp">
      <td>Timestamp</td>
      <td><%= @email.created_at.in_time_zone("Mountain Time (US & Canada)") %></td>
    </tr>
    <tr class="from">
      <td>From</td>
      <td><%= @email.from_display %></td>
    </tr>
    <tr class="to">
      <td>To</td>
      <td><%= @email.to_display %></td>
    </tr>
    <tr class="subject">
      <td>Subject</td>
      <td><%= @email.subject.presence || "<No Subject>" %></td>
    </tr>
  </table>
</div>
<div class="skinny-container">
  <a href="<%= new_email_path(email: @email.reply_defaults) %>" class="btn">Reply</a>
  <a href="<%= new_email_path(email: @email.forward_defaults) %>" class="btn">Forward</a>
  <% if @email.archived? %>
    <%= link_to "Unarchive", email_path(@email, email: {archived: false}), method: :patch, class: "btn" %>
  <% else %>
    <%= link_to "Archive", email_path(@email, email: {archived: true}), method: :patch, class: "btn" %>
  <% end %>
</div>

<%# The body is rendered from `to_html`, which is the words only, so a file the
   mail arrived with had nowhere to be reached from - while the list view was
   already painting a paperclip to say it was in there. %>
<% if @attachments.any? %>
  <div class="skinny-container email-attachments">
    <h4><%= pluralize(@attachments.size, "attachment") %></h4>
    <ul>
      <% @attachments.each_with_index do |part, index| %>
        <li>
          <%= link_to attachment_email_path(@email, index) do %>
            <i class="ti ti-mdi-paperclip"></i>
            <%= part.filename.presence || "Untitled file" %>
          <% end %>
          <span class="meta">
            <%= part.mime_type %> &middot; <%= number_to_human_size(part.body.decoded.bytesize) %>
          </span>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>

<div class="skinny-container">
  <%= render_iframe(@email.to_html) %>
</div>
