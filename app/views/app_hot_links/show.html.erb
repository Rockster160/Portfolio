<% content_for :title, "Hot links" %>
<% kinds = {
  command:     "Run a command",
  buddy:       "Message Buddy",
  prompt:      "Ask, then send",
  task:        "Run a Jil task",
  routine:     "Run a routine",
  trigger:     "Fire a Jil trigger",
  check_in:    "Open a check-in",
  list_toggle: "Toggle a list item",
  open:        "Open a page",
  url:         "Open a link",
} %>
<div class="panel-app" data-hot-link-symbols="<%= AppDevices::HotLinks::SYMBOLS.to_json %>">
  <%= form_with url: app_hot_links_path, method: :patch, class: "panel-page", data: { hot_links_form: true } do |f| %>
    <header class="panel-topbar">
      <a class="panel-icon-btn" data-back href="<%= app_settings_path %>" aria-label="Buddy for iPhone">‹</a>
      <h1>Hot links</h1>
    </header>

    <div data-hot-links data-hot-links-max="<%= AppDevices::HotLinks::MAX %>">
      <div class="panel-settings buddy-app-hot-links" data-hot-links-saved<%= " hidden" if @hot_links.empty? %>>
        <% @hot_links.each_with_index do |link, index| %>
          <%= render "app_hot_links/link", link: link, index: index, kinds: kinds %>
        <% end %>
      </div>
      <% if @hot_links.size < AppDevices::HotLinks::MAX %>
        <%= render "app_hot_links/link", link: {}, index: @hot_links.size, kinds: kinds %>
      <% end %>
    </div>
  <% end %>
</div>
