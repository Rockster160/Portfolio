<% content_for :title, "Meal Calorie Tracker" %>
<% content_for :modals do %>
  <div id="cmodal-backdrop" class="cmodal-backdrop hidden">
    <div class="cmodal">
      <h3 id="cmodal-title">Edit Item</h3>
      <div class="row">
        <input id="m-cat" class="sm" placeholder="Category">
        <input id="m-name" placeholder="Name">
        <input id="m-cal" class="sm basic" type="number" placeholder="Calories">
      </div>
      <div class="row">
        <input id="m-img" placeholder="Image URL or emoji">
      </div>
      <div class="row">
        <input id="m-tag" placeholder="Tag / helper text">
        <input id="m-alias" placeholder="Alias">
        <input id="m-desc" placeholder="Description">
      </div>
      <div class="cmodal-actions">
        <button id="m-delete" class="danger primary" type="button">Delete</button>
        <div class="spacer"></div>
        <button id="m-cancel" class="primary" type="button">Cancel</button>
        <button id="m-save" class="ok primary" type="button">Done</button>
      </div>
    </div>
  </div>

  <div id="qmodal-backdrop" class="cmodal-backdrop hidden">
    <div class="cmodal">
      <h3>Quick Edit</h3>
      <textarea id="q-text" rows="12" wrap="off"
        style="width:100%;padding:8px 10px;border:1px solid #CCC;border-radius:6px;
              font-family: ui-monospace, SFMono-Regular, Menlo, monospace"></textarea>
      <div class="cmodal-actions">
        <div class="spacer"></div>
        <button id="q-cancel" class="primary" type="button">Cancel</button>
        <button id="q-apply" class="ok primary" type="button">Apply</button>
      </div>
    </div>
  </div>

  <div id="omodal-backdrop" class="cmodal-backdrop hidden">
    <div class="cmodal">
      <h3>One-off item</h3>
      <div class="row">
        <input id="o-name" placeholder="What was it?">
      </div>
      <div class="row">
        <input id="o-cat" class="sm" placeholder="Category" value="Food">
        <input id="o-cal" class="sm basic" type="number" inputmode="numeric" min="0" placeholder="Calories">
      </div>
      <div class="cmodal-actions">
        <div class="spacer"></div>
        <button id="o-cancel" class="primary" type="button">Cancel</button>
        <button id="o-save" class="ok primary" type="button">Add</button>
      </div>
    </div>
  </div>
<% end %>

<div class="wrap" data-save-url="<%= meal_builder_path(@meal_builder) %>">
  <div class="summary-container">
    <div class="widget" data-task-id="calories" id="cal-monitor">
      <span class="lines hidden"></span>
      <div id="cal-monitor-details" class="row flex-between">
        <span>Week: <span id="cal-week">…</span></span>
        <span>
          🍰 <span id="cal-today">…</span> -
          🔥 <span id="cal-burn">…</span> =
          <span id="cal-deficit-icon"></span> <span id="cal-deficit">…</span>
          <span style="font-weight: 300; color: #3D4855; font-size: 12px;">
            /<span id="cal-rmr">…</span>
          </span>
        </span>
      </div>
    </div>

    <div class="text-right">
      [<span id="selected-summary"></span>] (<span id="cal-total">0</span>)
    </div>
  </div>

  <div class="topbar">
    <div class="row flex-between" data-editing=true class="hidden">
      <button id="cancel-edit" class="primary" type="button">❌</button>
      <%= link_to "🔄 Reload", meal_builder_path(@meal_builder), class: "btn primary" %>
      <%= link_to "✏️ Edit Page", edit_meal_builder_path(@meal_builder), class: "btn primary", id: "page-edit" %>
    </div>

    <div class="row">
      <button id="toggle-edit" class="primary" type="button">⚙️</button>
      <button id="save-items" class="primary" type="button" class="hidden">💾</button>
      <button id="add-item" class="primary" type="button" class="hidden">➕</button>
      <button id="quick-edit" class="primary" type="button" class="hidden">✍️</button>

      <input id="search" type="search" placeholder="Search food..." autocomplete="off">

      <button id="submit" class="primary" data-editing=false disabled>Submit</button>
    </div>

    <div class="row meal-extras" data-editing=false>
      <button id="add-oneoff" class="primary" type="button">➕ One-off</button>
      <div class="meal-time">
        <button id="meal-time-label" class="primary" type="button" tabindex="-1">🕒 Now</button>
        <input id="meal-time" class="basic" type="datetime-local" aria-label="When was this meal?">
      </div>
      <button id="meal-time-reset" class="primary hidden" type="button" aria-label="Back to now">✕</button>
    </div>
  </div>

  <div id="grid" class="brows"></div>
</div>

<% content_for :after_body do %>
  <script id="items-data" type="application/json">
    <%= raw(@meal_builder.items.to_json) %>
  </script>

  <style>
    html, body { margin: 0; padding: 0; font-family: system-ui, -apple-system, Segoe UI, Roboto; }
    .summary-container {
      font-weight: 500; color: #4B5563;
    }
    .wrap { max-width: 1600px; margin: 0 auto; padding: 16px 20px 28px }
    .topbar { display: flex; flex-direction: column; gap: 10px; align-items: center; margin-bottom: 12px }
    input[type="text"] {
      flex: 1; padding: 10px 12px; border: 1px solid #CCC;
      border-radius: 8px; outline: none
    }
    button {
      padding: inherit;
    }
    button.primary, .btn.primary {
      min-height: 48px; min-width: 48px; padding: 6px 12px; border: none; border-radius: 8px;
      background: #2563EB; color: black; cursor: pointer
    }
    button.primary:disabled { opacity: .5; cursor: default }

    .text-right { text-align: right; }
    .row { display: flex; gap: 10px; width: 100% }
    .row.right { justify-content: flex-end; }
    .row input {
      flex: 1; padding: 8px 10px; border: 1px solid #CCC; border-radius: 6px
    }
    .topbar .row input[type="search"] { min-height: 48px; margin: 0 }
    .flex-between {
      display: flex; justify-content: space-between; align-items: center
    }
    .row .sm { max-width: 130px }
    @media (max-width: 600px) { .wrap { padding: 8px 0 20px } }

    /* The native picker sits invisibly over its label, so a tap anywhere on
       the label opens it on every platform without showPicker(). */
    .meal-time { position: relative; flex: 1 }
    .meal-time button { width: 100% }
    .meal-time input {
      position: absolute; inset: 0; width: 100%; height: 100%;
      margin: 0; padding: 0; border: 0; opacity: 0; cursor: pointer
    }
    .meal-time.is-set button { background: #F59E0B }

    .hidden { display: none }
  </style>

  <script type="module">
    import { command } from "../../quick_actions/command.js";
    import { showFlash } from "../../quick_actions/flash.js";
    import {
      fuzzyMatch, setText, setIcon, setBadges, setDesc, setCount, reconcileRows, enableDragReorder,
    } from "../../quick_actions/builder_rows.js";

    let ITEMS = JSON.parse(
      document.getElementById("items-data").textContent || "[]"
    )
    // Items for this meal only: never saved to the builder, gone on submit.
    let ONEOFFS = []
    let oneoffSeq = 0

    const picked = new Map()
    let query = ""
    let editMode = false

    let preEdit = ""

    const elGrid = document.getElementById("grid")
    const elSearch = document.getElementById("search")
    const elSubmit = document.getElementById("submit")
    const elCancelEdit = document.getElementById("cancel-edit")
    const elToggleEdit = document.getElementById("toggle-edit")
    const elAddItem = document.getElementById("add-item")
    const elSaveItems = document.getElementById("save-items")
    const elQuickEdit = document.getElementById("quick-edit")
    const SAVE_ENDPOINT = document.querySelector(".wrap")?.dataset.saveUrl

    const elcModal = document.getElementById("cmodal-backdrop")
    const mTitle = document.getElementById("cmodal-title")
    const mName = document.getElementById("m-name")
    const mCat = document.getElementById("m-cat")
    const mCal = document.getElementById("m-cal")
    const mImg = document.getElementById("m-img")
    const mTag = document.getElementById("m-tag")
    const mAlias = document.getElementById("m-alias")
    const mDesc  = document.getElementById("m-desc")
    const mSave = document.getElementById("m-save")
    const mCancel = document.getElementById("m-cancel")
    const mDelete = document.getElementById("m-delete")
    let currentEditingName = null
    let isNewItem = false

    const elQModal = document.getElementById("qmodal-backdrop")
    const elQText = document.getElementById("q-text")
    const elQApply = document.getElementById("q-apply")
    const elQCancel = document.getElementById("q-cancel")

    const elOModal = document.getElementById("omodal-backdrop")
    const oName = document.getElementById("o-name")
    const oCat = document.getElementById("o-cat")
    const oCal = document.getElementById("o-cal")
    const oSave = document.getElementById("o-save")
    const oCancel = document.getElementById("o-cancel")
    const elAddOneoff = document.getElementById("add-oneoff")

    const elMealTimeWrap = document.querySelector(".meal-time")
    const elMealTime = document.getElementById("meal-time")
    const elMealTimeLabel = document.getElementById("meal-time-label")
    const elMealTimeReset = document.getElementById("meal-time-reset")

    const caloriesMonitor = Monitor.find("calories")
    let calories_synced = false
    const updateCals = () => {
      const wrapper = caloriesMonitor.element
      const lines = wrapper.querySelector(".lines").textContent
      if (!lines) { return }
      const regex = /(\w+):\s+([-\d]+(?: [-\d]+)?)/g;
      const values = {};
      for (const [, label, nums] of lines.matchAll(regex)) {
        const parts = nums.split(/\s+/).map(Number);
        if (parts.length > 1) {
          values.Burn = parts[1];
        }
        values[label] = parts[0];
      }
      if ("RMR" in values) { values.RMR = -(values.RMR); }
      if ("Burn" in values) { values.Burn = -(values.Burn); }

      const details = wrapper.querySelector("#cal-monitor-details")

      details.querySelector("#cal-today").textContent = values.Today
      details.querySelector("#cal-burn").textContent = values.Burn
      details.querySelector("#cal-deficit").textContent = values.Deficit
      details.querySelector("#cal-deficit-icon").textContent = values.Deficit < 0 ? "❌" : "✅"
      details.querySelector("#cal-week").textContent = `${values.Week > 0 ? "✅ +" : "❌ "}${values.Week}`
      details.querySelector("#cal-rmr").textContent = values.RMR
      calories_synced = true
    };
    caloriesMonitor.callbacks.push(updateCals);
    updateCals();
    setTimeout(() => {
      if (!calories_synced) {
        caloriesMonitor.resync()
      }
    }, 500)

    const csrfToken = () => {
      const m = document.querySelector('meta[name="csrf-token"]')
      return m ? m.content : ""
    }

    const keyOf = it => it.oneoff ? it.key : `${it.category}|${it.name}`
    const itemByKey = key => (
      ONEOFFS.find(it => it.key === key) || ITEMS.find(it => keyOf(it) === key)
    )
    const updateSubmit = () => { elSubmit.disabled = picked.size === 0 }

    // Drops picks whose item no longer exists after the item list was
    // replaced wholesale. One-offs aren't part of that list and stay.
    const prunePicked = () => {
      const keys = new Set(ITEMS.map(keyOf))
      for (const k of Array.from(picked.keys())) {
        if (!keys.has(k) && !ONEOFFS.some(it => it.key === k)) picked.delete(k)
      }
    }

    // ---------- Edit Modal ----------
    const opencModal = item => {
      mCat.dataset.prevCategory = item?.category || "Food"
      currentEditingName = item?.name || null
      isNewItem = !item
      mTitle.textContent = isNewItem ? "Add Item" : "Edit Item"
      mName.value = item?.name || ""
      mCal.value = item?.cal != null ? String(item.cal) : ""
      mCat.value = item?.category || "Food"
      mImg.value = item?.img || ""
      mTag.value = item?.tag || ""
      mAlias.value = item?.alias || ""
      mDesc.value  = item?.description || ""
      mDelete.classList.toggle("hidden", isNewItem)
      elcModal.classList.remove("hidden")
      setTimeout(() => mName.focus(), 0)
    }

    const closecModal = () => {
      elcModal.classList.add("hidden")
      currentEditingName = null
      isNewItem = false
    }

    mCancel.addEventListener("click", () => closecModal())

    mSave.addEventListener("click", () => {
      const category = (mCat.value.trim() || "Food").replace(/\s+/g, "")
      const name = mName.value.trim() || "Untitled"
      const calVal = parseInt(mCal.value || "0", 10)
      const cal = Math.max(0, Number.isFinite(calVal) ? calVal : 0)
      const img = mImg.value.trim()
      const tag = mTag.value.trim()
      const alias = mAlias.value.trim()
      const description = mDesc.value.trim()

      if (isNewItem) {
        ITEMS.push({ category, name, cal, img, tag, alias, description })
      } else {
        const idx = ITEMS.findIndex(x =>
          x.name === currentEditingName && x.category === mCat.dataset.prevCategory
        )
        if (idx >= 0) ITEMS[idx] = { ...ITEMS[idx], category, name, cal, img, tag, alias, description }
        const oldKey = `${mCat.dataset.prevCategory}|${currentEditingName}`
        const newKey = `${category}|${name}`
        const cur = picked.get(oldKey)
        if (cur) { picked.delete(oldKey); picked.set(newKey, cur) }
      }
      mCat.dataset.prevCategory = category
      closecModal()
      render()
    })

    mDelete.addEventListener("click", () => {
      if (!currentEditingName) return
      const category = mCat.dataset.prevCategory
      ITEMS = ITEMS.filter(x => !(x.name === currentEditingName && x.category === category))
      picked.delete(`${category}|${currentEditingName}`)
      closecModal()
      render()
    })

    elcModal.addEventListener("click", e => {
      if (e.target === elcModal) closecModal()
    })

    // ---------- One-off items ----------
    const openOneoff = () => {
      oName.value = ""
      oCal.value = ""
      oCat.value = "Food"
      elOModal.classList.remove("hidden")
      setTimeout(() => oName.focus(), 0)
    }
    const closeOneoff = () => elOModal.classList.add("hidden")

    elAddOneoff.addEventListener("click", openOneoff)
    oCancel.addEventListener("click", closeOneoff)
    elOModal.addEventListener("click", e => {
      if (e.target === elOModal) closeOneoff()
    })

    // The log line is "<Category> name, name x2 (cal)": the category must be
    // one word, and a name can't carry the separators that line is built from.
    oSave.addEventListener("click", () => {
      const name = oName.value.replace(/[(){}\[\]|,]/g, " ").replace(/\s+/g, " ").trim()
      if (!name) {
        oName.focus()
        return
      }
      const category = (oCat.value.trim() || "Food").replace(/\s+/g, "")
      const cal = Math.max(0, parseInt(oCal.value || "0", 10) || 0)
      const key = `oneoff:${++oneoffSeq}`
      ONEOFFS.push({ key, oneoff: true, category, name, cal, img: "" })
      picked.set(key, 1)
      closeOneoff()
      updateSubmit()
      render()
    })

    // ---------- Meal time ----------
    // Empty means "now" and the log carries no time. A set time is spelled
    // out in full ("on October 5, 2026 at 7:05pm") so the log parser can't
    // read it as a different day.
    const MONTHS = [
      "January", "February", "March", "April", "May", "June",
      "July", "August", "September", "October", "November", "December",
    ]
    let prefilledTime = ""

    const mealTime = () => {
      if (!elMealTime.value) return null
      const d = new Date(elMealTime.value)
      return Number.isNaN(d.getTime()) ? null : d
    }

    const clockText = d => {
      const hour = d.getHours() % 12 || 12
      const minutes = String(d.getMinutes()).padStart(2, "0")
      return `${hour}:${minutes}${d.getHours() < 12 ? "am" : "pm"}`
    }

    const mealTimePhrase = () => {
      const d = mealTime()
      if (!d) return ""
      return ` on ${MONTHS[d.getMonth()]} ${d.getDate()}, ${d.getFullYear()} at ${clockText(d)}`
    }

    const localInputValue = d => {
      const pad = n => String(n).padStart(2, "0")
      return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`
    }

    const updateMealTime = () => {
      const d = mealTime()
      const isToday = d && d.toDateString() === new Date().toDateString()
      let label = "🕒 Now"
      if (d) label = `🕒 ${isToday ? "Today" : `${MONTHS[d.getMonth()].slice(0, 3)} ${d.getDate()}`} ${clockText(d)}`
      setText(elMealTimeLabel, label)
      elMealTimeWrap.classList.toggle("is-set", !!d)
      elMealTimeReset.classList.toggle("hidden", !d)
    }

    // An empty picker opens on a blank date; seed it with now so adjusting
    // the time is one change, and forget the seed if it was left untouched.
    elMealTime.addEventListener("focus", () => {
      if (elMealTime.value) return
      prefilledTime = localInputValue(new Date())
      elMealTime.value = prefilledTime
    })
    elMealTime.addEventListener("blur", () => {
      if (prefilledTime && elMealTime.value === prefilledTime) elMealTime.value = ""
      prefilledTime = ""
      updateMealTime()
    })
    elMealTime.addEventListener("change", () => {
      prefilledTime = ""
      updateMealTime()
      updateSummary()
    })
    elMealTimeReset.addEventListener("click", () => {
      elMealTime.value = ""
      updateMealTime()
      updateSummary()
    })

    // ---------- Quick Edit ----------
    const itemsToText = items => {
      return items.map(it => {
        const base = `${it.category} ${it.name} (${
          Math.max(0, parseInt(it.cal ?? 0, 10) || 0)
        }) ${(it.img || "").trim()}`

        const tagPart = (it.tag?.trim()) ? ` | ${it.tag.trim()}` : ""
        const aliasPart = (it.alias?.trim()) ? ` [${it.alias.trim()}]` : ""
        const descPart = (it.description?.trim()) ? ` > ${it.description.trim()}` : ""

        return `${base}${tagPart}${aliasPart}${descPart}`
      }).join("\n")
    }

    const textToItems = text => {
      return text.split("\n").map(line => {
        const raw = line.trim()
        if (!raw) return null
        const [left, tagRaw] = raw.split("|", 2)
        const rx = new RegExp([
          /^ *(?<category>\S+)\s+/,
          /(?<name>.+?)\s*/,
          /\(\s*(?<cal>\d+)\s*\)\s*/,
          /(?<img>.+?)?\s*/,
          /(?:\|\s*(?<tag>.+?))?\s*/,
          /(?:\[\s*(?<alias>.+?)\s*\])?\s*/,
          /(?:>\s*(?<desc>.+?))?\s*$/,
        ].map(pattern => pattern.source).join(""), "")
        const m = left.trim().match(rx)
        if (!m) return null

        const { category, name, cal, img, tag, alias, desc } = m.groups
        return {
          category: category.trim(),
          name: name.trim(),
          cal: Math.max(0, parseInt(cal, 10) || 0),
          img: (img || "").trim(),
          tag: (tag || "").trim(),
          alias: (alias || "").trim(),
          description: (desc || "").trim()
        }
      }).filter(Boolean)
    }

    const openQuickEdit = () => {
      if (!elQModal) return
      elQText.value = itemsToText(ITEMS)
      elQModal.classList.remove("hidden")
      setTimeout(() => elQText.focus(), 0)
    }

    const closeQuickEdit = () => { elQModal?.classList.add("hidden") }

    elQuickEdit?.addEventListener("click", openQuickEdit)
    elQCancel?.addEventListener("click", closeQuickEdit)
    elQApply?.addEventListener("click", () => {
      ITEMS = textToItems(elQText.value)
      prunePicked()
      closeQuickEdit()
      render()
    })
    elQModal?.addEventListener("click", e => {
      if (e.target === elQModal) closeQuickEdit()
    })

    // ---------- Picks ----------
    // "Food Apple, Banana x2 (300)" per category, plus the meal time if set.
    const pickedLines = () => {
      const byCat = new Map()
      for (const [key, count] of picked.entries()) {
        const it = itemByKey(key)
        if (!it) continue
        const entry = byCat.get(it.category) || { parts: [], total: 0 }
        entry.parts.push(count > 1 ? `${it.name} x${count}` : it.name)
        entry.total += it.cal * count
        byCat.set(it.category, entry)
      }
      return Array.from(byCat.entries())
    }

    const updateSummary = () => {
      const groups = pickedLines()
      const total = groups.reduce((sum, [, { total }]) => sum + total, 0)
      setText(document.getElementById("cal-total"), String(total))
      const foods = groups.map(([category, { parts }]) => `${category} ${parts.join(", ")}`)
      const d = mealTime()
      if (d && foods.length) foods.push(`at ${clockText(d)}`)
      setText(document.getElementById("selected-summary"), foods.join(" | "))
    }

    const adjustPick = (key, delta) => {
      const next = (picked.get(key) || 0) + delta
      if (next > 0) {
        picked.set(key, next)
      } else {
        picked.delete(key)
        ONEOFFS = ONEOFFS.filter(it => it.key !== key)
      }
      updateSubmit()
      render()
    }

    // ---------- Render ----------
    const rowEls = new Map()

    const updateRow = (row, it) => {
      const count = picked.get(keyOf(it)) || 0
      row.classList.toggle("selected", count > 0)
      row.draggable = editMode && !it.oneoff

      setIcon(row, it.img, it.oneoff ? "✍️" : "🍽️")
      setText(row.querySelector(".brow-title"), it.alias?.trim() || it.name)
      const detail = [it.description, `${it.cal} cal`].filter(Boolean).join(" · ")
      setBadges(row, it.oneoff ? [{ text: "One-off" }] : [])
      setDesc(row, detail)
      setCount(row, count)
    }

    const render = () => {
      document.body.classList.toggle("editing", editMode)
      document.querySelectorAll("[data-editing=true]").forEach(el => el.classList.toggle("hidden", !editMode))
      document.querySelectorAll("[data-editing=false]").forEach(el => el.classList.toggle("hidden", editMode))
      elToggleEdit.classList.toggle("hidden", editMode)
      elAddItem.classList.toggle("hidden", !editMode)
      elSaveItems.classList.toggle("hidden", !editMode)
      elQuickEdit?.classList.toggle("hidden", !editMode)

      const entries = [
        ...ONEOFFS.map(it => ({ key: it.key, item: it, hidden: editMode })),
        ...ITEMS.map(it => ({
          key: keyOf(it),
          item: it,
          hidden: !fuzzyMatch(query, `${it.category} ${it.name} ${it.tag || ""}`),
        })),
      ]
      reconcileRows(elGrid, rowEls, entries, updateRow)
      updateSummary()
    }

    elGrid.addEventListener("click", e => {
      const row = e.target.closest(".brow")
      if (!row) return
      const it = itemByKey(row.dataset.key)
      if (!it) return
      e.preventDefault()

      if (editMode) {
        if (!it.oneoff) opencModal(it)
        return
      }
      const step = e.target.closest(".brow-step")
      if (step) {
        adjustPick(row.dataset.key, Number(step.dataset.step))
        return
      }
      if (e.target.closest(".brow-stepper")) return
      adjustPick(row.dataset.key, 1)
    })

    enableDragReorder(elGrid, {
      isActive: () => editMode,
      onDrop: keys => {
        const order = new Map(keys.map((k, i) => [k, i]))
        ITEMS.sort((a, b) => order.get(keyOf(a)) - order.get(keyOf(b)))
        render()
      },
    })

    // ---------- Search / Submit / Edit toggle / Add / Save ----------
    elSearch.addEventListener("input", e => {
      query = e.target.value.trim()
      render()
    })

    elSubmit.addEventListener("click", () => {
      const when = mealTimePhrase()
      const lines = pickedLines().map(([category, { parts, total }]) => {
        return `${category} ${parts.join(", ")} (${total})${when}`
      })

      showFlash("Submitting...")
      lines.forEach(item => {
        command.socket.send({ action: "command", words: `log ${item}` })
      })
      picked.clear()
      ONEOFFS = []
      elMealTime.value = ""
      updateMealTime()
      updateSubmit()
      render()
    })

    elToggleEdit.addEventListener("click", () => {
      if (!editMode) {
        preEdit = itemsToText(ITEMS)
      }
      editMode = !editMode
      render()
    })

    elCancelEdit.addEventListener("click", () => {
      ITEMS = textToItems(preEdit)
      prunePicked()
      editMode = false
      render()
    })

    elAddItem.addEventListener("click", () => opencModal(null))

    const normalizeItems = items => {
      return items.map(it => ({
        category: String(it.category || "Food").trim(),
        name: String(it.name || "Untitled").trim(),
        cal: Math.max(0, parseInt(it.cal ?? 0, 10) || 0),
        img: (it.img || "").toString().trim(),
        tag: (it.tag || "").toString().trim(),
        alias: (it.alias || "").toString().trim(),
        description: (it.description || "").toString().trim()
      }))
    }

    elSaveItems.addEventListener("click", async () => {
      if (preEdit === itemsToText(ITEMS)) {
        editMode = false
        render()
        return
      }

      const payload = { meal_builder: { items: normalizeItems(ITEMS) } }

      const res = await fetch(SAVE_ENDPOINT, {
        method: "PATCH",
        headers: {
          "Content-Type": "application/json",
          "X-CSRF-Token": csrfToken(),
          "Accept": "application/json"
        },
        body: JSON.stringify(payload),
        credentials: "same-origin"
      })

      if (res.ok) {
        showFlash("Saved! ✅")
        editMode = false
        render()
        return
      }

      const err = await res.text().catch(() => "")
      console.error("Save failed", res.status, err)
      alert("Save failed")
    })

    // ---------- Boot ----------
    document.addEventListener("DOMContentLoaded", () => {
      render()
      updateSubmit()
      updateMealTime()
    })

    window.addEventListener("beforeunload", e => {
      if (!editMode) return
      const current = itemsToText(ITEMS)
      if (current !== preEdit) {
        e.preventDefault()
        e.returnValue = ""
      }
    })
  </script>
<% end %>
