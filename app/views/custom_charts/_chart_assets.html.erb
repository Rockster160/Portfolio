<% content_for(:head) do %>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.3.0/dist/chart.umd.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns@3.0.0/dist/chartjs-adapter-date-fns.bundle.min.js"></script>
  <style>
    .cc-page, .cc-index, .cc-editor { max-width: 900px; margin: 0 auto; padding: 12px; color: #C9D1D9; }
    .cc-page a, .cc-index a.cc-crumb { color: #8B949E; text-decoration: none; }
    .cc-page a:hover { color: #5DADE2; }

    .cc-header { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; margin-bottom: 16px; flex-wrap: wrap; }
    .cc-title { font-size: 20px; font-weight: bold; color: #C9D1D9; }
    .cc-range-label { font-size: 13px; color: #8B949E; margin-top: 2px; }

    .cc-stats { display: flex; gap: 28px; margin-bottom: 16px; flex-wrap: wrap; }
    .cc-stat-value { font-size: 24px; font-weight: bold; color: #5DADE2; font-variant-numeric: tabular-nums; }
    .cc-stat-label { font-size: 12px; color: #8B949E; margin-top: 2px; }

    .cc-controls { display: flex; align-items: center; gap: 12px; margin-bottom: 14px; flex-wrap: wrap; }
    .cc-ranges, .cc-nav { display: flex; gap: 6px; }
    .cc-btn, .cc-range-btn, .cc-nav-btn {
      padding: 6px 12px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.08);
      background-color: #161B22; color: #C9D1D9; font-size: 13px; text-decoration: none; cursor: pointer;
    }
    .cc-range-btn:hover, .cc-nav-btn:hover, .cc-btn:hover { border-color: #5DADE2; }
    .cc-range-btn.active { background-color: #5DADE2; border-color: #5DADE2; color: #0D1117; font-weight: bold; }
    .cc-btn-primary { background-color: #5DADE2; border-color: #5DADE2; color: #0D1117; font-weight: bold; }
    .cc-daterange { display: flex; align-items: center; gap: 6px; }
    .cc-daterange-sep { color: #8B949E; }
    .cc-daterange input[type=date] {
      background-color: #161B22; color: #C9D1D9; border: 1px solid rgba(255,255,255,0.08);
      border-radius: 6px; padding: 5px 8px; font-size: 13px; color-scheme: dark;
    }
    .cc-daterange input[type=date]:hover { border-color: #5DADE2; }
    .cc-bucket { display: flex; align-items: center; gap: 6px; font-size: 13px; color: #8B949E; margin-left: auto; }
    .cc-bucket select { background-color: #161B22; color: #C9D1D9; border: 1px solid rgba(255,255,255,0.08); border-radius: 6px; padding: 5px 8px; }

    .chart-wrapper { background-color: #161B22; border-radius: 6px; padding: 16px; height: 360px; position: relative; }

    .cc-legend { margin-top: 14px; display: flex; flex-wrap: wrap; gap: 8px 20px; }
    .cc-legend-row { display: flex; align-items: center; gap: 8px; font-size: 13px; }
    .cc-legend-label { color: #C9D1D9; }
    .cc-legend-total { color: #8B949E; font-variant-numeric: tabular-nums; }
    .cc-swatch { width: 12px; height: 12px; border-radius: 3px; flex-shrink: 0; }

    .cc-empty { color: #8B949E; padding: 24px; text-align: center; }

    .cc-index-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; }
    .cc-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px; }
    .cc-card { display: block; background-color: #161B22; border: 1px solid rgba(255,255,255,0.08); border-radius: 8px; padding: 14px; text-decoration: none; }
    .cc-card:hover { border-color: #5DADE2; }
    .cc-card-name { font-size: 15px; font-weight: bold; color: #C9D1D9; }
    .cc-card-meta { font-size: 12px; color: #8B949E; margin-top: 2px; }
    .cc-card-query {
      display: block; margin-top: 10px; padding: 6px 8px; border-radius: 5px;
      background-color: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.06);
      font-family: monospace; font-size: 12px; color: #A5D6A7;
      white-space: pre-wrap; word-break: break-word;
    }
    .cc-card-query-empty { font-style: italic; color: #6E7681; }

    .cc-editor-grid { display: grid; grid-template-columns: 320px 1fr; gap: 20px; align-items: start; }
    @media (max-width: 720px) { .cc-editor-grid { grid-template-columns: 1fr; } }
    .cc-form .cc-field { margin-bottom: 12px; }
    .cc-form label { display: block; font-size: 12px; color: #8B949E; margin-bottom: 4px; }
    .cc-form input[type=text], .cc-form select, .cc-form textarea {
      width: 100%; background-color: #161B22; color: #C9D1D9;
      border: 1px solid rgba(255,255,255,0.08); border-radius: 6px; padding: 7px 9px; box-sizing: border-box;
    }
    .cc-form textarea { font-family: inherit; resize: vertical; }
    .cc-form .cc-field-inline { display: flex; align-items: center; gap: 8px; }
    .cc-form .cc-field-inline label { display: inline; margin-bottom: 0; }
    .cc-form .cc-field-inline input[type=checkbox] { flex: none; margin: 0; }

    .chart-wrapper { position: relative; }
    .cc-empty-overlay {
      position: absolute; inset: 0; display: none; align-items: center; justify-content: center;
      text-align: center; padding: 24px; color: #8B949E; font-size: 14px; pointer-events: none;
    }
    .cc-marker-tip {
      position: absolute; display: none; z-index: 5; pointer-events: none;
      max-width: 220px; transform: translateY(-50%);
      background: #0D1117; color: #C9D1D9; border: 1px solid rgba(255,255,255,0.15);
      border-radius: 6px; padding: 6px 9px; font-size: 12px; line-height: 1.35;
    }
    .cc-marker-tip strong { color: #fab219; }
    .cc-form-row { display: flex; gap: 10px; }
    .cc-form-row > * { flex: 1; }
    .cc-form-actions { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
    .cc-actions-left { display: flex; align-items: center; gap: 10px; }
  </style>
<% end %>
