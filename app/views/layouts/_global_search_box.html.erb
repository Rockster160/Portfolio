<div class="global-search" data-global-search <%= "data-global-search-autofocus" if local_assigns[:autofocus] %>>
  <div class="global-search-field">
    <i class="fa fa-search" aria-hidden="true"></i>
    <input type="search" class="basic" data-global-search-input placeholder="Search everything"
           aria-label="Search everything" autocomplete="off" autocapitalize="off" spellcheck="false">
  </div>
  <div class="global-search-results" data-global-search-results role="listbox" hidden></div>
</div>
