<%# Chores browser-tab + home-screen icon. The manifest and theme-color live
    in _shell_head (shared across every chores view); this partial adds the icon
    links and, by filling the layout's :favicon slot, keeps the generic app
    favicon from rendering in their place. %>
<link rel="apple-touch-icon" sizes="180x180" href="/chores_favicon/apple-touch-icon.png">
<link rel="icon" type="image/png" sizes="32x32" href="/chores_favicon/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/chores_favicon/favicon-16x16.png">
<link rel="shortcut icon" href="/chores_favicon/favicon.ico">
<meta name="apple-mobile-web-app-title" content="Chores">
