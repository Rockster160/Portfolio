<%= meta_title "#{@transcript.label} — #{@job.company}" %>
<%= meta_description "Transcript — #{@job.company}." %>

<div class="wide-container interview-back-row">
  <%= link_to "← #{@job.company}", interview_path(@job), class: :btn %>
</div>

<%# ONE FORM OVER THE WHOLE PAGE.
   Naming a speaker and moving a turn onto the right one are the same job at
   two scales, and both are done while reading: you recognise who Speaker 3 is
   four minutes in, and you spot the handover the recorder missed a paragraph
   later. Two forms would mean saving, losing your place, and scrolling back. %>
<div class="wide-container interviews-page transcript-page" data-interviews
     style="--job-color: <%= @job.color %>;">
  <div class="app-card-container">
    <div class="app-card-title">
      <div class="job-identity">
        <div class="job-identity-names">
          <%= @transcript.label %>
          <div class="subtitle">
            <%= @job.company %><%= " · #{@job.role}" if @job.role.present? %>
          </div>
        </div>
      </div>
    </div>

    <div class="app-card-body">
      <div class="app-card-inner" data-transcript-search>
        <div class="transcript-meta-row">
          <span><%= pluralize(@transcript.turns.size, "turn") %></span>
          <% if @transcript.spoken_minutes %>
            <span><%= @transcript.spoken_minutes %> minutes</span>
          <% end %>
          <% if @transcript.occurred_at %>
            <span><%= interview_day(@transcript.occurred_at) %></span>
          <% end %>
          <% if @transcript.file.attached? %>
            <%= link_to "the file as uploaded",
                  rails_blob_path(@transcript.file, disposition: "attachment") %>
          <% end %>
          <% if transcript_mended(@transcript) %>
            <span><%= transcript_mended(@transcript) %></span>
          <% end %>
          <%# Going over the words again costs the same calls to be told the
             same thing, so it is pressed rather than repeated - and it is
             worth pressing once the speakers have been corrected by hand,
             because who was talking is half of what places a word. %>
          <%= link_to "Check the words", tidy_interview_transcript_path(@job, @transcript),
                method: :post %>
          <%# Reading it back for how it went. Pressed rather than repeated for
             the same reason as the words - and worth pressing once the
             speakers are right, because a reading of how he did that does not
             know which half of the conversation is his is no reading at all. %>
          <%= link_to((@transcript.debriefed? ? "Read it again" : "How did I do"),
                debrief_interview_transcript_path(@job, @transcript), method: :post) %>
          <%= link_to "Delete", interview_transcript_path(@job, @transcript),
                method: :delete, class: "danger-link",
                data: { confirm: "Delete this transcript? The file goes with it." } %>
        </div>

        <%# While the pass is on it, the page says so. A transcript being read
           and one the pass could make nothing of look identical otherwise -
           both are a wall of turns with nobody on them - and the difference
           between them is the whole question of whether to wait or to start
           correcting it by hand. It reloads itself because what ends the wait
           is a worker finishing, which this page has no other way to hear. %>
        <% if @transcript.reading? || @transcript.tidying? || @transcript.debriefing? %>
          <% content_for :head do %>
            <meta http-equiv="refresh" content="8">
          <% end %>
        <% end %>

        <% if @transcript.reading? %>
          <p class="transcript-reading">
            <strong>Reading the recording.</strong>
            <%= transcript_reading(@transcript) %>
            This page refreshes itself.
          </p>
        <% end %>

        <%# The second pass, on the words themselves. Its own line rather than
           folded into the first: they run one after the other and take
           different lengths of time, and one line covering both would say the
           reading was still going while the words were being gone over. %>
        <% if @transcript.tidying? %>
          <p class="transcript-reading">
            <strong>Going back over the words.</strong>
            <%= transcript_tidying(@transcript) %>
            This page refreshes itself.
          </p>
        <% end %>

        <%# The third pass, on how it went. Last of the three because it reads
           what the other two leave behind. %>
        <% if @transcript.debriefing? %>
          <p class="transcript-reading">
            <strong>Reading it back.</strong>
            <%= transcript_debriefing(@transcript) %>
            This page refreshes itself.
          </p>
        <% end %>

        <%# HOW IT WENT, ABOVE THE CONVERSATION.
           The recording is the evidence and this is the thing he opened the
           page for, so it is not at the bottom of half an hour of talking.
           Open by default and collapsible: it is read once properly and then
           got out of the way to go back over the turns themselves.

           Every note that judges him carries the line it is about, quoted and
           linked. That is the whole difference between a debrief and an
           article about interviewing - a note he cannot trace back to
           something he said is one he has no way to check. %>
        <% if @transcript.debriefed? %>
          <details class="transcript-debrief" open>
            <summary>How it went</summary>

            <p class="db-read"><%= @transcript.debrief["read"] %></p>

            <% if @transcript.debrief["cost"].present? %>
              <h4 class="db-head">What cost me, and what to say instead</h4>
              <ol class="db-list db-cost">
                <% @transcript.debrief["cost"].each do |note| %>
                  <li class="db-note">
                    <%= link_to debrief_at(@transcript, note["turn"]),
                          debrief_anchor(note["turn"]), class: "db-at" %>
                    <blockquote class="db-quote">
                      <%= debrief_quote(@transcript, note["turn"]) %>
                    </blockquote>
                    <p class="db-why"><%= note["what"] %></p>
                    <% if note["instead"].present? %>
                      <p class="db-instead">
                        <span class="db-label">Say instead</span>
                        <%= note["instead"] %>
                      </p>
                    <% end %>
                  </li>
                <% end %>
              </ol>
            <% end %>

            <% if @transcript.debrief["missed"].present? %>
              <h4 class="db-head">What I never said</h4>
              <ul class="db-list db-missed">
                <% @transcript.debrief["missed"].each do |note| %>
                  <li class="db-note">
                    <p class="db-why"><%= note["what"] %></p>
                    <% if note["where"].present? %>
                      <p class="db-where"><%= note["where"] %></p>
                    <% end %>
                  </li>
                <% end %>
              </ul>
            <% end %>

            <% if @transcript.debrief["strongest"].present? %>
              <h4 class="db-head">What landed</h4>
              <ul class="db-list db-landed">
                <% @transcript.debrief["strongest"].each do |note| %>
                  <li class="db-note">
                    <%= link_to debrief_at(@transcript, note["turn"]),
                          debrief_anchor(note["turn"]), class: "db-at" %>
                    <blockquote class="db-quote">
                      <%= debrief_quote(@transcript, note["turn"]) %>
                    </blockquote>
                    <p class="db-why"><%= note["why"] %></p>
                  </li>
                <% end %>
              </ul>
            <% end %>

            <% if @transcript.debrief["next"].present? %>
              <h4 class="db-head">Next time</h4>
              <ul class="db-list db-next">
                <% @transcript.debrief["next"].each do |said| %>
                  <li><%= said %></li>
                <% end %>
              </ul>
            <% end %>
          </details>
        <% end %>

        <%# Nothing can be said about how he did until somebody is marked as
           him, so the page asks for that instead of offering a reading it
           would have to refuse. %>
        <% if !@transcript.debriefed? && !@transcript.debriefing? && !@transcript.placed_me? %>
          <p class="field-hint">
            Tick which speaker is you below and save, then ask how it went —
            reading the recording back means knowing which half of it is yours.
          </p>
        <% end %>

        <%# THE BOX IS NOT IN THE FORM. Everything below it is one submit, and a
           text input inside that form sends the whole page on Enter - which is
           the key anybody presses after typing what they were looking for. It
           filters the turns inside the form all the same: the card is what
           carries `data-transcript-search`, so the box and the turns are in
           one container without wrapping the form in another. %>
        <div class="transcript-search">
          <%= label_tag :transcript_query, "Find a line" %>
          <%= search_field_tag :transcript_query, nil, id: "transcript_query",
                placeholder: "testing, money, a name…", autocomplete: :off,
                data: { transcript_query: true } %>
          <span class="field-hint" data-transcript-count>
            <%= pluralize(@transcript.turns.size, "turn") %>
          </span>
        </div>

        <%= form_with url: interview_transcript_path(@job, @transcript), method: :patch,
              local: true, class: "transcript-form" do %>

          <%# Open until somebody has been named, because until then every
             bubble on the page is headed `Speaker 2` and the conversation
             cannot be followed. Once they have names it collapses out of the
             way — it is a thing you do once. %>
          <details class="job-details transcript-speakers"
                   <%= "open" if @transcript.speakers.blank? %>>
            <summary>Who was speaking</summary>
            <%# What is here when the page first opens was read off the words
               when the file landed: which side each voice is on, and any name
               the conversation actually said. It is a reading and it is
               sometimes wrong, so the form says what to do about that rather
               than presenting itself as the first step. %>
            <p class="field-hint">
              Who is who is read off the recording when it lands - and the recorder
              and the reading both get some of it wrong. Correct a name here, tick
              the one that is you, and fix any individual turn on the wrong person
              with the picker on the turn itself.
            </p>

            <ul class="speaker-rows">
              <% @transcript.labels.each do |label| %>
                <li class="speaker-row">
                  <span class="speaker-raw"><%= label %></span>
                  <%= text_field_tag "speakers[#{label}][name]",
                        @transcript.speakers.dig(label, "name"),
                        placeholder: "Who this was" %>
                  <label class="speaker-mine">
                    <%= hidden_field_tag "speakers[#{label}][me]", "0" %>
                    <%= check_box_tag "speakers[#{label}][me]", "1",
                          @transcript.mine?(label) %>
                    This is me
                  </label>
                  <span class="speaker-hint">
                    <%= pluralize(@transcript.turn_count(label), "turn") %> ·
                    “<%= @transcript.first_words(label) %>”
                  </span>
                </li>
              <% end %>
            </ul>
          </details>

          <ol class="transcript-turns">
            <% @transcript.turns.each_with_index do |turn, index| %>
              <li class="tt-turn <%= transcript_side(@transcript, turn) %>" data-turn
                  id="t<%= index + 1 %>">
                <div class="tt-head">
                  <span class="tt-name" data-turn-text>
                    <%= @transcript.name_for(turn["speaker"]) %>
                  </span>
                  <% if transcript_clock(turn["at"]) %>
                    <span class="tt-at"><%= transcript_clock(turn["at"]) %></span>
                  <% end %>
                  <%# Hidden until the turn is hovered or the picker is focused:
                     126 dropdowns down a page you are trying to READ is the
                     page unreadable. %>
                  <%= select_tag "turns[#{index}]",
                        options_for_select(
                          @transcript.speaker_options.map { |label|
                            [@transcript.name_for(label), label]
                          },
                          turn["speaker"],
                        ),
                        class: "tt-move", title: "Move this turn onto somebody else" %>
                </div>
                <%# A turn whose words were put right keeps what the recorder
                   wrote, because a fix made from context is sometimes the
                   wrong fix and the only way to see that is to read what it
                   replaced. %>
                <%= tag.p turn["text"],
                      class: ["tt-said", ("mended" if turn["heard"].present?)],
                      data: { turn_text: true },
                      title: heard_title(turn) %>
              </li>
            <% end %>
          </ol>

          <%# Pinned to the bottom of the viewport rather than sitting under
             half an hour of talking. It saves the names AND every turn moved
             onto somebody else, which is why it does not say "speakers" - it
             is in reach the whole way down, beside the pickers it also
             commits. %>
          <div class="transcript-save">
            <%= submit_tag "Save changes" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
