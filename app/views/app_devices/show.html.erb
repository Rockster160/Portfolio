<% content_for :title, @device.name %>
<div class="panel-app" data-buddy-device="<%= @device.id %>">
  <div class="panel-page" data-buddy-settings="<%= app_device_path(@device) %>">
    <header class="panel-topbar">
      <a class="panel-icon-btn" data-back href="<%= app_devices_path %>" aria-label="All devices">‹</a>
      <h1><%= @device.name %></h1>
    </header>

    <% detail = [@device.model, @device.os_version && "iOS #{@device.os_version}"] %>
    <% detail << (@device.app_version && "v#{@device.app_version}") %>
    <% if @device.revoked? %>
      <% detail << "Signed out" %>
    <% elsif @device.last_seen_at.present? %>
      <% detail << "Seen #{relative_time_in_words(@device.last_seen_at)}" %>
    <% end %>
    <p class="panel-hint"><%= detail.compact.join(" · ") %></p>

    <nav class="panel-settings panel-nav">
      <a class="panel-nav-row" href="<%= app_hot_links_path %>">Hot links</a>
      <a class="panel-nav-row buddy-app-this-device-only" href="<%= app_commands_path %>">Queue</a>
    </nav>

    <h2 class="panel-section-title">Features</h2>

    <% AppDevices::Features::ALL.each do |feature| %>
      <% permitted = @device.permitted?(feature.key) %>
      <div class="panel-settings" id="feature-<%= feature.key %>">
        <label class="panel-setting">
          <span class="panel-setting-text">
            <span class="panel-setting-title"><%= feature.title %></span><%= render "app_devices/info", label: feature.title, text: feature.info %>
            <% unless permitted %>
              <% if @device.permission(feature.key) == :denied %>
                <span class="panel-setting-sub" data-buddy-permission-note>Denied in iOS Settings</span>
              <% else %>
                <span class="panel-setting-sub buddy-app-elsewhere-device" data-buddy-permission-note>Allow in the app first</span>
              <% end %>
            <% end %>
          </span>
          <%= check_box_tag "features[]", feature.key, @device.feature?(feature.key),
            id: "feature-toggle-#{feature.key}", class: "panel-switch", disabled: !permitted %>
        </label>

        <% if !permitted && @device.permission(feature.key) != :denied %>
          <button type="button" class="panel-btn panel-btn-primary panel-btn-block buddy-app-this-device-only"
            data-buddy-allow="<%= feature.key %>">Allow</button>
        <% end %>

        <%# Shown before iOS answers, so Allow opens the options straight away. %>
        <div class="buddy-app-feature-options" data-buddy-options <%= "hidden" unless permitted %>>
          <% feature.options.each do |option| %>
            <% value = @device.preference(option.key) %>
            <% name = "preferences[#{option.key}]" %>
            <% case option.type %>
            <% when :boolean %>
              <label class="panel-setting">
                <span class="panel-setting-text"><%= option.label %><%= render "app_devices/info", label: option.label, text: option.info %></span>
                <%= check_box_tag name, true, value.to_s == "true", id: "preference-#{option.key}", class: "panel-switch" %>
              </label>
            <% when :select %>
              <div>
                <div class="panel-setting-label"><%= option.label %><%= render "app_devices/info", label: option.label, text: option.info %></div>
                <div class="panel-segmented">
                  <% option.choices.each do |key, text| %>
                    <label><%= radio_button_tag name, key, value.to_s == key.to_s, id: nil %><span><%= text %></span></label>
                  <% end %>
                </div>
              </div>
            <% when :number %>
              <div>
                <div class="panel-setting-label">
                  <%= label_tag "preference-#{option.key}", option.label %><%= render "app_devices/info", label: option.label, text: option.info %>
                </div>
                <%= number_field_tag name, value, min: option.minimum, max: option.maximum, step: option.step,
                  id: "preference-#{option.key}", inputmode: "numeric" %>
              </div>
            <% when :channels %>
              <div>
                <div class="panel-setting-label"><%= option.label %><%= render "app_devices/info", label: option.label, text: option.info %></div>
                <div class="panel-pills">
                  <% option.choices.each do |key, text| %>
                    <label>
                      <%= check_box_tag "#{name}[]", key, Array(value).map(&:to_s).include?(key.to_s), id: nil %>
                      <span><%= text %></span>
                    </label>
                  <% end %>
                </div>
              </div>
            <% when :sources %>
              <% sources = Array(@device.sources.to_h[option.source.to_s]) %>
              <div>
                <div class="panel-setting-label"><%= option.label %><%= render "app_devices/info", label: option.label, text: option.info %></div>
                <div class="panel-pills">
                  <% sources.each do |source| %>
                    <label>
                      <%= check_box_tag "#{name}[]", source["id"], Array(value).include?(source["id"]), id: nil %>
                      <span><span class="panel-dot" style="background: <%= source["color"] %>"></span><%= source["title"] %></span>
                    </label>
                  <% end %>
                </div>
              </div>
            <% end %>
          <% end %>

          <% if feature.tasks.any? || feature.tests.any? %>
            <div class="panel-buttons">
              <% feature.tasks.each do |task| %>
                <span class="panel-info-anchor">
                  <button type="button" class="panel-btn" data-buddy-post="<%= run_app_device_path(@device, task: task.key) %>"
                    data-buddy-task="<%= task.key %>"><%= task.label %></button><%= render "app_devices/info", label: task.label, text: task.info %>
                </span>
              <% end %>
              <% feature.tests.each do |check| %>
                <span class="panel-info-anchor">
                  <button type="button" class="panel-btn" data-buddy-post="<%= test_push_app_device_path(@device, kind: check.key) %>"><%= check.label %></button><%= render "app_devices/info", label: check.label, text: check.info %>
                </span>
              <% end %>
            </div>
          <% end %>
        </div>

        <% if feature.triggers.any? %>
          <details class="panel-advanced">
            <summary>Jil triggers</summary>
            <% feature.triggers.each do |trigger| %>
              <code class="panel-code"><%= trigger.example %></code>
              <p class="panel-hint"><%= trigger.summary %></p>
            <% end %>
          </details>
        <% end %>
      </div>
    <% end %>


    <% unless @device.revoked? %>
      <h2 class="panel-section-title">This device</h2>
      <%= link_to "Sign #{@device.name} out", app_device_path(@device),
        method: :delete,
        class:  "panel-btn panel-btn-danger panel-btn-block",
        data:   { confirm: "Sign #{@device.name} out of Buddy?" } %>
    <% end %>
  </div>
</div>
