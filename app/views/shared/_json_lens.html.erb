<%
  # JSON Lens — a virtualized, searchable, editable JSON viewer rendered as a
  # standalone document (these pages use `layout false`). Mounted by the Jil
  # cache editor and the Playground tool page.
  #
  #   data:       seed object (Hash/Array) or nil to start empty / drop-to-open
  #   save_url:   when set, edits auto-save via PUT to this URL
  #   save_key:   top-level key the root is wrapped under in the PUT body
  #   allow_open: show Open/Paste/Sample + drag-drop (the explorer entry)
  #   title:      document + header title
  data       = local_assigns.fetch(:data, nil)
  save_url   = local_assigns.fetch(:save_url, nil)
  save_key   = local_assigns.fetch(:save_key, "data")
  allow_open = local_assigns.fetch(:allow_open, data.nil?)
  page_title = local_assigns.fetch(:title, "JSON Lens")
%>
<!doctype html>
<html lang="en" dir="ltr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title><%= page_title %></title>
<% if data %>
<script id="jsonlens-seed" type="application/json"><%= raw ERB::Util.json_escape(data.to_json) %></script>
<% end %>
<style>
  :root{
    --bg:#f6f7f9; --panel:#ffffff; --panel-2:#eef1f4; --border:#d9dee4;
    --fg:#1b2128; --fg-dim:#687280; --accent:#0e8ba3; --accent-2:#0a6b7e;
    --hover:rgba(14,139,163,.08); --sel:rgba(14,139,163,.15);
    --danger:#c23b2e; --ok:#0a7d3f;
    --t-key:#2b6cb0; --t-string:#0a7d3f; --t-number:#b5370f;
    --t-bool:#7c3aed; --t-null:#8892a0; --t-punct:#9aa4b0; --t-meta:#8892a0;
    --mono:"IBM Plex Mono",ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
    --ui:"IBM Plex Sans",system-ui,-apple-system,Segoe UI,Roboto,sans-serif;
  }
  @media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
    --bg:#0f1419; --panel:#151b22; --panel-2:#1c242d; --border:#2a333d;
    --fg:#d7dde4; --fg-dim:#8a97a4; --accent:#39c2d8; --accent-2:#6fd6e6;
    --hover:rgba(57,194,216,.10); --sel:rgba(57,194,216,.16);
    --danger:#ef6a5e; --ok:#5ed49a;
    --t-key:#6cb6ff; --t-string:#5ed49a; --t-number:#ffa657;
    --t-bool:#c495f0; --t-null:#8a97a4; --t-punct:#6b7784; --t-meta:#7a8795;
    color-scheme:dark;
  }}
  :root[data-theme="dark"]{
    --bg:#0f1419; --panel:#151b22; --panel-2:#1c242d; --border:#2a333d;
    --fg:#d7dde4; --fg-dim:#8a97a4; --accent:#39c2d8; --accent-2:#6fd6e6;
    --hover:rgba(57,194,216,.10); --sel:rgba(57,194,216,.16);
    --danger:#ef6a5e; --ok:#5ed49a;
    --t-key:#6cb6ff; --t-string:#5ed49a; --t-number:#ffa657;
    --t-bool:#c495f0; --t-null:#8a97a4; --t-punct:#6b7784; --t-meta:#7a8795;
    color-scheme:dark;
  }

  html,body{height:100%}
  body{margin:0;background:var(--bg);color:var(--fg);font-family:var(--ui);
       font-size:13px;-webkit-font-smoothing:antialiased}
  *{box-sizing:border-box}
  button{font-family:inherit}
  /* id/class display rules below out-specify the UA [hidden] rule, so restate it */
  [hidden]{display:none!important}

  #app{height:100%;display:flex;flex-direction:column;overflow:hidden}

  header{display:flex;align-items:center;gap:10px;flex-wrap:wrap;
    padding:10px 14px;background:var(--panel);border-bottom:1px solid var(--border)}
  .brand{display:flex;align-items:baseline;gap:8px;margin-right:4px}
  .brand b{font-weight:600;letter-spacing:-.01em;font-size:15px}
  .brand span{color:var(--fg-dim);font-size:11px;letter-spacing:.04em;text-transform:uppercase}
  .spacer{flex:1 1 auto}

  .btn{appearance:none;border:1px solid var(--border);background:var(--panel-2);
    color:var(--fg);border-radius:7px;padding:6px 11px;font-size:12px;cursor:pointer;
    display:inline-flex;align-items:center;gap:6px;white-space:nowrap;transition:.12s}
  .btn:hover{border-color:var(--accent);color:var(--accent-2)}
  .btn.primary{background:var(--accent);border-color:var(--accent);color:#fff}
  .btn.primary:hover{background:var(--accent-2);color:#fff}
  .btn:focus-visible{outline:2px solid var(--accent);outline-offset:2px}

  .stats{display:flex;gap:14px;flex-wrap:wrap;align-items:center;
    font-size:11.5px;color:var(--fg-dim);min-width:0}
  .stats .fn{color:var(--fg);font-weight:600;max-width:260px;overflow:hidden;
    text-overflow:ellipsis;white-space:nowrap}
  .stats b{color:var(--fg);font-variant-numeric:tabular-nums}
  .badge{background:var(--panel-2);border:1px solid var(--border);border-radius:5px;
    padding:1px 7px;font-size:10.5px;letter-spacing:.03em;text-transform:uppercase;color:var(--fg-dim)}

  .savepill{display:inline-flex;align-items:center;gap:6px;font-size:11.5px;
    color:var(--fg-dim);border:1px solid var(--border);background:var(--panel-2);
    border-radius:999px;padding:3px 10px}
  .savepill .dot{width:7px;height:7px;border-radius:50%;background:var(--fg-dim)}
  .savepill.saved{color:var(--ok)} .savepill.saved .dot{background:var(--ok)}
  .savepill.dirty{color:var(--accent-2)} .savepill.dirty .dot{background:var(--accent)}
  .savepill.saving .dot{background:var(--accent);animation:pulse 1s ease-in-out infinite}
  .savepill.error{color:var(--danger)} .savepill.error .dot{background:var(--danger)}
  @keyframes pulse{50%{opacity:.3}}

  /* search */
  #searchbar{display:flex;align-items:center;gap:8px;padding:8px 14px;
    background:var(--panel);border-bottom:1px solid var(--border);position:relative;flex-wrap:wrap}
  .field{display:flex;align-items:center;gap:6px;background:var(--panel-2);
    border:1px solid var(--border);border-radius:7px;padding:4px 8px;flex:1 1 240px;min-width:0}
  .field:focus-within{border-color:var(--accent)}
  .field input{border:0;background:transparent;color:var(--fg);outline:0;
    font-size:13px;font-family:var(--mono);flex:1;min-width:0}
  .field input::placeholder{color:var(--fg-dim);font-family:var(--ui)}
  .field .ico{color:var(--fg-dim);font-size:12px}
  .searchmeta{font-size:11px;color:var(--fg-dim);white-space:nowrap}

  #results{position:absolute;left:14px;right:14px;top:calc(100% - 1px);z-index:30;
    background:var(--panel);border:1px solid var(--border);border-radius:0 0 9px 9px;
    box-shadow:0 14px 34px rgba(0,0,0,.22);max-height:46vh;overflow:auto}
  .res{display:flex;gap:10px;align-items:baseline;padding:6px 12px;cursor:pointer;
    border-bottom:1px solid var(--border);font-family:var(--mono);font-size:12px}
  .res:last-child{border-bottom:0}
  .res:hover{background:var(--hover)}
  .res .rpath{color:var(--accent-2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:55%;flex:0 0 auto}
  .res .rval{color:var(--fg-dim);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;flex:1;min-width:0}
  .res-head{display:flex;justify-content:space-between;padding:6px 12px;
    font-size:11px;color:var(--fg-dim);background:var(--panel-2);position:sticky;top:0}
  .res-head .x{cursor:pointer;color:var(--fg-dim)}
  .res-head .x:hover{color:var(--danger)}

  /* drop zone */
  #drop{flex:1;display:flex;align-items:center;justify-content:center;padding:24px}
  .dropcard{width:min(540px,100%);border:2px dashed var(--border);border-radius:16px;
    background:var(--panel);padding:38px 28px;text-align:center;transition:.15s}
  #drop.drag .dropcard{border-color:var(--accent);background:var(--hover)}
  .dropcard h1{font-size:20px;margin:0 0 6px;letter-spacing:-.02em;text-wrap:balance}
  .dropcard p{color:var(--fg-dim);margin:0 0 20px;line-height:1.5;text-wrap:balance}
  .dropcard .row2{display:flex;gap:10px;justify-content:center;flex-wrap:wrap}
  .feat{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;
    margin-top:26px;text-align:left}
  .feat div{background:var(--panel-2);border:1px solid var(--border);border-radius:9px;padding:10px 12px}
  .feat b{display:block;font-size:12px;margin-bottom:2px}
  .feat span{font-size:11px;color:var(--fg-dim);line-height:1.4}

  /* viewer + virtualized tree */
  #viewer{flex:1;display:flex;flex-direction:column;min-height:0}
  #tree{flex:1;overflow:auto;position:relative;background:var(--bg);
    font-family:var(--mono);outline:0}
  #tree:focus-visible{box-shadow:inset 0 0 0 2px var(--accent)}
  #spacer{position:relative;width:100%}
  #rows{position:absolute;top:0;left:0;min-width:100%}
  .row{height:24px;line-height:24px;white-space:nowrap;padding-right:16px;
    cursor:default;display:block;font-size:12.5px;position:relative}
  .row:hover{background:var(--hover)}
  .row.sel{background:var(--sel)}
  .caret{display:inline-block;width:14px;text-align:center;color:var(--fg-dim);
    cursor:pointer;-webkit-user-select:none;user-select:none}
  .caret.none{cursor:default;opacity:.25}
  .caret::before{content:"\25B6";font-size:8px;display:inline-block;transition:transform .1s;vertical-align:1px}
  .caret.open::before{transform:rotate(90deg)}
  .caret.none::before{content:"\2022";font-size:9px}
  .k{color:var(--t-key)}
  .k.idx{color:var(--t-meta)}
  .p{color:var(--t-punct)}
  .pn{color:var(--t-punct)}
  .meta{color:var(--t-meta);font-style:normal;padding:0 4px}
  .v.s{color:var(--t-string)}
  .v.n{color:var(--t-number)}
  .v.b{color:var(--t-bool)}
  .v.z{color:var(--t-null)}
  .trunc{color:var(--accent);cursor:pointer;background:var(--hover);
    border-radius:3px;padding:0 4px;margin:0 2px;font-style:normal}
  .trunc:hover{background:var(--accent);color:#fff}
  .row.exp .k{cursor:pointer}
  .row.exp .k:hover{text-decoration:underline}

  /* editing affordances */
  .rowtools{display:none;position:absolute;right:8px;top:0;height:24px;
    align-items:center;gap:3px;background:linear-gradient(90deg,transparent,var(--panel) 18%);padding-left:26px}
  .edit-on .row:hover .rowtools{display:inline-flex}
  .rowtools button{appearance:none;border:1px solid var(--border);background:var(--panel-2);
    color:var(--fg-dim);border-radius:4px;font-family:var(--mono);font-size:11px;
    line-height:1;padding:2px 6px;cursor:pointer;height:18px;min-width:20px}
  .rowtools button:hover{border-color:var(--accent);color:var(--accent-2)}
  .rowtools button.rm:hover{border-color:var(--danger);color:var(--danger)}
  .btn:disabled{opacity:.45;cursor:default}
  .btn:disabled:hover{border-color:var(--border);color:var(--fg)}
  .btn.primary:disabled:hover{background:var(--accent);color:#fff}

  /* status bar */
  #status{display:flex;align-items:center;gap:10px;flex-wrap:wrap;
    padding:7px 14px;background:var(--panel);border-top:1px solid var(--border);
    font-size:11.5px;min-height:38px}
  #status .path{font-family:var(--mono);color:var(--accent-2);overflow:hidden;
    text-overflow:ellipsis;white-space:nowrap;max-width:min(50vw,560px)}
  #status .typ{color:var(--fg-dim)}
  #status .mini{appearance:none;border:1px solid var(--border);background:var(--panel-2);
    color:var(--fg);border-radius:6px;padding:3px 8px;font-size:11px;cursor:pointer}
  #status .mini:hover{border-color:var(--accent);color:var(--accent-2)}
  #status .idxjump{display:flex;align-items:center;gap:5px}
  #status .idxjump input{width:84px;background:var(--panel-2);border:1px solid var(--border);
    color:var(--fg);border-radius:6px;padding:3px 6px;font-family:var(--mono);font-size:11px}
  #status .hint{color:var(--fg-dim)}

  /* busy indicator — subtle, in the header; never center-stage */
  #busy{display:inline-flex;align-items:center;gap:7px;font-size:11.5px;color:var(--fg-dim);
    border:1px solid var(--border);background:var(--panel-2);border-radius:999px;padding:3px 10px}
  #busy .spin{width:11px;height:11px;border:2px solid var(--border);border-top-color:var(--accent);
    border-radius:50%;animation:sp .7s linear infinite}
  @keyframes sp{to{transform:rotate(360deg)}}
  @media (prefers-reduced-motion:reduce){#busy .spin{animation-duration:2s}}

  /* value / raw-JSON editor — docked at the bottom of the layout, not a popup */
  #panel{display:flex;flex-direction:column;border-top:2px solid var(--accent);
    background:var(--panel);max-height:50%;min-height:170px}
  .phead{display:flex;align-items:center;gap:10px;padding:8px 14px;border-bottom:1px solid var(--border)}
  .phead .mtitle{font-family:var(--mono);font-size:12px;color:var(--accent-2);
    overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1;min-width:0}
  .phead .mtype{font-size:11px;color:var(--fg-dim);white-space:nowrap}
  .phead .mnote{font-size:11px;color:var(--fg-dim)}
  .phead .mnote.err{color:var(--danger)}
  .phead .grow{flex:1 1 auto}
  .pbody{padding:10px 14px 12px;overflow:auto;min-height:0;flex:1;display:flex;flex-direction:column}
  .pbody textarea{width:100%;flex:1;min-height:90px;resize:none;background:var(--panel-2);
    color:var(--fg);border:1px solid var(--border);border-radius:9px;padding:12px;
    font-family:var(--mono);font-size:12.5px;line-height:1.55;outline:0;white-space:pre}
  .pbody textarea:focus{border-color:var(--accent)}
  .pbody textarea[readonly]{opacity:.9}
  .prow{display:flex;align-items:center;gap:10px;margin-bottom:8px;flex-wrap:wrap}
  .prow .pkeyrow{display:inline-flex;align-items:center;gap:6px}
  .prow .lbl{font-size:11px;color:var(--fg-dim)}
  .prow input#pkey{flex:0 1 220px;background:var(--panel-2);border:1px solid var(--border);
    color:var(--fg);border-radius:7px;padding:5px 9px;font-family:var(--mono);font-size:12.5px;outline:0}
  .prow input#pkey:focus{border-color:var(--accent)}
  .prow .mnote{font-size:11px;color:var(--fg-dim)}
  .prow .mnote.err{color:var(--danger)}
  .seg{display:inline-flex;border:1px solid var(--border);border-radius:7px;overflow:hidden}
  .seg button{appearance:none;border:0;background:var(--panel-2);color:var(--fg-dim);
    font-family:var(--ui);font-size:11.5px;padding:4px 11px;cursor:pointer}
  .seg button + button{border-left:1px solid var(--border)}
  .seg button.on{background:var(--accent);color:#fff}

  #toast{position:fixed;bottom:56px;left:50%;transform:translateX(-50%);
    background:var(--fg);color:var(--bg);padding:8px 16px;border-radius:999px;
    font-size:12px;z-index:90;opacity:0;transition:opacity .18s;pointer-events:none;font-weight:500}
  #toast.show{opacity:1}
  .err{color:var(--danger)!important}
</style>
</head>
<body
  data-save-url="<%= save_url %>"
  data-save-key="<%= save_key %>"
  data-allow-open="<%= allow_open ? "1" : "" %>"
  data-has-seed="<%= data.nil? ? "" : "1" %>">

<div id="app">
  <header>
    <div class="brand"><b><%= page_title %></b><span>JSON</span></div>
    <% if allow_open %>
      <button class="btn primary" id="openBtn">Open file</button>
      <button class="btn" id="pasteBtn">Paste</button>
      <button class="btn" id="sampleBtn">Load sample</button>
    <% end %>
    <div class="spacer"></div>
    <span id="busy" hidden><span class="spin"></span><span class="busyword">Working</span></span>
    <span class="savepill" id="savepill" hidden><span class="dot"></span><span class="saveword">Saved</span></span>
    <button class="btn primary" id="saveBtn" hidden>Save</button>
    <button class="btn" id="copyAllBtn" hidden>Copy JSON</button>
    <button class="btn" id="downloadBtn" hidden>Download</button>
    <div class="stats" id="stats" hidden></div>
    <button class="btn" id="themeBtn" title="Toggle theme" hidden>&#9680;</button>
  </header>

  <div id="searchbar" hidden>
    <div class="field">
      <span class="ico">&#9906;</span>
      <input id="search" type="text" placeholder="Search keys and values&#8230;" autocomplete="off" spellcheck="false">
    </div>
    <span class="searchmeta" id="searchmeta"></span>
    <button class="btn" id="expandBtn">Expand all</button>
    <button class="btn" id="collapseBtn">Collapse</button>
    <div id="results" hidden></div>
  </div>

  <div id="drop"<%= raw(allow_open ? "" : " hidden") %>>
    <div class="dropcard">
      <h1>Drop a JSON file to explore it</h1>
      <p>Built for files that are too big for most viewers &mdash; millions of records,
         thousands of keys, or multi-megabyte values. Only what's on screen is ever rendered.</p>
      <div class="row2">
        <button class="btn primary" id="openBtn2">Choose file</button>
        <button class="btn" id="sampleBtn2">Load 100k-record sample</button>
        <button class="btn" id="newBtn">Start empty</button>
      </div>
      <div class="feat">
        <div><b>Many records</b><span>Virtualized tree &mdash; scroll through millions of rows with no lag.</span></div>
        <div><b>Many keys</b><span>Lazy expansion; a node's children materialize only when you open it.</span></div>
        <div><b>Huge values</b><span>Long strings preview truncated; open the full value in an inspector.</span></div>
        <div><b>Editable</b><span>Double-click any value or key to edit; add and remove entries inline.</span></div>
      </div>
    </div>
  </div>

  <div id="viewer" hidden>
    <div id="tree" tabindex="0"><div id="spacer"><div id="rows"></div></div></div>
    <div id="status"></div>
  </div>

  <div id="panel" hidden>
    <div class="phead">
      <span class="mtitle" id="mtitle"></span>
      <span class="mtype" id="mtype"></span>
      <span class="grow"></span>
      <button class="btn primary" id="msave" hidden>Apply</button>
      <button class="btn" id="mcopy">Copy</button>
      <button class="btn" id="mclose">Close</button>
    </div>
    <div class="pbody">
      <div class="prow">
        <span class="pkeyrow" id="pkeyrow" hidden><span class="lbl">key</span><input id="pkey" spellcheck="false" placeholder="key name"></span>
        <span class="seg" id="pmodes" hidden><button type="button" data-mode="add" class="on">Add</button><button type="button" data-mode="merge">Merge</button></span>
        <span class="seg" id="ptype"><button type="button" data-type="string">String</button><button type="button" data-type="number">Number</button><button type="button" data-type="boolean">Bool</button><button type="button" data-type="null">Null</button><button type="button" data-type="json" class="on">JSON</button></span>
        <span class="seg" id="pbool" hidden><button type="button" data-bool="true" class="on">true</button><button type="button" data-bool="false">false</button></span>
        <span class="grow"></span>
        <span class="mnote" id="mnote"></span>
      </div>
      <textarea id="mtext" readonly spellcheck="false"></textarea>
    </div>
  </div>
</div>

<div id="toast"></div>
<input type="file" id="file" accept=".json,.ndjson,.jsonl,.txt,application/json" hidden>

<script>
(function(){
  "use strict";
  var $ = function(id){ return document.getElementById(id); };
  var ROWH = 24, PREVIEW = 200, MAXM = 1000, EXPAND_CAP = 200000;

  var CFG = {
    saveUrl: document.body.dataset.saveUrl || null,
    saveKey: document.body.dataset.saveKey || "data",
    allowOpen: document.body.dataset.allowOpen === "1",
    hasSeed: document.body.dataset.hasSeed === "1"
  };

  // ---- state ----
  var rootData, rootMeta = {}, flat = [];
  var selectedIndex = -1, selRef = null;
  var expanded = new WeakSet();      // expansion keyed by object/array reference
  var keysCache = new WeakMap();     // cached Object.keys per object
  var countCache = new WeakMap();    // cached key count per object
  var searchStack = null, searchActive = false, searchMatches = [], searchQuery = "", searchTimer = null;
  var dirty = false, saveState = "clean";

  // ---- helpers ----
  function typeOf(v){
    if (v === null) return "null";
    if (Array.isArray(v)) return "array";
    var t = typeof v;
    return t === "object" ? "object" : t; // string | number | boolean | object | array | null
  }
  function keysOf(o){ var k = keysCache.get(o); if(!k){ k = Object.keys(o); keysCache.set(o,k);} return k; }
  function keyCount(o){ var n = countCache.get(o); if(n===undefined){ n = keysOf(o).length; countCache.set(o,n);} return n; }
  function invalidate(o){ keysCache.delete(o); countCache.delete(o); }
  var esc = function(s){ return s.replace(/[&<>]/g, function(c){ return ({"&":"&amp;","<":"&lt;",">":"&gt;"})[c]; }); };
  function fmtBytes(n){ if(n<1024) return n+" B"; if(n<1048576) return (n/1024).toFixed(1)+" KB";
    if(n<1073741824) return (n/1048576).toFixed(1)+" MB"; return (n/1073741824).toFixed(2)+" GB"; }
  var fmtNum = function(n){ return n.toLocaleString(); };

  // ---- loading / parsing ----
  function showOverlay(t){ $("busy").querySelector(".busyword").textContent = t; $("busy").hidden = false; }
  function hideOverlay(){ $("busy").hidden = true; }

  function readFile(f){
    showOverlay("Reading "+fmtBytes(f.size)+"…");
    (f.text ? f.text() : new Promise(function(res,rej){ var r=new FileReader(); r.onload=function(){res(r.result);}; r.onerror=function(){rej(r.error);}; r.readAsText(f); }))
      .then(function(txt){ loadText(txt, f.name); })
      .catch(function(err){ hideOverlay(); showError("Couldn't read the file — "+((err && err.message) || err)+". It may be larger than the browser can hold in memory."); });
  }

  function tryNDJSON(text){
    var lines = text.split("\n");
    var out = [];
    for (var i=0;i<lines.length;i++){
      var ln = lines[i].trim();
      if (!ln) continue;
      try { out.push(JSON.parse(ln)); } catch(e){ return null; }
    }
    return out.length ? out : null;
  }

  // ---- lenient parsing: strict JSON, then Ruby-hash / unquoted-key / JSONL ----
  // Transpile a relaxed object literal into strict JSON without touching string
  // contents: hashrockets (=>), Ruby symbols (:sym), unquoted keys, single
  // quotes, nil, # and // comments, trailing commas, and 1_000 numbers.
  function relaxedToJson(src){
    var out = "", i = 0, n = src.length;
    function prevSig(){ for (var j=out.length-1;j>=0;j--){ var c=out[j]; if(c!==" "&&c!=="\n"&&c!=="\t"&&c!=="\r") return c; } return ""; }
    while (i < n){
      var ch = src[i];
      if (ch===" "||ch==="\t"||ch==="\n"||ch==="\r"){ out+=ch; i++; continue; }
      if (ch==="#"){ while(i<n && src[i]!=="\n") i++; continue; }
      if (ch==="/" && src[i+1]==="/"){ while(i<n && src[i]!=="\n") i++; continue; }
      if (ch==="/" && src[i+1]==="*"){ i+=2; while(i<n && !(src[i]==="*"&&src[i+1]==="/")) i++; i+=2; continue; }
      if (ch==='"' || ch==="'"){
        var quote=ch; i++; var body="";
        while(i<n){ var c=src[i];
          if(c==="\\"){ body+=c+(src[i+1]||""); i+=2; continue; }
          if(c===quote){ i++; break; }
          body+=c; i++;
        }
        var val;
        if (quote==='"'){ try { val = JSON.parse('"'+body+'"'); } catch(e){ val = body; } }
        else { val = body.replace(/\\\\/g,"\u0000").replace(/\\'/g,"'").replace(/\u0000/g,"\\"); }
        out += JSON.stringify(val);
        continue;
      }
      if (ch==="=" && src[i+1]===">"){ out+=":"; i+=2; continue; }
      if (ch===":"){
        var p = prevSig();
        if ((p===""||p==="{"||p==="["||p===","||p===":") && /[A-Za-z_]/.test(src[i+1]||"")){
          i++; var id=""; while(i<n && /[A-Za-z0-9_]/.test(src[i])){ id+=src[i]; i++; }
          out += JSON.stringify(id); continue;
        }
        out+=":"; i++; continue;
      }
      if (/[A-Za-z_$]/.test(ch)){
        var word=""; while(i<n && /[A-Za-z0-9_$]/.test(src[i])){ word+=src[i]; i++; }
        if (word==="true"||word==="false") out+=word;
        else if (word==="null"||word==="nil") out+="null";
        else out += JSON.stringify(word);
        continue;
      }
      if (/[0-9.+\-]/.test(ch)){
        var num=""; while(i<n && /[0-9eExXa-fA-F.+\-_]/.test(src[i])){ num+=src[i]; i++; }
        out += num.replace(/_/g,""); continue;
      }
      if (ch==="}" || ch==="]"){
        var k=out.length-1; while(k>=0 && /\s/.test(out[k])) k--;
        if (out[k]===",") out = out.slice(0,k)+out.slice(k+1);
        out+=ch; i++; continue;
      }
      out += ch; i++;
    }
    return out;
  }

  // Parse JSON, or Ruby-hash/unquoted-key syntax, or JSONL (one value per line).
  function relaxedParse(text){
    try { return JSON.parse(text); } catch(e){}
    try { return JSON.parse(relaxedToJson(text)); } catch(e){}
    var lines = text.split("\n"), out = [], any = false;
    for (var i=0;i<lines.length;i++){
      var ln = lines[i].trim();
      if (!ln) continue;
      var v;
      try { v = JSON.parse(ln); }
      catch(e1){ try { v = JSON.parse(relaxedToJson(ln)); } catch(e2){ throw new SyntaxError("Not valid JSON, JSONL, or Ruby hash syntax"); } }
      out.push(v); any = true;
    }
    if (any) return out;
    throw new SyntaxError("Empty or unparseable input");
  }

  function loadText(text, name){
    showOverlay("Parsing "+fmtBytes(text.length)+"…");
    setTimeout(function(){
      var data, mode = "json";
      var t0 = performance.now();
      try {
        data = JSON.parse(text);
      } catch(e){
        var nd = tryNDJSON(text);
        if (nd){ data = nd; mode = "ndjson"; }
        else {
          try { data = relaxedParse(text); } // Ruby hash / unquoted keys / relaxed JSONL
          catch(e2){ hideOverlay(); showError("Couldn't parse this as JSON, JSONL, or a Ruby hash — "+e.message); return; }
        }
      }
      var dt = performance.now() - t0;
      try {
        initData(data, name || "pasted.json", text.length, dt, mode);
      } catch(e){
        hideOverlay(); showError("Parsed, but failed to build the view — "+e.message);
        return;
      }
      hideOverlay();
    }, 30);
  }

  function initData(data, name, bytes, parseMs, mode){
    rootData = data;
    rootMeta = { name: name, bytes: bytes, parseMs: parseMs, mode: mode };
    selectedIndex = -1; selRef = null;
    clearSearch();
    if (typeOf(data) === "object" || typeOf(data) === "array") expanded.add(data); // auto-open root
    buildFlat();
    $("tree").scrollTop = 0;
    $("drop").hidden = true;
    $("viewer").hidden = false;
    $("searchbar").hidden = false;
    $("stats").hidden = false;
    $("themeBtn").hidden = false;
    if (!CFG.saveUrl){ $("copyAllBtn").hidden = false; $("downloadBtn").hidden = false; }
    setSaveState("clean");
    renderStats();
    updateStatus();
    $("tree").focus();
  }

  function renderStats(){
    var t = typeOf(rootData);
    var shape = t;
    if (t === "array") shape = fmtNum(rootData.length)+" records";
    else if (t === "object") shape = fmtNum(keyCount(rootData))+" keys";
    $("stats").innerHTML =
      '<span class="fn" title="'+esc(rootMeta.name)+'">'+esc(rootMeta.name)+'</span>'+
      (rootMeta.mode==="ndjson"?'<span class="badge">NDJSON</span>':'')+
      (rootMeta.bytes?'<span>'+fmtBytes(rootMeta.bytes)+'</span>':'')+
      '<span><b>'+esc(shape)+'</b></span>'+
      (rootMeta.parseMs?'<span>parsed in <b>'+Math.round(rootMeta.parseMs)+'</b> ms</span>':'')+
      '<span>'+fmtNum(flat.length)+' rows visible</span>';
  }

  function showError(msg){
    $("drop").hidden = false; $("viewer").hidden = true; $("searchbar").hidden = true; $("stats").hidden = true;
    var card = document.querySelector(".dropcard");
    var e = document.getElementById("derr");
    if (!e){ e = document.createElement("p"); e.id = "derr"; e.style.marginTop="14px"; card.appendChild(e); }
    e.className = "err"; e.textContent = msg;
  }

  // ---- flatten visible tree (only expanded branches) ----
  function buildFlat(){
    flat = [];
    if (rootData === undefined) { render(); return; }
    try { walk(rootData, null, false, 0, null); }
    catch(e){ showError("This structure is nested too deeply to flatten — "+e.message); return; }
    if (selRef){
      selectedIndex = findSelected(selRef);
      if (selectedIndex < 0) selRef = null;
    }
    renderStats();
    render();
  }
  function walk(value, key, keyIsIndex, depth, parent){
    var t = typeOf(value);
    var expandable = (t === "object" || t === "array");
    flat.push({ value: value, key: key, keyIsIndex: keyIsIndex, depth: depth, type: t, expandable: expandable, parent: parent });
    if (expandable && expanded.has(value)){
      if (t === "array"){
        for (var i=0;i<value.length;i++) walk(value[i], i, true, depth+1, value);
      } else {
        var ks = keysOf(value);
        for (var j=0;j<ks.length;j++) walk(value[ks[j]], ks[j], false, depth+1, value);
      }
    }
  }
  function findSelected(ref){
    for (var i=0;i<flat.length;i++){
      if (flat[i].value === ref.value && flat[i].depth === ref.depth && flat[i].key === ref.key) return i;
    }
    return -1;
  }

  // ---- windowed render ----
  var tree = $("tree"), spacer = $("spacer"), rowsEl = $("rows");
  var rafPending = false;
  function scheduleRender(){ if(rafPending) return; rafPending = true; requestAnimationFrame(function(){ rafPending=false; render(); }); }

  function render(){
    var total = flat.length;
    spacer.style.height = (total * ROWH) + "px";
    var scrollTop = tree.scrollTop, h = tree.clientHeight;
    var start = Math.max(0, Math.floor(scrollTop / ROWH) - 8);
    var end = Math.min(total, Math.ceil((scrollTop + h) / ROWH) + 8);
    var html = "";
    for (var i=start;i<end;i++) html += rowHtml(flat[i], i);
    rowsEl.innerHTML = html;
    rowsEl.style.transform = "translateY(" + (start * ROWH) + "px)";
  }

  function rowHtml(r, i){
    var pad = 8 + r.depth * 16;
    var caret = r.expandable
      ? '<span class="caret '+(expanded.has(r.value)?'open':'')+'" data-act="toggle"></span>'
      : '<span class="caret none"></span>';
    var keyHtml = "";
    if (r.key !== null){
      keyHtml = r.keyIsIndex
        ? '<span class="k idx">'+r.key+'</span>'
        : '<span class="k">'+esc(String(r.key))+'</span>';
      keyHtml += '<span class="p">: </span>';
    }
    var tools = EDIT ? rowTools(r) : "";
    return '<div class="row'+(r.expandable?' exp':'')+(i===selectedIndex?' sel':'')+'" data-i="'+i+'" style="padding-left:'+pad+'px">'
      + caret + keyHtml + valuePreview(r) + tools + '</div>';
  }

  function rowTools(r){
    var t = '<span class="rowtools">';
    if (r.type === "array" || r.type === "object") t += '<button data-act="add" title="Add entry">+</button>';
    t += '<button data-act="editbtn" title="Edit value">✎</button>';
    if (r.depth >= 1) t += '<button class="rm" data-act="remove" title="Remove">×</button>';
    t += '</span>';
    return t;
  }

  function valuePreview(r){
    var v = r.value, t = r.type;
    if (t === "array"){ var n = v.length;
      return '<span class="pn">[</span><span class="meta">'+fmtNum(n)+' '+(n===1?'item':'items')+'</span><span class="pn">]</span>'; }
    if (t === "object"){ var m = keyCount(v);
      return '<span class="pn">{</span><span class="meta">'+fmtNum(m)+' '+(m===1?'key':'keys')+'</span><span class="pn">}</span>'; }
    if (t === "string"){
      var long = v.length > PREVIEW;
      var disp = (long ? v.slice(0, PREVIEW) : v).replace(/\n/g,"↵").replace(/\t/g,"⇥");
      var out = '<span class="v s">"'+esc(disp);
      if (long) out += '"<span class="trunc" data-act="big">+'+fmtNum(v.length - PREVIEW)+' chars →</span>';
      else out += '"';
      out += '</span>';
      return out;
    }
    if (t === "number") return '<span class="v n">'+esc(String(v))+'</span>';
    if (t === "boolean") return '<span class="v b">'+v+'</span>';
    return '<span class="v z">null</span>';
  }

  // ---- path / selection ----
  function pathKeysOf(i){
    var keys = [];
    var want = flat[i].depth;
    for (var j=i; j>=0 && want>=1; j--){
      if (flat[j].depth === want){ keys.push(flat[j].key); want--; }
    }
    keys.reverse();
    return keys;
  }
  function pathStr(keys){
    var s = "$";
    for (var x=0;x<keys.length;x++){
      var k = keys[x];
      if (typeof k === "number") s += "["+k+"]";
      else if (/^[A-Za-z_$][\w$]*$/.test(k)) s += "."+k;
      else s += "["+JSON.stringify(k)+"]";
    }
    return s;
  }

  function selectRow(i){
    selectedIndex = i;
    selRef = i>=0 ? { value: flat[i].value, depth: flat[i].depth, key: flat[i].key } : null;
    render();
    updateStatus();
  }

  function updateStatus(){
    var st = $("status");
    if (selectedIndex < 0 || !flat[selectedIndex]){
      st.innerHTML = '<span class="hint">'+(EDIT
        ? 'Double-click or the ✎ pencil to edit · + to add an entry · × to remove'
        : 'Click a node to inspect it · click the arrow on a long value to see it in full')+'</span>';
      return;
    }
    var r = flat[selectedIndex];
    var path = pathStr(pathKeysOf(selectedIndex));
    var typ = r.type;
    if (r.type === "array") typ = "array · "+fmtNum(r.value.length)+" items";
    else if (r.type === "object") typ = "object · "+fmtNum(keyCount(r.value))+" keys";
    else if (r.type === "string") typ = "string · "+fmtNum(r.value.length)+" chars";
    var jump = "";
    if (r.type === "array" && r.value.length){
      jump = '<span class="idxjump"><span class="typ">go to index</span>'
        + '<input id="idxInput" type="number" min="0" max="'+(r.value.length-1)+'" placeholder="0">'
        + '<button class="mini" id="idxGo">Go</button></span>';
    }
    st.innerHTML =
      '<span class="path" title="'+esc(path)+'">'+esc(path)+'</span>'+
      '<span class="typ">'+esc(typ)+'</span>'+
      '<button class="mini" id="copyPath">Copy path</button>'+
      '<button class="mini" id="copyVal">Copy value</button>'+
      (EDIT ? '<button class="mini" id="editSel">Edit</button>' : '')+
      (EDIT && (r.type==="object"||r.type==="array") ? '<button class="mini" id="addSel">Add entry</button>' : '')+
      jump;
    $("copyPath").onclick = function(){ copyText(path, "Path copied"); };
    $("copyVal").onclick = function(){ copySelectedValue(r); };
    var es = $("editSel"); if (es) es.onclick = function(){ openEdit(selectedIndex); };
    var as = $("addSel"); if (as) as.onclick = function(){ openAdd(selectedIndex); };
    var go = $("idxGo");
    if (go){
      var run = function(){ goToIndex(selectedIndex, parseInt($("idxInput").value, 10)); };
      go.onclick = run;
      $("idxInput").onkeydown = function(e){ if (e.key === "Enter") run(); };
    }
  }

  function copySelectedValue(r){
    if (r.type === "string"){ copyText(r.value, "Value copied ("+fmtNum(r.value.length)+" chars)"); return; }
    if (r.type === "object" || r.type === "array"){
      var n = r.type === "array" ? r.value.length : keyCount(r.value);
      if (n > 50000){ toast("Too large to serialize safely ("+fmtNum(n)+" entries)"); return; }
    }
    try { copyText(JSON.stringify(r.value, null, 2), "Value copied"); }
    catch(e){ toast("Couldn't serialize this value"); }
  }

  // ---- toggle expand ----
  function toggle(i){
    var r = flat[i];
    if (!r.expandable) return;
    var keepTop = tree.scrollTop;
    if (expanded.has(r.value)) expanded.delete(r.value);
    else expanded.add(r.value);
    buildFlat();
    tree.scrollTop = keepTop;
    render();
  }

  function goToIndex(arrFlatIdx, n){
    var r = flat[arrFlatIdx];
    if (!r || r.type !== "array") return;
    if (isNaN(n) || n < 0 || n >= r.value.length){ toast("Index out of range"); return; }
    if (!expanded.has(r.value)){ expanded.add(r.value); buildFlat(); }
    var pd = flat[arrFlatIdx].depth;
    var seen = -1, target = -1;
    for (var j=arrFlatIdx+1; j<flat.length; j++){
      if (flat[j].depth <= pd) break;
      if (flat[j].depth === pd+1){ seen++; if (seen === n){ target = j; break; } }
    }
    if (target >= 0){ scrollToIndex(target); selectRow(target); }
  }

  function scrollToIndex(i){
    var mid = i*ROWH - tree.clientHeight/2 + ROWH/2;
    tree.scrollTop = Math.max(0, Math.min(mid, flat.length*ROWH - tree.clientHeight));
    render();
  }

  // ---- expand all / collapse ----
  function expandAll(){
    showOverlay("Expanding…");
    setTimeout(function(){
      var count = 0, capped = false;
      var stk = [rootData];
      while (stk.length){
        var v = stk.pop(), t = typeOf(v);
        if (t === "object" || t === "array"){
          expanded.add(v); count++;
          if (count >= EXPAND_CAP){ capped = true; break; }
          if (t === "array"){ for (var i=0;i<v.length;i++) stk.push(v[i]); }
          else { var ks = keysOf(v); for (var j=0;j<ks.length;j++) stk.push(v[ks[j]]); }
        }
      }
      buildFlat();
      hideOverlay();
      if (capped) toast("Expanded "+fmtNum(EXPAND_CAP)+" nodes (cap reached)");
    }, 20);
  }
  function collapseAll(){
    for (var x=0;x<flat.length;x++){ if (flat[x].expandable) expanded.delete(flat[x].value); }
    var t = typeOf(rootData);
    if (t === "object" || t === "array") expanded.add(rootData);
    buildFlat();
    tree.scrollTop = 0;
    selectRow(-1);
  }

  // ======================================================================
  // EDITING
  // ======================================================================
  var EDIT = true; // editing is always available; explorer & cache both edit

  // ---- dirty tracking + manual save (no auto-save) ----
  function markDirty(){
    dirty = true;
    setSaveState("dirty");
  }
  function setSaveState(s){
    saveState = s;
    var pill = $("savepill"), btn = $("saveBtn");
    if (!CFG.saveUrl){ pill.hidden = true; if (btn) btn.hidden = true; return; }
    pill.hidden = false;
    pill.className = "savepill " + (s === "clean" ? "saved" : s);
    pill.querySelector(".saveword").textContent =
      s === "saving" ? "Saving…" : s === "dirty" ? "Unsaved changes" : s === "error" ? "Save failed" : "Saved";
    if (btn){ btn.hidden = false; btn.disabled = (s === "clean" || s === "saving"); }
  }
  function save(){
    if (!CFG.saveUrl || !dirty) return;
    setSaveState("saving");
    var body = {};
    body[CFG.saveKey] = rootData;
    fetch(CFG.saveUrl, {
      method: "PUT",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(body)
    }).then(function(res){
      if (res.ok){ dirty = false; setSaveState("clean"); toast("Saved"); }
      else { setSaveState("error"); toast("Save failed ("+res.status+")"); }
    }).catch(function(){ setSaveState("error"); toast("Save failed — network error"); });
  }

  // ---- data mutation (by reference), then rebuild ----
  function removeChild(parent, key){
    if (parent == null){ rootData = null; }
    else if (Array.isArray(parent)){ parent.splice(key, 1); invalidate(parent); }
    else { delete parent[key]; invalidate(parent); }
    markDirty();
  }
  function renameKey(parent, oldKey, newKey){
    if (parent == null || Array.isArray(parent)) return true;
    if (newKey === oldKey) return true;
    if (Object.prototype.hasOwnProperty.call(parent, newKey)){ return false; }
    var rebuilt = {};
    keysOf(parent).forEach(function(k){ rebuilt[k === oldKey ? newKey : k] = parent[k]; });
    Object.keys(parent).forEach(function(k){ delete parent[k]; });
    Object.keys(rebuilt).forEach(function(k){ parent[k] = rebuilt[k]; });
    invalidate(parent);
    return true;
  }

  // ---- docked editor panel (edit a node, or add to a container) ----
  var panelCtx = null;  // { action:"edit"|"add"|"paste", ref, i }
  var panelType = "json"; // string | number | boolean | null | json
  var panelMode = "add";  // add | merge
  var panelBool = true;

  function setType(t){
    panelType = t;
    Array.prototype.forEach.call($("ptype").querySelectorAll("button"), function(b){ b.classList.toggle("on", b.dataset.type === t); });
    $("pbool").hidden = (t !== "boolean");
    $("mtext").hidden = (t === "boolean" || t === "null"); // these carry no typed-in text
  }
  function setBool(v){
    panelBool = !!v;
    Array.prototype.forEach.call($("pbool").querySelectorAll("button"), function(b){ b.classList.toggle("on", (b.dataset.bool === "true") === panelBool); });
  }
  function setMode(m){
    panelMode = m;
    Array.prototype.forEach.call($("pmodes").querySelectorAll("button"), function(b){ b.classList.toggle("on", b.dataset.mode === m); });
    // Merge takes a JSON object/array and ignores the key field + type picker
    $("pkeyrow").hidden = (m === "merge") || panelCtx == null || panelCtx.target !== "object";
    $("ptype").hidden = (m === "merge");
    if (m === "merge") setType("json");
  }
  function panelNote(msg, isErr){ var n = $("mnote"); n.className = "mnote" + (isErr ? " err" : ""); n.textContent = msg || ""; }

  // read the editor value according to the selected type
  function readPanelValue(){
    var raw = $("mtext").value;
    switch (panelType){
      case "string": return { ok: true, value: raw };
      case "number": {
        if (raw.trim() === "") return { ok: false, error: "enter a number" };
        var n = Number(raw);
        return isNaN(n) ? { ok: false, error: "not a number: " + raw } : { ok: true, value: n };
      }
      case "boolean": return { ok: true, value: panelBool };
      case "null": return { ok: true, value: null };
      default: // json — accepts strict JSON, Ruby hashes, unquoted keys, JSONL
        try { return { ok: true, value: relaxedParse(raw) }; }
        catch (e){ return { ok: false, error: e.message }; }
    }
  }

  function openEdit(i){
    var r = flat[i], t = r.type;
    panelCtx = { action: "edit", ref: r, i: i, keyed: (r.parent != null && !Array.isArray(r.parent) && r.key !== null) };
    $("mtitle").textContent = pathStr(pathKeysOf(i));
    $("mtype").textContent = t + (t === "string" ? " · " + fmtNum(r.value.length) + " chars" : "");
    $("pmodes").hidden = true;
    $("ptype").hidden = false;
    $("pkeyrow").hidden = !panelCtx.keyed;
    $("pkey").value = panelCtx.keyed ? String(r.key) : "";
    var text = "", tooBig = false;
    if (t === "string"){ setType("string"); text = r.value; }
    else if (t === "number"){ setType("number"); text = String(r.value); }
    else if (t === "boolean"){ setBool(r.value); setType("boolean"); }
    else if (t === "null"){ setType("null"); }
    else { // object / array
      setType("json");
      var cnt = t === "array" ? r.value.length : keyCount(r.value);
      if (cnt > 50000){ tooBig = true; text = "(" + fmtNum(cnt) + " entries — too large to edit as raw JSON; edit its children instead)"; }
      else { try { text = JSON.stringify(r.value, null, 2); } catch(e){ tooBig = true; text = "(could not serialize this subtree)"; } }
    }
    $("mtext").value = text;
    $("mtext").readOnly = tooBig;
    $("ptype").hidden = tooBig;
    $("msave").hidden = tooBig;
    panelNote(tooBig ? "" : "Pick a type, then set the value. Use ⌘/Ctrl-Enter to apply.");
    resetPanelButtons();
    $("panel").hidden = false;
    if (!$("mtext").hidden && !tooBig) $("mtext").focus();
  }

  function openAdd(i){
    var r = flat[i];
    if (r.type !== "object" && r.type !== "array") return;
    panelCtx = { action: "add", ref: r, i: i, target: r.type };
    $("mtitle").textContent = "Add to " + pathStr(pathKeysOf(i));
    $("mtype").textContent = r.type;
    $("pmodes").hidden = false;
    setMode("add");        // shows the type picker, sets the key-row visibility
    $("pkey").value = "";
    setType("json");       // default; switch to String / Number / Bool / Null as needed
    setBool(true);
    $("mtext").value = "";
    $("mtext").readOnly = false;
    panelNote("Pick a type and enter the value. Merge folds a JSON object/array into this level.");
    $("msave").hidden = false;
    resetPanelButtons();
    $("panel").hidden = false;
    (panelCtx.target === "object" ? $("pkey") : $("mtext")).focus();
  }

  function savePanel(){
    if (!panelCtx) return;
    var r = panelCtx.ref;

    if (panelCtx.action === "edit"){
      var got = readPanelValue();
      if (!got.ok){ panelNote("Invalid JSON — " + got.error, true); return; }
      var key = r.key;
      if (panelCtx.keyed){
        var nk = $("pkey").value;
        if (nk.trim() === ""){ panelNote("Key can't be empty", true); return; }
        if (nk !== r.key && !renameKey(r.parent, r.key, nk)){ panelNote("A key named \"" + nk + "\" already exists", true); return; }
        key = nk;
      }
      if (r.parent == null) rootData = got.value;
      else { r.parent[key] = got.value; invalidate(r.parent); }
      markDirty();
    } else { // add
      var target = r.value;
      if (panelMode === "merge"){
        var m = readPanelValue(); // merge always JSON (setMode forces it)
        if (!m.ok){ panelNote("Invalid JSON — " + m.error, true); return; }
        if (Array.isArray(target)){
          if (Array.isArray(m.value)) m.value.forEach(function(x){ target.push(x); });
          else target.push(m.value);
        } else {
          if (m.value && typeof m.value === "object" && !Array.isArray(m.value)) Object.assign(target, m.value);
          else { panelNote("Merge into an object needs a JSON object", true); return; }
        }
      } else { // add one entry
        var av = readPanelValue();
        if (!av.ok){ panelNote("Invalid JSON — " + av.error, true); return; }
        if (Array.isArray(target)){ target.push(av.value); }
        else {
          var k = $("pkey").value;
          if (k.trim() === ""){ panelNote("Key can't be empty", true); return; }
          if (Object.prototype.hasOwnProperty.call(target, k)){ panelNote("A key named \"" + k + "\" already exists", true); return; }
          target[k] = av.value;
        }
      }
      invalidate(target);
      if (!expanded.has(target)) expanded.add(target);
      markDirty();
    }
    buildFlat();
    closeModal();
  }
  function closeModal(){ $("panel").hidden = true; panelCtx = null; }

  // ---- search (time-sliced, cancellable, ref-chained) ----
  function clearSearch(){
    searchActive = false; if (searchTimer){ clearTimeout(searchTimer); searchTimer = null; }
    searchStack = null; searchMatches = []; searchQuery = "";
    $("results").hidden = true; $("results").innerHTML = ""; $("searchmeta").textContent = "";
  }
  function startSearch(q){
    clearSearch();
    q = q.trim().toLowerCase();
    if (!q) return;
    searchQuery = q;
    searchStack = [{ value: rootData, key: null, parent: null }];
    searchActive = true;
    searchStep();
  }
  function searchStep(){
    if (!searchActive) return;
    var budget = performance.now() + 12;
    while (searchStack.length && performance.now() < budget && searchMatches.length < MAXM){
      var node = searchStack.pop();
      var v = node.value, k = node.key, t = typeOf(v);
      var hit = false;
      if (k !== null && typeof k === "string" && k.toLowerCase().indexOf(searchQuery) >= 0) hit = true;
      if (!hit && t !== "object" && t !== "array"){
        if (String(v).toLowerCase().indexOf(searchQuery) >= 0) hit = true;
      }
      if (hit) searchMatches.push(node);
      if (t === "array"){ for (var i=v.length-1;i>=0;i--) searchStack.push({ value:v[i], key:i, parent:node }); }
      else if (t === "object"){ var ks = keysOf(v); for (var j=ks.length-1;j>=0;j--) searchStack.push({ value:v[ks[j]], key:ks[j], parent:node }); }
    }
    renderResults();
    if (searchStack.length && searchMatches.length < MAXM){
      $("searchmeta").textContent = fmtNum(searchMatches.length)+" found · searching…";
      searchTimer = setTimeout(searchStep, 0);
    } else {
      searchActive = false;
      $("searchmeta").textContent = fmtNum(searchMatches.length)+(searchMatches.length>=MAXM?"+ matches (showing first "+fmtNum(MAXM)+")":" matches");
    }
  }
  function nodeKeys(node){ var keys=[]; var n=node; while(n && n.key!==null){ keys.push(n.key); n=n.parent; } keys.reverse(); return keys; }
  function renderResults(){
    var box = $("results");
    if (!searchMatches.length){ box.hidden = !searchActive && !searchQuery; box.innerHTML = searchActive? '' : '<div class="res-head"><span>No matches</span><span class="x" id="resX">✕</span></div>'; wireResX(); return; }
    var html = '<div class="res-head"><span>'+fmtNum(searchMatches.length)+' result'+(searchMatches.length===1?'':'s')+'</span><span class="x" id="resX">✕ close</span></div>';
    var show = Math.min(searchMatches.length, 300);
    for (var i=0;i<show;i++){
      var node = searchMatches[i];
      var ps = pathStr(nodeKeys(node));
      var t = typeOf(node.value);
      var prev;
      if (t === "string"){ prev = '"'+node.value.slice(0,80).replace(/\n/g,"↵")+(node.value.length>80?'…':'')+'"'; }
      else if (t === "object") prev = "{"+keyCount(node.value)+" keys}";
      else if (t === "array") prev = "["+node.value.length+" items]";
      else prev = String(node.value);
      html += '<div class="res" data-ri="'+i+'"><span class="rpath">'+esc(ps)+'</span><span class="rval">'+esc(prev)+'</span></div>';
    }
    box.innerHTML = html; box.hidden = false; wireResX();
  }
  function wireResX(){ var x = $("resX"); if (x) x.onclick = function(){ $("results").hidden = true; }; }

  function jumpToMatch(ri){
    var node = searchMatches[ri];
    if (!node) return;
    var n = node.parent;
    while (n){ expanded.add(n.value); n = n.parent; }
    buildFlat();
    var parentVal = node.parent ? node.parent.value : null;
    var idx = -1;
    if (parentVal === null){ idx = 0; }
    else {
      var pi = -1;
      for (var j=0;j<flat.length;j++){ if (flat[j].value === parentVal){ pi = j; break; } }
      if (pi >= 0){
        var pd = flat[pi].depth;
        for (var m=pi+1;m<flat.length;m++){
          if (flat[m].depth <= pd) break;
          if (flat[m].depth === pd+1 && flat[m].key === node.key){ idx = m; break; }
        }
      }
    }
    if (idx >= 0){ scrollToIndex(idx); selectRow(idx); }
    $("results").hidden = true;
  }

  // ---- clipboard / toast ----
  var toastTimer = null;
  function toast(msg){
    var t = $("toast"); t.textContent = msg; t.classList.add("show");
    clearTimeout(toastTimer); toastTimer = setTimeout(function(){ t.classList.remove("show"); }, 1600);
  }
  function copyText(s, ok){
    if (navigator.clipboard && navigator.clipboard.writeText){
      navigator.clipboard.writeText(s).then(function(){ toast(ok||"Copied"); }).catch(function(){ fallbackCopy(s, ok); });
    } else fallbackCopy(s, ok);
  }
  function fallbackCopy(s, ok){
    try {
      var ta = document.createElement("textarea");
      ta.value = s; ta.style.position="fixed"; ta.style.opacity="0";
      document.body.appendChild(ta); ta.select();
      document.execCommand("copy"); document.body.removeChild(ta);
      toast(ok||"Copied");
    } catch(e){ toast("Couldn't copy"); }
  }
  function downloadJSON(){
    try {
      var txt = JSON.stringify(rootData, null, 2);
      var blob = new Blob([txt], { type: "application/json" });
      var a = document.createElement("a");
      a.href = URL.createObjectURL(blob);
      a.download = (rootMeta.name && /\.json$/i.test(rootMeta.name)) ? rootMeta.name : "data.json";
      document.body.appendChild(a); a.click();
      setTimeout(function(){ URL.revokeObjectURL(a.href); a.remove(); }, 0);
    } catch(e){ toast("Couldn't serialize for download"); }
  }

  // ---- sample data (clearly synthetic) ----
  function makeSample(){
    showOverlay("Generating 100,000 sample records…");
    setTimeout(function(){
      var N = 100000;
      var first = ["Ada","Lin","Noor","Theo","Rafa","Kai","Mira","Jon","Sol","Ivy","Rao","Zoe"];
      var last = ["Okafor","Nguyen","Haddad","Costa","Singh","Ibarra","Flores","Mori","Petrov","Khan"];
      var tagPool = ["alpha","beta","archived","priority","review","external","eu","na","apac","vip","trial"];
      var recs = new Array(N);
      var lorem = "lorem ipsum dolor sit amet consectetur adipiscing elit sed do eiusmod tempor incididunt ut labore ";
      for (var i=0;i<N;i++){
        var nTags = i % 5;
        var tags = []; for (var t=0;t<nTags;t++) tags.push(tagPool[(i+t) % tagPool.length]);
        recs[i] = {
          id: i,
          uuid: "rec_"+(i.toString(36).padStart(5,"0")),
          name: first[i%first.length]+" "+last[i%last.length],
          active: (i % 3) !== 0,
          score: Math.round((Math.sin(i)*0.5+0.5)*10000)/100,
          balance: ((i*37) % 100000) / 100,
          tags: tags,
          nickname: (i % 7 === 0) ? null : first[(i*3)%first.length].toLowerCase(),
          profile: {
            tier: ["free","pro","team","enterprise"][i%4],
            joined: "20"+(18+(i%7))+"-"+String(1+(i%12)).padStart(2,"0")+"-"+String(1+(i%28)).padStart(2,"0"),
            prefs: { theme: i%2?"dark":"light", density: i%3?"cozy":"compact", notify: (i%4)!==0 },
            bio: lorem.repeat(1 + (i % 4)).trim()
          }
        };
      }
      recs[0].profile.bio = lorem.repeat(1200).trim(); // ~120k characters
      recs[1].manyKeys = {};
      for (var k=0;k<2000;k++) recs[1].manyKeys["field_"+k] = k*k;
      initData({ _note: "Synthetic sample data generated in-browser — not real records.", count: N, records: recs },
               "sample-100k.json", N*220, 0, "sample");
      hideOverlay();
    }, 20);
  }

  // ---- paste ----
  function openPaste(){
    panelCtx = null;
    $("mtitle").textContent = "Paste JSON";
    $("mtype").textContent = "";
    $("pmodes").hidden = true; $("ptype").hidden = true; $("pbool").hidden = true; $("pkeyrow").hidden = true;
    panelNote("Paste or type JSON (or NDJSON), then Load.");
    $("mtext").value = "";
    $("mtext").hidden = false;
    $("mtext").readOnly = false;
    $("msave").hidden = true;
    $("mcopy").textContent = "Load";
    $("mcopy").onclick = function(){
      var v = $("mtext").value;
      resetPanelButtons(); closeModal();
      if (v.trim()) loadText(v, "pasted.json");
    };
    $("panel").hidden = false;
    $("mtext").focus();
  }
  function resetPanelButtons(){
    $("mcopy").textContent = "Copy";
    $("mcopy").onclick = function(){ copyText($("mtext").value, "Copied"); };
  }

  // ---- events ----
  $("file").addEventListener("change", function(e){ if (e.target.files[0]) readFile(e.target.files[0]); e.target.value=""; });
  var openFile = function(){ $("file").click(); };
  if ($("openBtn")) $("openBtn").onclick = openFile;
  if ($("openBtn2")) $("openBtn2").onclick = openFile;
  if ($("sampleBtn")) $("sampleBtn").onclick = makeSample;
  if ($("sampleBtn2")) $("sampleBtn2").onclick = makeSample;
  if ($("pasteBtn")) $("pasteBtn").onclick = openPaste;
  if ($("newBtn")) $("newBtn").onclick = function(){ initData({}, "untitled.json", 0, 0, "new"); };
  $("expandBtn").onclick = expandAll;
  $("collapseBtn").onclick = collapseAll;
  $("mclose").onclick = closeModal;
  $("msave").onclick = savePanel;
  $("saveBtn").onclick = save;
  $("copyAllBtn").onclick = function(){ try { copyText(JSON.stringify(rootData, null, 2), "JSON copied"); } catch(e){ toast("Too large to copy"); } };
  $("downloadBtn").onclick = downloadJSON;

  // panel segmented toggles
  $("ptype").addEventListener("click", function(e){ var b = e.target.closest("button"); if (b) setType(b.dataset.type); });
  $("pbool").addEventListener("click", function(e){ var b = e.target.closest("button"); if (b) setBool(b.dataset.bool === "true"); });
  $("pmodes").addEventListener("click", function(e){ var b = e.target.closest("button"); if (b) setMode(b.dataset.mode); });
  $("mtext").addEventListener("keydown", function(e){
    if (!$("msave").hidden && (e.metaKey || e.ctrlKey) && e.key === "Enter"){ e.preventDefault(); savePanel(); }
  });

  // warn before leaving with unsaved changes (manual save only)
  window.addEventListener("beforeunload", function(e){ if (dirty && CFG.saveUrl){ e.preventDefault(); e.returnValue = ""; } });

  $("themeBtn").onclick = function(){
    var cur = document.documentElement.getAttribute("data-theme");
    var dark = cur ? cur === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
    document.documentElement.setAttribute("data-theme", dark ? "light" : "dark");
  };

  // drag & drop (only when opening files is allowed)
  if (CFG.allowOpen){
    var drop = $("drop");
    ["dragenter","dragover"].forEach(function(ev){ document.addEventListener(ev, function(e){
      if (e.dataTransfer && Array.prototype.slice.call(e.dataTransfer.types||[]).indexOf("Files") >= 0){ e.preventDefault(); drop.classList.add("drag"); }
    }); });
    ["dragleave","drop"].forEach(function(ev){ document.addEventListener(ev, function(e){
      if (ev==="dragleave" && e.relatedTarget) return;
      drop.classList.remove("drag");
    }); });
    document.addEventListener("drop", function(e){
      if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0]){ e.preventDefault(); readFile(e.dataTransfer.files[0]); }
    });
  }

  // tree interaction (delegated)
  tree.addEventListener("scroll", scheduleRender, { passive: true });
  window.addEventListener("resize", scheduleRender);
  var clickTimer = null;
  rowsEl.addEventListener("click", function(e){
    var row = e.target.closest(".row"); if (!row) return;
    var i = +row.dataset.i;
    var act = e.target.dataset.act;
    // button actions are unambiguous — run immediately
    if (act === "big"){ clearTimeout(clickTimer); selectRow(i); openEdit(i); return; }
    if (act === "editbtn"){ clearTimeout(clickTimer); selectRow(i); openEdit(i); return; }
    if (act === "add"){ clearTimeout(clickTimer); selectRow(i); openAdd(i); return; }
    if (act === "remove"){ clearTimeout(clickTimer); var r=flat[i]; selectRow(-1); removeChild(r.parent, r.key); buildFlat(); return; }
    if (act === "toggle"){ clearTimeout(clickTimer); selectRow(i); toggle(i); return; }
    // plain row click: defer selection so a double-click can preempt it (and
    // not detach the node the dblclick handler needs)
    clearTimeout(clickTimer);
    var target = (i === selectedIndex) ? -1 : i;
    clickTimer = setTimeout(function(){ selectRow(target); }, 180);
  });
  rowsEl.addEventListener("dblclick", function(e){
    clearTimeout(clickTimer);
    var row = e.target.closest(".row"); if (!row) return;
    var i = +row.dataset.i;
    if (flat[i].expandable){ selectRow(i); toggle(i); return; }
    selectRow(i); openEdit(i);
  });

  // results interaction
  $("results").addEventListener("click", function(e){
    var r = e.target.closest(".res"); if (!r) return;
    jumpToMatch(+r.dataset.ri);
  });

  // search input (debounced)
  var searchDebounce = null;
  $("search").addEventListener("input", function(e){
    clearTimeout(searchDebounce);
    var q = e.target.value;
    if (!q.trim()){ clearSearch(); return; }
    searchDebounce = setTimeout(function(){ startSearch(q); }, 160);
  });
  $("search").addEventListener("keydown", function(e){ if (e.key === "Escape"){ $("search").value=""; clearSearch(); } });

  // row relationships within the flattened tree
  function parentIndex(i){
    var d = flat[i].depth;
    if (d === 0) return -1;
    for (var j=i-1; j>=0; j--){ if (flat[j].depth === d-1) return j; }
    return -1;
  }
  function lastChildIndex(i){
    var d = flat[i].depth, last = -1;
    for (var j=i+1; j<flat.length; j++){ if (flat[j].depth <= d) break; if (flat[j].depth === d+1) last = j; }
    return last;
  }
  function lastSiblingIndex(i){
    var d = flat[i].depth, last = i;
    for (var j=i+1; j<flat.length; j++){ if (flat[j].depth < d) break; if (flat[j].depth === d) last = j; }
    return last;
  }

  // keyboard navigation in the tree
  tree.addEventListener("keydown", function(e){
    if (!flat.length || !$("panel").hidden) return;
    var i = selectedIndex < 0 ? Math.floor(tree.scrollTop / ROWH) : selectedIndex;
    i = Math.max(0, Math.min(flat.length-1, i));
    var r = flat[i];
    var foldable = !!(r && r.expandable);
    var isOpen = foldable && expanded.has(r.value);

    if (e.key === "ArrowDown"){ e.preventDefault(); var d1=Math.min(flat.length-1, i+1); selectRow(d1); ensureVisible(d1); }
    else if (e.key === "ArrowUp"){ e.preventDefault(); var u1=Math.max(0, i-1); selectRow(u1); ensureVisible(u1); }
    else if (e.key === "ArrowLeft"){
      e.preventDefault();
      if (isOpen){ selectRow(i); toggle(i); ensureVisible(selectedIndex); }
      else { var p = parentIndex(i); if (p >= 0){ selectRow(p); ensureVisible(p); } }
    }
    else if (e.key === "ArrowRight"){
      e.preventDefault();
      if (foldable && !isOpen){ selectRow(i); toggle(i); ensureVisible(selectedIndex); }
      else if (isOpen){ var c = lastChildIndex(i); if (c >= 0){ selectRow(c); ensureVisible(c); } }
      else { var s = lastSiblingIndex(i); if (s !== i){ selectRow(s); ensureVisible(s); } }
    }
    else if (e.key === " " || e.key === "Spacebar"){
      e.preventDefault();
      if (foldable){ selectRow(i); toggle(i); ensureVisible(selectedIndex); }
    }
    else if (e.key === "Enter"){
      e.preventDefault();
      if (EDIT && r && !r.expandable){ selectRow(i); openEdit(i); }
      else if (foldable){ selectRow(i); toggle(i); }
    }
  });
  function ensureVisible(i){
    if (i < 0) return;
    var top = i*ROWH, bot = top+ROWH;
    if (top < tree.scrollTop) tree.scrollTop = top;
    else if (bot > tree.scrollTop + tree.clientHeight) tree.scrollTop = bot - tree.clientHeight;
    render();
  }

  // escape closes the docked editor
  document.addEventListener("keydown", function(e){ if (e.key === "Escape" && !$("panel").hidden) closeModal(); });

  $("app").classList.toggle("edit-on", EDIT);

  // ---- boot ----
  if (CFG.hasSeed){
    var seedEl = document.getElementById("jsonlens-seed");
    var seed;
    try { seed = JSON.parse(seedEl.textContent); }
    catch(e){ seed = {}; }
    initData(seed, (document.title || "data") + ".json", seedEl.textContent.length, 0, "seed");
    $("stats").hidden = true; // seeded editor keeps the header lean
  }
})();
</script>
</body>
</html>
