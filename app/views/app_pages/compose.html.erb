<% content_for :title, @question || "Buddy" %>
<div class="panel-app">
  <form class="panel-page" data-buddy-compose="<%= {
    send_as: @send_as,
    prefix:  @prefix,
    inline:  @inline,
    data:    @data,
  }.to_json %>">
    <header class="panel-topbar">
      <button type="button" class="panel-icon-btn" data-buddy-close aria-label="Close">‹</button>
      <h1><%= @question || (@send_as == :command ? "Command" : "Buddy") %></h1>
    </header>

    <div class="panel-settings">
      <textarea name="text" rows="3" autofocus></textarea>
      <button type="submit" class="panel-btn panel-btn-primary panel-btn-block panel-btn-lg buddy-app-only">Send</button>
      <div class="panel-rows" data-buddy-exchanges></div>
    </div>
    <p class="panel-empty buddy-app-elsewhere">Open this from the Buddy app.</p>
  </form>
</div>
