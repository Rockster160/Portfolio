<% content_for :title, "Buddy" %>
<div class="panel-app">
  <div class="panel-page">
    <h1 class="panel-title">Buddy</h1>

    <%= form_with model: @user, url: app_login_path, method: :post do |f| %>
      <% @device_params.each do |key, value| %>
        <%= hidden_field_tag "device[#{key}]", value %>
      <% end %>

      <% if @user.errors.any? %>
        <div class="panel-errors" role="alert"><%= @user.errors.full_messages.to_sentence %></div>
      <% end %>

      <div class="panel-field">
        <%= f.label :username, class: "panel-field-label" %>
        <%= f.text_field :username, autocapitalize: "none", autocorrect: "off", autocomplete: "username" %>
      </div>
      <div class="panel-field">
        <%= f.label :password, class: "panel-field-label" %>
        <%= f.password_field :password, autocomplete: "current-password" %>
      </div>

      <button type="submit" class="panel-btn panel-btn-primary panel-btn-block panel-btn-lg">Log in</button>
    <% end %>

    <div class="panel-links">
      <%= link_to "Don't have an account?", register_path, target: "_blank", rel: "noopener" %>
      <%= link_to "Privacy Policy", privacy_policy_path %>
      <%= link_to "Support", support_path %>
    </div>
  </div>
</div>
