<% content_for :title, "Buddy" %>
<div class="panel-app" data-buddy-signed-in="<%= {
  token:                   @token,
  device:                  { id: @device.id, name: @device.name },
  user:                    { id: @user.id, username: @user.username },
  primary_conversation_id: ByteConversation.primary_for(@user)&.id,
  dark_mode:               !!@user.dark_mode?,
}.to_json %>">
  <div class="panel-page"></div>
</div>
