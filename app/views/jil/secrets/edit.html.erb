<div class="skinny-container">
  <div class="btn-container">
    <a href="<%= jil_secrets_path %>" class="btn">&larr; Secrets</a>
    <%= link_to "Remove", jil_secret_path(@secret), method: :delete, class: "btn danger pull-right", data: { confirm: "Remove #{@secret.name_was}? Anything using it will fail until it's saved again." } %>
  </div>
  <%= form_tag jil_secret_path(@secret), method: :patch, class: "basic" do %>
    <div class="form-title">Edit Secret</div>

    <div class="form-fields">
      <div class="form-field">
        <%= label_tag :name, "Name" %>
        <%= text_field_tag :name, @secret.name, autocomplete: :off, data: { "1p-ignore": true, lpignore: true, bwignore: true } %>
        <small>Anything that looks it up by the old name stops finding it.</small>
      </div>
      <div class="form-field">
        <%= label_tag :value, "New value" %>
        <%= text_field_tag :value, nil, placeholder: "Currently #{@secret.hint} — leave blank to keep it", class: "text-security", autocomplete: :off, spellcheck: false, data: { "1p-ignore": true, lpignore: true, bwignore: true } %>
      </div>
    </div>
    <div class="form-submission">
      <%= submit_tag "Save" %>
    </div>
  <% end %>
</div>
