<div class="skinny-container lists-index-container">
  <div class="btn-container">
    <a href="<%= account_path %>" class="btn">Account</a>
  </div>
  <div class="lists-title">Secrets</div>

  <%= form_tag jil_secrets_path, class: "basic" do %>
    <div class="form-fields">
      <div class="form-field">
        <%= label_tag :name, "Name" %>
        <%= text_field_tag :name, nil, placeholder: "OpenAI", autocomplete: :off, data: { "1p-ignore": true, lpignore: true, bwignore: true } %>
      </div>
      <div class="form-field">
        <%= label_tag :value, "Value" %>
        <%= text_field_tag :value, nil, placeholder: "Saving an existing name replaces it", class: "text-security", autocomplete: :off, spellcheck: false, data: { "1p-ignore": true, lpignore: true, bwignore: true } %>
      </div>
    </div>
    <div class="form-submission">
      <%= submit_tag "Save" %>
    </div>
  <% end %>

  <div class="lists">
    <% @secrets.each do |secret| %>
      <div class="list-item-container">
        <div class="list-item">
          <span class="item-name"><%= secret.name %></span>
          <div class="list-item-brief">
            <div class="right-brief">
              <%= secret.hint %>
              <%= link_to "Remove", jil_secret_path(secret), method: :delete, class: "danger", data: { confirm: "Remove #{secret.name}? Anything using it will fail until it's saved again." } %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
