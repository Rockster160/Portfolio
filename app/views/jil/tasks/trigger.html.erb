<%= meta_title @task.name, include_name: false %>
<%= meta_description "Run the #{@task.name} automation task." %>

<div class="skinny-container lists-index-container">
  <div class="btn-container flex-justify-space-between">
    <a href="<%= jil_tasks_path %>" class="btn">All Tasks</a>
    <a href="<%= jil_task_path(@task) %>" class="btn">Edit Task</a>
  </div>

  <div class="list-title"><%= @task.name %></div>

  <div class="task-trigger-btns">
    <%= render partial: "jil/tasks/trigger", locals: { task: @task, title: "Trigger Now" } %>
  </div>

  <div class="trigger-pressed-at" aria-live="polite"></div>
</div>

<script>
  (function() {
    const stamp = function(word, failed) {
      const el = document.querySelector(".trigger-pressed-at");
      if (!el) return;
      const time = new Date().toLocaleTimeString([], { hour: "numeric", minute: "2-digit", second: "2-digit" });
      el.textContent = word + " at " + time;
      el.classList.toggle("failed", failed);
    };

    document.addEventListener("execute:triggered", function() { stamp("Triggered", false) });
    document.addEventListener("execute:failed", function() { stamp("Failed", true) });
  })();
</script>
