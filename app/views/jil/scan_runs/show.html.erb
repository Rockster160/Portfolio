<% url = task_scan_run_path(@task.short_key || @task.id) %>
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex,nofollow">
<title><%= @task.name %></title>
<style>
body{margin:0;min-height:100vh;display:grid;place-items:center;text-align:center;font:18px/1.4 system-ui,sans-serif;background:#111;color:#eee}
h1{font-size:1.3em;margin:0 0 .5em;padding:0 16px}
.ok{color:#4c4}.no{color:#e55}
a{display:inline-block;margin-top:1em;padding:.6em 1.4em;border:1px solid #666;border-radius:8px;color:inherit;text-decoration:none}
</style>
</head>
<body>
<main>
<h1><%= @task.name %></h1>
<% case @state %>
<% when :run %>
<p id="s">Running…</p>
<a id="a" href="<%= url %>" hidden>Run again</a>
<% when :ran %>
<p>Already ran.</p>
<a href="<%= url %>">Run again</a>
<% when :idle %>
<p>Not run.</p>
<a href="<%= url %>">Run</a>
<% when :inputs %>
<p>This task needs inputs.</p>
<a href="<%= task_trigger_path(@task.short_key || @task.id) %>">Open</a>
<% end %>
</main>
<% if @state == :run %>
<script>
(function(){
var s=document.getElementById("s"),a=document.getElementById("a"),url=<%== url.to_json %>,pass=<%== @pass.to_json %>;
history.replaceState(null,"",url+"?once="+encodeURIComponent(pass));
function show(t,c){s.textContent=t;s.className=c||"";a.hidden=false}
function go(){
if(document.visibilityState!=="visible"||document.prerendering)return;
document.removeEventListener("visibilitychange",go);
fetch(url,{method:"POST",credentials:"same-origin",headers:{"Content-Type":"application/x-www-form-urlencoded","X-CSRF-Token":<%== form_authenticity_token.to_json %>},body:"once="+encodeURIComponent(pass)}).then(function(r){
if(r.ok)show("Triggered ✓","ok");else if(r.status===409)show("Already ran.");else show("Didn't run ("+r.status+").","no");
},function(){show("Lost connection. It may not have run.","no")});
}
document.addEventListener("visibilitychange",go);go();
})();
</script>
<% end %>
</body>
</html>
