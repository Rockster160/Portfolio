<%= meta_title "Playground" %>
<%= meta_description "Tools, games, and experiments -  a collection of personal projects." %>
<% content_for :head_before_scripts do %>
  <script src="https://cdn.rawgit.com/google/code-prettify/master/loader/run_prettify.js?skin=desert"></script>
<% end %>

<div class="wide-container">
  <div class="app-card-container">
    <div class="app-card-title">
      Playground
      <div class="subtitle">
        Tools, games, and experiments. Many of these are scrappy one-offs or unfinished ideas. Each one has an About page, and anything that needs an account or stays private says so.
      </div>
    </div>
    <div class="app-card-body">
      <div class="app-card-inner">
        <div class="project-grid">
          <%= render partial: "index/playground_card", collection: PlaygroundProject.listed, as: :project %>
        </div>
      </div>
    </div>
  </div>
</div>

<% PlaygroundProject.listed.select(&:api).each do |project| %>
  <%= render "index/playground_api/#{project.api}" %>
<% end %>
