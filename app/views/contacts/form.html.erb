<div class="skinny-container">
  <div class="btn-container">
    <a href="<%= contacts_path %>" class="btn">&larr; All Contacts</a>
    <% if @contact.persisted? %>
      <%= link_to :Delete, @contact, method: :delete, class: "btn danger pull-right" %>
    <% end %>
  </div>
  <%= form_for @contact do |f| %>
    <div class="form-title"><%= @contact.persisted? ? :Edit : :New %> Contact</div>

    <%= render partial: "layouts/error_container", locals: { resource: @contact } %>

    <div class="form-fields">
      <div class="triple-fields">
        <div class="form-field">
          <%= f.label :name, "First name" %>
          <%= f.text_field :name %>
        </div>
        <div class="form-field">
          <%= f.label :last_name %>
          <%= f.text_field :last_name %>
        </div>
        <div class="form-field">
          <%= f.label :maiden_name, "Maiden name (optional)" %>
          <%= f.text_field :maiden_name %>
        </div>
      </div>

      <div class="split-fields">
        <div class="form-field">
          <%= f.label :username %>
          <%= f.text_field :username %>
        </div>
        <div class="form-field">
          <%= f.label :nickname, "Nickname (Comma separated)" %>
          <%= f.text_field :nickname %>
        </div>
      </div>

      <% if @contact.friend? %>
        <div class="form-field">
          <div class="checkbox-wrapper">
            <%= f.check_box :permit_relay %>
            <%= f.label :permit_relay do %>
              <div class="checkbox-placeholder"></div>
              Permit Relay?
            <% end %>
          </div>
        </div>
      <% end %>

      <div class="split-fields">
        <div class="form-field">
          <%= f.label :phone %>
          <%= f.phone_field :phone %>
        </div>
        <div class="form-field">
          <%= f.label :email %>
          <%= f.email_field :email %>
        </div>
      </div>

      <div class="triple-fields">
        <div class="form-field">
          <%= f.label :birth_month, "Birthday" %>
          <%= f.select :birth_month,
            (1..12).map { |m| [::Date::MONTHNAMES[m], m] },
            { include_blank: "Month" } %>
        </div>
        <div class="form-field">
          <%= f.label :birth_day, "Day" %>
          <%= f.number_field :birth_day, in: 1..31, placeholder: "Day" %>
        </div>
        <div class="form-field">
          <%= f.label :birth_year, "Year (optional)" %>
          <%= f.number_field :birth_year, in: 1900..Date.current.year, placeholder: "e.g. 1995" %>
        </div>
      </div>

      <div class="form-field">
        <%= f.label :tag_strings, "Tags (Comma separated)" %>
        <%= f.text_field :tag_strings %>
      </div>

      <div class="form-field">
        <%= f.label :notes %>
        <%= f.text_area :notes %>
      </div>
    </div>

    <div class="form-submission">
      <%= f.submit %>
    </div>

    <% @contact.addresses.ordered.each do |address| %>
      <div class="sub-form">
        <% if address.primary? %>
          <i class="fa fa-star is-primary"></i>
        <% end %>
        <div class="form-field">
          <small><%= address.icon %> <%= address.label %></small>
          <p><%= address.street %></p>
          <%= link_to "Edit", [:edit, @contact, address], class: :btn %>
        </div>
      </div>
    <% end %>
    <div class="form-field">
      <%= link_to "+ New Address", [:new, @contact, :address], class: :btn if @contact.persisted? %>
    </div>
  <% end %>
</div>
