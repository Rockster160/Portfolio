<% content_for :title, @list_builder.name %>
<% content_for :favicon do %>
  <link rel="apple-touch-icon" sizes="180x180" href="<%= asset_path 'list_favicon/apple-touch-icon.png' %>">
  <link rel="icon" type="image/png" href="<%= asset_path 'list_favicon/favicon-32x32.png' %>" sizes="32x32">
  <link rel="icon" type="image/png" href="<%= asset_path 'list_favicon/favicon-16x16.png' %>" sizes="16x16">
  <link rel="manifest" href="<%= manifest_list_builder_path(@list_builder) %>">
  <meta name="apple-mobile-web-app-title" content="<%= @list_builder.name.truncate(12) %>">
  <link rel="mask-icon" href="<%= asset_path 'list_favicon/safari-pinned-tab.svg' %>" color="#5BBAD5">
  <link rel="shortcut icon" href="<%= asset_path 'list_favicon/favicon.ico' %>">
  <meta name="theme-color" content="#000712">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
<% end %>
<% content_for :modals do %>
  <div id="cmodal-backdrop" class="cmodal-backdrop hidden">
    <div class="cmodal">
      <h3 id="cmodal-title">Edit Item</h3>
      <div class="row">
        <input id="m-name" placeholder="Name">
      </div>
      <div class="row">
        <input id="m-img" placeholder="Image URL or emoji">
      </div>
      <div class="row">
        <input id="m-display" placeholder="Display name (optional)">
        <input id="m-stock" class="sm basic" type="number" placeholder="Stock" min="0" style="max-width:80px">
        <input id="m-low" class="sm basic" type="number" placeholder="Low" min="0" style="max-width:80px">
      </div>
      <div class="cmodal-actions">
        <button id="m-delete" class="danger primary" type="button">Delete</button>
        <div class="spacer"></div>
        <button id="m-cancel" class="primary" type="button">Cancel</button>
        <button id="m-save" class="ok primary" type="button">Done</button>
      </div>
    </div>
  </div>

  <div id="qmodal-backdrop" class="cmodal-backdrop hidden">
    <div class="cmodal">
      <h3>Quick Edit</h3>
      <textarea id="q-text" rows="12" wrap="off"
        style="width:100%;padding:8px 10px;border:1px solid #CCC;border-radius:6px;
              font-family: ui-monospace, SFMono-Regular, Menlo, monospace"></textarea>
      <div class="cmodal-actions">
        <div class="spacer"></div>
        <button id="q-cancel" class="primary" type="button">Cancel</button>
        <button id="q-apply" class="ok primary" type="button">Apply</button>
      </div>
    </div>
  </div>
<% end %>

<div class="wrap"
     data-save-url="<%= list_builder_path(@list_builder) %>"
     data-stock-url="<%= update_stock_list_builder_path(@list_builder) %>"
     data-builder-id="<%= @list_builder.id %>"
     data-list-id="<%= @list_builder.list_id %>">
  <div class="summary-container">
    <div id="ws-status" class="ws-disconnected hidden">Disconnected</div>
    <div class="text-right">
      List: <strong><%= @list_builder.list.name %></strong> |
      Selected: <span id="selected-count">0</span> items
    </div>
  </div>

  <div class="topbar">
    <div class="row flex-between" data-editing=true class="hidden">
      <button id="cancel-edit" class="primary" type="button">Cancel</button>
      <%= link_to "Reload", list_builder_path(@list_builder), class: "btn primary" %>
      <%= link_to "Edit Page", edit_list_builder_path(@list_builder), class: "btn primary", id: "page-edit" %>
    </div>

    <div class="row">
      <button id="toggle-edit" class="primary" type="button">⚙️</button>
      <button id="save-items" class="primary" type="button" class="hidden">💾</button>
      <button id="add-item" class="primary" type="button" class="hidden">➕</button>
      <button id="quick-edit" class="primary" type="button" class="hidden">✍️</button>

      <input id="search" type="search" placeholder="Search items..." autocomplete="off">
    </div>
  </div>

  <div id="grid" class="brows"></div>
</div>

<% content_for :after_body do %>
  <script id="items-data" type="application/json">
    <%= raw(@list_builder.items.to_json) %>
  </script>
  <script id="list-items-data" type="application/json">
    <%= raw(@list_builder.list.list_items.pluck(:name).to_json) %>
  </script>
  <script id="snapshot-stamp" type="application/json">
    <%= @list_builder.snapshot_stamp %>
  </script>

  <style>
    html, body { margin: 0; padding: 0; font-family: system-ui, -apple-system, Segoe UI, Roboto; }
    .summary-container {
      font-weight: 500; color: #ECF0F1;
    }
    .wrap { max-width: 1600px; margin: 0 auto; padding: 16px 20px 28px }
    .topbar { display: flex; flex-direction: column; gap: 10px; align-items: center; margin-bottom: 12px }
    input[type="text"] {
      flex: 1; padding: 10px 12px; border: 1px solid #CCC;
      border-radius: 8px; outline: none
    }
    button {
      padding: inherit;
    }
    button.primary, .btn.primary {
      min-height: 48px; min-width: 48px; padding: 6px 12px; border: none; border-radius: 8px;
      background: #2563EB; color: black; cursor: pointer
    }
    button.primary:disabled { opacity: .5; cursor: default }

    .ws-disconnected {
      background: #991B1B; color: #FFF; padding: 4px 12px;
      border-radius: 6px; font-size: 13px; font-weight: 500;
    }

    .text-right { text-align: right; }
    .row { display: flex; gap: 10px; width: 100% }
    .row.right { justify-content: flex-end; }
    .row input {
      flex: 1; padding: 8px 10px; border: 1px solid #CCC; border-radius: 6px
    }
    .topbar .row input[type="search"] { min-height: 48px; margin: 0 }
    .flex-between {
      display: flex; justify-content: space-between; align-items: center
    }
    @media (max-width: 600px) { .wrap { padding: 8px 0 20px } }

    .hidden { display: none }
  </style>

  <script type="module">
    import { showFlash } from "../../quick_actions/flash.js";
    import { AuthWS } from "../../quick_actions/auth_ws.js";
    import {
      fuzzyMatch, setText, setIcon, setBadges, setDesc, setCount, reconcileRows, enableDragReorder,
    } from "<%= versioned_public_path("/quick_actions/builder_rows.js") %>";

    let ITEMS = JSON.parse(
      document.getElementById("items-data").textContent || "[]"
    )
    let LIST_ITEMS = new Set(JSON.parse(
      document.getElementById("list-items-data").textContent || "[]"
    ).map(name => name.toLowerCase()))
    const BOOT_STAMP = Number(document.getElementById("snapshot-stamp").textContent)

    let query = ""
    let editMode = false
    let preEdit = ""

    const elGrid = document.getElementById("grid")
    const elSearch = document.getElementById("search")
    const elCancelEdit = document.getElementById("cancel-edit")
    const elToggleEdit = document.getElementById("toggle-edit")
    const elAddItem = document.getElementById("add-item")
    const elSaveItems = document.getElementById("save-items")
    const elQuickEdit = document.getElementById("quick-edit")
    const elWsStatus = document.getElementById("ws-status")
    const wrapEl = document.querySelector(".wrap")
    const SAVE_ENDPOINT = wrapEl?.dataset.saveUrl
    const STOCK_ENDPOINT = wrapEl?.dataset.stockUrl
    const BUILDER_ID = wrapEl?.dataset.builderId
    const LIST_ID = wrapEl?.dataset.listId

    const elcModal = document.getElementById("cmodal-backdrop")
    const mTitle = document.getElementById("cmodal-title")
    const mName = document.getElementById("m-name")
    const mImg = document.getElementById("m-img")
    const mDisplay = document.getElementById("m-display")
    const mStock = document.getElementById("m-stock")
    const mLow = document.getElementById("m-low")
    const mSave = document.getElementById("m-save")
    const mCancel = document.getElementById("m-cancel")
    const mDelete = document.getElementById("m-delete")
    let currentEditingName = null
    let isNewItem = false

    const elQModal = document.getElementById("qmodal-backdrop")
    const elQText = document.getElementById("q-text")
    const elQApply = document.getElementById("q-apply")
    const elQCancel = document.getElementById("q-cancel")

    const csrfToken = () => {
      const m = document.querySelector('meta[name="csrf-token"]')
      return m ? m.content : ""
    }

    const deleteItem = name => {
      ITEMS = ITEMS.filter(x => x.name !== name)
    }

    // ---------- Edit Modal ----------
    const opencModal = item => {
      currentEditingName = item?.name || null
      isNewItem = !item
      mTitle.textContent = isNewItem ? "Add Item" : "Edit Item"
      mName.value = item?.name || ""
      mImg.value = item?.img || ""
      mDisplay.value = item?.display || ""
      mStock.value = item?.stock ?? 1
      mLow.value = item?.low != null ? item.low : ""
      mDelete.classList.toggle("hidden", isNewItem)
      elcModal.classList.remove("hidden")
      setTimeout(() => mName.focus(), 0)
    }

    const closecModal = () => {
      elcModal.classList.add("hidden")
      currentEditingName = null
      isNewItem = false
    }

    mCancel.addEventListener("click", () => closecModal())

    mSave.addEventListener("click", () => {
      const name = mName.value.trim() || "Untitled"
      const img = mImg.value.trim()
      const display = mDisplay.value.trim() || undefined
      const stock = parseInt(mStock.value, 10) || 0
      const lowRaw = mLow.value.trim()
      const item = { name, img, display, stock }
      if (lowRaw !== "") item.low = parseInt(lowRaw, 10) || 0

      if (isNewItem) {
        ITEMS.push(item)
      } else {
        const idx = ITEMS.findIndex(x => x.name === currentEditingName)
        if (idx >= 0) ITEMS[idx] = { ...ITEMS[idx], ...item }
      }
      closecModal()
      render()
    })

    mDelete.addEventListener("click", () => {
      if (!currentEditingName) return
      deleteItem(currentEditingName)
      closecModal()
      render()
    })

    elcModal.addEventListener("click", e => {
      if (e.target === elcModal) closecModal()
    })

    // ---------- Quick Edit ----------
    const itemsToText = items => {
      return items.map(it => {
        let name = it.name
        if (it.low != null) name += ` [${it.low}]`
        let parts = name
        if (it.img?.trim()) parts += ` | ${it.img.trim()}`
        if (it.display?.trim()) parts += ` | ${it.display.trim()}`
        if ((it.stock || 0) > 0) parts += ` (${it.stock})`
        return parts
      }).join("\n")
    }

    const textToItems = text => {
      return text.split("\n").map(line => {
        let raw = line.trim()
        if (!raw) return null
        let stock = 0
        const sm = raw.match(/\((\d+)\)\s*$/)
        if (sm) {
          stock = parseInt(sm[1], 10)
          raw = raw.replace(/\s*\(\d+\)\s*$/, "")
        }
        const parts = raw.split("|", 3)
        let name = parts[0].trim()
        let low = undefined
        const lm = name.match(/\[(\d+)\]\s*$/)
        if (lm) {
          low = parseInt(lm[1], 10)
          name = name.replace(/\s*\[\d+\]\s*$/, "").trim()
        }
        const item = {
          name: name,
          img: (parts[1] || "").trim(),
          display: (parts[2] || "").trim() || undefined,
          stock: stock,
        }
        if (low != null) item.low = low
        return item
      }).filter(Boolean)
    }

    const openQuickEdit = () => {
      if (!elQModal) return
      elQText.value = itemsToText(ITEMS)
      elQModal.classList.remove("hidden")
      setTimeout(() => elQText.focus(), 0)
    }

    const closeQuickEdit = () => { elQModal?.classList.add("hidden") }

    elQuickEdit?.addEventListener("click", openQuickEdit)
    elQCancel?.addEventListener("click", closeQuickEdit)
    elQApply?.addEventListener("click", () => {
      ITEMS = textToItems(elQText.value)
      closeQuickEdit()
      render()
    })
    elQModal?.addEventListener("click", e => {
      if (e.target === elQModal) closeQuickEdit()
    })

    // ---------- Snapshot ordering ----------
    // Builder and list snapshots come from broadcasts, PATCH replies and
    // resync reads, and on a slow link they arrive in any order. Each carries
    // a server stamp taken after its read; anything older than what's already
    // drawn is dropped rather than redrawing the past.
    const stampGuard = (start) => {
      let drawnAt = start
      return stamp => {
        const ts = Number(stamp)
        if (!Number.isFinite(ts)) return true
        if (ts < drawnAt) return false
        drawnAt = ts
        return true
      }
    }
    const freshBuilder = stampGuard(Number.isFinite(BOOT_STAMP) ? BOOT_STAMP : -Infinity)
    const freshList = stampGuard(Number.isFinite(BOOT_STAMP) ? BOOT_STAMP : -Infinity)

    // ---------- Stock counters ----------
    // A tap shows its count at once as an override in `localStock`, marked
    // pending until the server agrees. Taps debounce into one PATCH of
    // absolute counts, so a retry after a lost reply can't apply twice.
    // While a row is being tapped nothing from the server touches its count:
    // the reply to the first tap would otherwise drag a burst of taps back.
    // When the taps stop, the page re-reads the server and settles.
    const DEBOUNCE_MS = 700
    const PROTECT_MS = 3000
    const REQUEST_TIMEOUT_MS = 20000
    const MAX_RETRY_MS = 15000

    const localStock = new Map()
    let pendingStock = {}
    let inFlightStock = {}
    let inFlight = false
    let debounceTimer = null
    let retryMs = 1000

    const shownStock = it => (
      localStock.has(it.name) ? localStock.get(it.name).value : (it.stock || 0)
    )
    const isTapping = name => {
      const local = localStock.get(name)
      return !!local && Date.now() - local.at < PROTECT_MS
    }
    const isUnsent = name => name in pendingStock || name in inFlightStock

    // Drops every override the server has caught up with. One still being
    // tapped or not yet written stays; any other is settled by the server's
    // value, whether it matches or someone else changed it since.
    const settleStock = () => {
      for (const name of Array.from(localStock.keys())) {
        if (isTapping(name) || isUnsent(name)) continue
        localStock.delete(name)
      }
    }

    const adjustStock = (name, delta) => {
      const item = ITEMS.find(i => i.name === name)
      if (!item) return
      const value = Math.max(0, shownStock(item) + delta)
      localStock.set(name, { value, at: Date.now() })
      pendingStock[name] = value
      clearTimeout(debounceTimer)
      debounceTimer = setTimeout(flushStock, DEBOUNCE_MS)
      scheduleResync()
      renderRow(name)
    }

    const flushStock = async (keepalive = false) => {
      if (inFlight || Object.keys(pendingStock).length === 0) return
      const batch = pendingStock
      pendingStock = {}
      inFlightStock = batch
      inFlight = true

      const ctrl = new AbortController()
      const timeout = setTimeout(() => ctrl.abort(), REQUEST_TIMEOUT_MS)
      let data = null
      try {
        const res = await fetch(STOCK_ENDPOINT, {
          method: "PATCH",
          headers: {
            "Content-Type": "application/json",
            "X-CSRF-Token": csrfToken(),
            "Accept": "application/json"
          },
          body: JSON.stringify({ stock: batch }),
          credentials: "same-origin",
          signal: keepalive ? undefined : ctrl.signal,
          keepalive,
        })
        if (res.ok) data = await res.json().catch(() => ({}))
      } catch {
        // Offline or timed out; the batch is requeued below.
      } finally {
        clearTimeout(timeout)
        inFlight = false
        inFlightStock = {}
      }

      if (data) {
        retryMs = 1000
        if (data.items) applyBuilderSnapshot(data.items, data.timestamp)
        if (Object.keys(pendingStock).length > 0) {
          clearTimeout(debounceTimer)
          debounceTimer = setTimeout(flushStock, DEBOUNCE_MS)
        }
        return
      }

      // Taps made while this was out are newer than the batch; keep those.
      for (const [name, value] of Object.entries(batch)) {
        if (!(name in pendingStock)) pendingStock[name] = value
      }
      clearTimeout(debounceTimer)
      debounceTimer = setTimeout(flushStock, retryMs)
      retryMs = Math.min(retryMs * 2, MAX_RETRY_MS)
    }

    // ---------- List membership ----------
    // A tap records what the person wants in `listIntent`, and the row shows
    // it as pending. The socket gets the settled wish once taps stop, and
    // only if it differs from the list: a double tap that lands where it
    // started sends nothing, and add/remove repeat safely where a toggle
    // would flip twice. A list that agrees settles the wish; one still
    // disagreeing after LIST_PROTECT_MS means the write was lost, so the
    // list wins.
    const LIST_DEBOUNCE_MS = 400
    const LIST_PROTECT_MS = 8000

    const listIntent = new Map()
    let listTimer = null
    let listSocket = null

    const onServerList = name => LIST_ITEMS.has(name.toLowerCase())
    const isSelected = name => {
      const intent = listIntent.get(name.toLowerCase())
      return intent ? intent.on : onServerList(name)
    }

    const settleList = () => {
      for (const [key, intent] of Array.from(listIntent.entries())) {
        const server = onServerList(intent.name)
        const written = intent.sent === undefined || intent.sent === intent.on
        if (server === intent.on && written) listIntent.delete(key)
        else if (server !== intent.on && Date.now() - intent.at >= LIST_PROTECT_MS) {
          listIntent.delete(key)
        }
      }
    }

    const flushList = () => {
      if (!listSocket?.open) {
        listTimer = setTimeout(flushList, 1000)
        return
      }
      for (const [key, intent] of Array.from(listIntent.entries())) {
        if (intent.sent === intent.on) continue
        if (intent.sent === undefined && intent.on === onServerList(intent.name)) {
          listIntent.delete(key)
          renderRow(intent.name)
          continue
        }
        listSocket.send(intent.on ? { add: intent.name } : { remove: intent.name })
        intent.sent = intent.on
      }
    }

    const toggleItem = (item) => {
      const name = item.name
      const key = name.toLowerCase()
      const prior = listIntent.get(key)
      listIntent.set(key, { name, on: !isSelected(name), sent: prior?.sent, at: Date.now() })
      clearTimeout(listTimer)
      listTimer = setTimeout(flushList, LIST_DEBOUNCE_MS)
      scheduleResync(LIST_PROTECT_MS)
      renderRow(name)
    }

    // ---------- Server snapshots ----------
    const applyBuilderSnapshot = (items, stamp) => {
      if (!freshBuilder(stamp)) return
      if (!editMode) ITEMS = items
      settleStock()
      render()
    }

    const applyListSnapshot = (names, stamp) => {
      if (!freshList(stamp)) return
      LIST_ITEMS = new Set(names.map(name => name.toLowerCase()))
      settleList()
      render()
    }

    // Re-reads both snapshots once the taps have stopped long enough for
    // every override to be out of its protection window, so a broadcast
    // dropped mid-burst can't leave a stale count on screen.
    let resyncTimer = null
    let resyncAt = 0
    const scheduleResync = (after = PROTECT_MS) => {
      const at = Date.now() + after + 250
      if (resyncTimer && at <= resyncAt) return
      clearTimeout(resyncTimer)
      resyncAt = at
      resyncTimer = setTimeout(resync, at - Date.now())
    }

    const resync = async () => {
      resyncTimer = null
      if (inFlight || Object.keys(pendingStock).length > 0) {
        scheduleResync(DEBOUNCE_MS)
        return
      }
      try {
        const res = await fetch(SAVE_ENDPOINT, {
          headers: { "Accept": "application/json" },
          credentials: "same-origin",
        })
        if (!res.ok) return
        const data = await res.json()
        applyBuilderSnapshot(data.items, data.timestamp)
        applyListSnapshot(data.list_items, data.timestamp)
      } catch {
        // Next tap, reconnect or wake resyncs again.
      }
    }

    // ---------- Render ----------
    const rowEls = new Map()

    const updateRow = (row, it) => {
      const stockVal = shownStock(it)
      const lowThreshold = it.low != null ? it.low : 1
      const isOut = stockVal === 0
      const isLow = !isOut && lowThreshold > 0 && stockVal <= lowThreshold
      const intent = listIntent.get(it.name.toLowerCase())
      const selected = isSelected(it.name)

      row.classList.toggle("selected", selected)
      row.classList.toggle("dim", isOut)
      row.classList.toggle("count-pending", localStock.has(it.name))
      row.draggable = editMode

      setIcon(row, it.img, "📦")
      setText(row.querySelector(".brow-title"), it.display || it.name)
      setCount(row, stockVal)

      const badges = []
      if (intent) badges.push({ text: intent.on ? "Adding…" : "Removing…", tone: "warn" })
      else if (selected) badges.push({ text: "On List", tone: "ok" })
      if (isOut) badges.push({ text: "Out", tone: "bad" })
      else if (isLow) badges.push({ text: "Low", tone: "warn" })
      setBadges(row, badges)
    }

    const renderRow = name => {
      const row = rowEls.get(name)
      const it = ITEMS.find(i => i.name === name)
      if (row && it) updateRow(row, it)
      updateSelectedCount()
    }

    const updateSelectedCount = () => {
      const count = ITEMS.filter(it => isSelected(it.name)).length
      setText(document.getElementById("selected-count"), String(count))
    }

    const render = () => {
      document.body.classList.toggle("editing", editMode)
      document.querySelectorAll("[data-editing=true]").forEach(el => el.classList.toggle("hidden", !editMode))
      document.querySelectorAll("[data-editing=false]").forEach(el => el.classList.toggle("hidden", editMode))
      elToggleEdit.classList.toggle("hidden", editMode)
      elAddItem.classList.toggle("hidden", !editMode)
      elSaveItems.classList.toggle("hidden", !editMode)
      elQuickEdit?.classList.toggle("hidden", !editMode)

      const entries = ITEMS.map(it => ({
        key: it.name,
        item: it,
        hidden: !fuzzyMatch(query, it.display || it.name),
      }))
      reconcileRows(elGrid, rowEls, entries, updateRow)
      updateSelectedCount()
    }

    elGrid.addEventListener("click", e => {
      const row = e.target.closest(".brow")
      if (!row) return
      const item = ITEMS.find(i => i.name === row.dataset.key)
      if (!item) return
      e.preventDefault()

      if (editMode) {
        opencModal(item)
        return
      }
      const step = e.target.closest(".brow-step")
      if (step) {
        adjustStock(item.name, Number(step.dataset.step))
        return
      }
      if (e.target.closest(".brow-stepper")) return
      toggleItem(item)
    })

    enableDragReorder(elGrid, {
      isActive: () => editMode,
      onDrop: keys => {
        const order = new Map(keys.map((k, i) => [k, i]))
        ITEMS.sort((a, b) => order.get(a.name) - order.get(b.name))
        render()
      },
    })

    // ---------- Search / Edit toggle / Add / Save ----------
    elSearch.addEventListener("input", e => {
      query = e.target.value.trim()
      render()
    })

    elToggleEdit.addEventListener("click", () => {
      if (!editMode) {
        preEdit = itemsToText(ITEMS)
      }
      editMode = !editMode
      render()
    })

    elCancelEdit.addEventListener("click", () => {
      ITEMS = textToItems(preEdit)
      editMode = false
      render()
    })

    elAddItem.addEventListener("click", () => opencModal(null))

    const normalizeItems = items => {
      return items.map(it => {
        const obj = {
          name: String(it.name || "Untitled").trim(),
          img: (it.img || "").toString().trim(),
          stock: it.stock || 0,
        }
        if (it.display) obj.display = it.display.toString().trim()
        if (it.low != null) obj.low = it.low
        return obj
      })
    }

    elSaveItems.addEventListener("click", async () => {
      if (preEdit === itemsToText(ITEMS)) {
        editMode = false
        render()
        return
      }

      const payload = { list_builder: { items: normalizeItems(ITEMS) } }

      const res = await fetch(SAVE_ENDPOINT, {
        method: "PATCH",
        headers: {
          "Content-Type": "application/json",
          "X-CSRF-Token": csrfToken(),
          "Accept": "application/json"
        },
        body: JSON.stringify(payload),
        credentials: "same-origin"
      })

      if (res.ok) {
        const data = await res.json().catch(() => null)
        showFlash("Saved!")
        editMode = false
        if (data?.items) applyBuilderSnapshot(data.items, data.timestamp)
        else render()
        return
      }

      const err = await res.text().catch(() => "")
      console.error("Save failed", res.status, err)
      alert("Save failed")
    })

    // ---------- WebSocket setup ----------
    listSocket = new AuthWS(
      { channel: "ListJsonChannel", channel_id: `list_${LIST_ID}` },
      {
        onopen() {
          elWsStatus.classList.add("hidden")
          listSocket.send({
            subscribe: { channel: "ListBuilderChannel", channel_id: `builder_${BUILDER_ID}` }
          })
          resync()
        },
        onclose() {
          elWsStatus.classList.remove("hidden")
        },
        onmessage(msg) {
          if (msg.list_data?.items) {
            const names = msg.list_data.items.filter(item => !item.deleted_at).map(item => item.name)
            applyListSnapshot(names, msg.timestamp)
          }
          if (msg.builder_items) applyBuilderSnapshot(msg.builder_items, msg.timestamp)
        }
      }
    )

    // ---------- Boot ----------
    document.addEventListener("DOMContentLoaded", () => {
      render()
    })

    // A tablet that slept or dropped off wifi missed broadcasts; catch up.
    document.addEventListener("visibilitychange", () => {
      if (document.visibilityState === "visible") resync()
      else if (Object.keys(pendingStock).length > 0) flushStock(true)
    })
    window.addEventListener("online", () => {
      flushStock()
      resync()
    })

    window.addEventListener("beforeunload", e => {
      if (Object.keys(pendingStock).length > 0) flushStock(true)
      if (!editMode) return
      const current = itemsToText(ITEMS)
      if (current !== preEdit) {
        e.preventDefault()
        e.returnValue = ""
      }
    })
  </script>
<% end %>
