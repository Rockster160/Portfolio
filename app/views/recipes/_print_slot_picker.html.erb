<div class="slot empty">
  <div class="picker">
    <div class="picker-header">+ Add a recipe or page</div>
    <input type="text" placeholder="Search recipes and pages…" autocomplete="off">
    <div class="picker-list">
      <% if pickable.any? || pickable_pages.any? %>
        <% pickable.each do |r| %>
          <%
            new_slots = slot_ids.dup
            new_slots[slot_index] = r.id
            slots_param = new_slots.map { |x| x || "" }.join(",")
          %>
          <a href="<%= print_recipes_path(layout: layout_name, slots: slots_param) %>"
             data-title="<%= r.title.to_s.downcase %>">
            <%= r.title %>
          </a>
        <% end %>
        <% pickable_pages.each do |pg| %>
          <%
            new_slots = slot_ids.dup
            new_slots[slot_index] = "p#{pg.id}"
            slots_param = new_slots.map { |x| x || "" }.join(",")
          %>
          <a href="<%= print_recipes_path(layout: layout_name, slots: slots_param) %>"
             data-title="<%= pg.name.to_s.downcase %>">
            <%= pg.name %> <span class="kind">page</span>
          </a>
        <% end %>
      <% else %>
        <div class="picker-empty">No recipes or pages available.</div>
      <% end %>
    </div>
  </div>
</div>
