<%
  slot_count = @layout == :card ? 4 : 1
%>
<div class="sheet <%= @layout == :card ? 'cards' : 'full' %>">
  <% (0...slot_count).each do |i| %>
    <% item = @slot_items[i] %>
    <% if item.is_a?(Page) %>
      <%= render "print_page_card",
        page: item,
        slot_ids: @slot_ids,
        slot_index: i,
        layout_name: @layout %>
    <% elsif item %>
      <%= render "print_card",
        recipe: item,
        slot_ids: @slot_ids,
        slot_index: i,
        pickable: @pickable,
        layout_name: @layout %>
    <% else %>
      <%= render "print_slot_picker",
        slot_ids: @slot_ids,
        slot_index: i,
        pickable: @pickable,
        pickable_pages: @pickable_pages,
        layout_name: @layout %>
    <% end %>
  <% end %>
</div>
