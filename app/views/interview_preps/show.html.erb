<%= meta_title "#{@prep.label} — prep" %>
<%= meta_description "Interview prep — #{@job.company}." %>

<div class="wide-container interview-back-row">
  <%= link_to "← #{@job.company}", interview_path(@job), class: :btn %>
</div>

<div class="wide-container interviews-page prep-page"
     style="--job-color: <%= @job.color %>;">
  <div class="app-card-container">
    <div class="app-card-title">
      <div class="job-identity">
        <div class="job-identity-names">
          <%= @prep.title.presence || @prep.label %>
          <div class="subtitle">
            <%= @job.company %><%= " · #{@job.role}" if @job.role.present? %>
          </div>
        </div>
      </div>
    </div>

    <div class="app-card-body">
      <div class="app-card-inner">
        <div class="prep-meta-row">
          <% if @prep.kind_label %>
            <span class="prep-kind"><%= @prep.kind_label %></span>
          <% end %>
          <%# When the interview is, not when the brief was written: the brief
             is read against the clock, and "in 50 minutes" is the whole reason
             the page is open. Past the hour it says the day instead, because
             by then it is reference for the next round. %>
          <% if @prep.interview_at %>
            <span>
              <%= @prep.spent? ? "was" : "" %>
              <%= interview_day(@prep.interview_at) %>
            </span>
          <% end %>
          <span>written <%= @prep.created_at.strftime("%b %-d, %-I:%M %p") %></span>
          <%= link_to "Delete", interview_prep_path(@job, @prep),
                method: :delete, class: "danger-link",
                data: { confirm: "Delete this prep?" } %>
        </div>

        <%# Collapsed, and above the body rather than under it: the brief runs
           to several screens, and an edit button at the far end of one is a
           scroll to get to and a scroll to get back from. %>
        <details class="prep-edit">
          <summary>Edit</summary>

          <%= form_with model: @prep, url: interview_prep_path(@job, @prep),
                method: :patch, local: true do |f| %>
            <div class="split-fields">
              <div class="form-field">
                <%= f.label :title, "Title" %>
                <%= f.text_field :title %>
              </div>

              <%# A text field rather than a list. The model keeps a kind it
                 did not anticipate and labels it by falling through, and a
                 select would quietly turn that back into one of six. %>
              <div class="form-field">
                <%= f.label :kind, "Kind" %>
                <%= f.text_field :kind, list: "prep-kinds" %>
                <datalist id="prep-kinds">
                  <% InterviewPrep::KINDS.each do |kind| %>
                    <option value="<%= kind %>"></option>
                  <% end %>
                </datalist>
              </div>
            </div>

            <div class="form-field">
              <%= f.label :body, "The brief" %>
              <%= f.text_area :body, rows: 24 %>
            </div>

            <div class="form-submission">
              <%= submit_tag "Save prep" %>
            </div>
          <% end %>
        </details>

        <%# The brief as the session wrote it. Nothing is reflowed or
           summarised on the way in or out — it was written to be read in ten
           minutes and a second opinion on its wording is not what the page is
           for. %>
        <div class="prep-body">
          <%= Markdown.new(@prep.body.to_s, user: current_user).to_html %>
        </div>
      </div>
    </div>
  </div>
</div>
