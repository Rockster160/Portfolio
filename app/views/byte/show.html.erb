<%= meta_title "Byte", include_name: false %>
<%= meta_description "Direct chat channel to your automations." %>
<%= content_for(:favicon) { render "byte/favicon" } %>
<%= content_for(:meta) do %>
  <%# interactive-widget=resizes-content: Android Chrome shrinks the layout %>
  <%# viewport when the soft keyboard opens so 100dvh + fixed positioning %>
  <%# both react. iOS Safari 16+ does this on its own via dvh units. %>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content">
  <%# Shell validation marker for the service worker. Only pages that %>
  <%# carry this meta are cached as the Byte shell — a stray error page %>
  <%# or auth interstitial without it never poisons the SW cache. %>
  <meta name="byte-shell" content="ok">
  <%# Deploy version. Changes only on server revisions, unlike the shell %>
  <%# HTML itself which fluctuates every request via the dynamic bootstrap %>
  <%# JSON. The SW compares THIS across revalidates to decide whether an %>
  <%# update is genuinely available — otherwise the reload "!" would %>
  <%# retrigger on every stale-while-revalidate cycle. %>
  <meta name="byte-version" content="<%= COMMIT_SHA %>">
<% end %>
<%= content_for(:head_before_scripts) do %>
  <script>
    // Byte lives on its own subdomain (byte.lvh.me in dev, byte.ardesian.com
    // in prod). The app-wide ActionCable meta tag points at a fixed dev host
    // (ws://localhost:3141/cable), so on a subdomain the WS handshake is
    // cross-origin and the session cookie doesn't travel with it — the
    // connection fails silently. Rewrite the meta to a same-host URL BEFORE
    // application.js parses.
    (function() {
      var meta = document.querySelector('meta[name="action-cable-url"]');
      if (!meta) return;
      var proto = location.protocol === 'https:' ? 'wss:' : 'ws:';
      meta.setAttribute('content', proto + '//' + location.host + '/cable');
    })();
  </script>
<% end %>

<%# Pet identity is per-conversation now. The hero follows the active thread's
    theme/expression; app chrome (avatar, favicon) uses the user's default pet so
    the branding stays stable when a non-buddy thread is open. %>
<% buddy_page_theme = @conversation.buddy? ? @conversation.buddy_theme : ByteConversation.default_theme_for(current_user) %>
<% app_pet_theme = ByteConversation.default_theme_for(current_user) %>
<div class="byte-app"
     data-monitor-channel="byte"
     data-messages-url="<%= byte_message_history_path %>"
     data-send-url="<%= byte_messages_path %>"
     data-csrf-url="<%= byte_csrf_path %>"
     data-conversations-url="<%= byte_conversations_path %>"
     data-claude-sessions-url="<%= byte_claude_sessions_path %>"
     data-initial-conversation-id="<%= @conversation.id %>"
     data-buddy-theme="<%= buddy_page_theme %>"
     data-active-mode="<%= @conversation.mode %>">
  <header class="byte-header">
    <%# Drawer trigger — sits before the avatar so it lands in the natural %>
    <%# top-left slot the user's thumb reaches for. %>
    <button type="button" class="byte-drawer-toggle" data-byte-drawer-toggle title="Conversations" aria-label="Open conversations">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
        <path fill="currentColor" d="M3 6h18v2H3zm0 5h18v2H3zm0 5h18v2H3z"/>
      </svg>
    </button>
    <span class="byte-avatar">
      <% if app_pet_theme == "moss" %>
        <%= image_tag "moss_favicon/moss.png", alt: "Moss" %>
      <% else %>
        <%= image_tag "byte_favicon/byte.png", alt: "Byte" %>
      <% end %>
    </span>
    <span class="byte-title">
      <span class="byte-title-row">
        <span class="byte-name" data-byte-convo-name><%= @conversation.display_name %></span>
        <span class="byte-mode-chip" data-byte-mode-chip data-mode="<%= @conversation.mode %>"><%= @conversation.mode %></span>
      </span>
      <span class="byte-status" data-byte-status>connecting…</span>
    </span>
    <%# Quiet syncing / offline badge. Empty when idle; the service %>
    <%# worker fills it via shell_synced / shell_sync_failed messages. %>
    <span class="byte-sync-badge" data-byte-sync data-state=""></span>
    <%# Reload — always tappable to force a hard refresh, and lights up %>
    <%# with a "!" badge when the SW has staged a new shell version. %>
    <button type="button" class="byte-reload-btn" data-byte-reload title="Reload" aria-label="Reload">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
        <path fill="currentColor" d="M17.65 6.35A7.958 7.958 0 0 0 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0 1 12 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35Z"/>
      </svg>
    </button>
    <button type="button" class="byte-notify-toggle" data-byte-notify title="Enable notifications" aria-label="Toggle notifications">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
        <path fill="currentColor" d="M12 22a2.4 2.4 0 0 0 2.4-2.4H9.6A2.4 2.4 0 0 0 12 22Zm6.6-6v-5a6.6 6.6 0 1 0-13.2 0v5L3 18.4V19h18v-.6Z"/>
      </svg>
    </button>
    <%# Buddy sound toggle — matches Whisper's mute control. Silences the timer %>
    <%# alarm when off. The `muted` class swaps the icon via CSS. %>
    <button type="button" class="byte-mute-toggle" data-byte-mute title="Toggle sound" aria-label="Toggle sound">
      <svg class="byte-mute-on" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
        <path fill="currentColor" d="M3 10v4h4l5 5V5L7 10H3Zm13.5 2a4.5 4.5 0 0 0-2.5-4v8a4.5 4.5 0 0 0 2.5-4Zm-2.5-9v2.06a7 7 0 0 1 0 13.88v2.06a9 9 0 0 0 0-18Z"/>
      </svg>
      <svg class="byte-mute-off" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
        <path fill="currentColor" d="M3 10v4h4l5 5V5L7 10H3Zm18.3-1.3-1.4-1.4L17 10.2 14.1 7.3l-1.4 1.4L15.6 12l-2.9 2.9 1.4 1.4L17 13.4l2.9 2.9 1.4-1.4L18.4 12l2.9-3.3Z"/>
      </svg>
    </button>
  </header>

  <%# Buddy hero — only visible when the active conversation is mode=:buddy. %>
  <%# Character up top with expression state + a small row of quick-prompt %>
  <%# chips that just pre-fill the composer with a Buddy-directed message. %>
  <%# Shrinks via CSS when the composer has focus so the keyboard doesn't %>
  <%# eat both the messages AND the character. %>
  <section class="byte-buddy-hero"
           data-buddy-hero
           data-buddy-theme="<%= buddy_page_theme %>"
           <%# Static default is `sleeping`: with no/broken JS, Byte honestly %>
           <%# looks asleep rather than fake-awake. JS wakes it to the stored %>
           <%# mood (data-buddy-awake-expression) once the channel connects. %>
           data-buddy-expression="sleeping"
           data-buddy-awake-expression="<%= @conversation.buddy_expression %>"
           data-buddy-active="<%= @conversation.mode == 'buddy' ? 'true' : 'false' %>"
           <%= (@conversation.mode == 'buddy' ? '' : 'hidden').html_safe %>>
    <%# Buddy timer chips — absolutely pinned to the hero's top-left, overlaying %>
    <%# Buddy's area so they don't push the character down. Rendered by %>
    <%# buddy/timers.js off the live Timer stack; empty + hidden when none. %>
    <div class="byte-buddy-timers" data-buddy-timers hidden></div>
    <div class="byte-buddy-char" aria-label="<%= buddy_page_theme == 'moss' ? 'Moss' : 'Byte' %>">
      <div class="byte-buddy-body" aria-hidden="true"></div>
      <div class="byte-buddy-face" aria-hidden="true"></div>
      <div class="byte-buddy-arm"  aria-hidden="true"></div>
    </div>
    <nav class="byte-buddy-quick-actions" data-buddy-quick-actions>
      <button type="button" data-buddy-action="today">Today</button>
      <button type="button" data-buddy-action="suggest">What now?</button>
      <button type="button" data-buddy-action="stash">Stash</button>
      <button type="button" data-buddy-action="checkin">Check-in</button>
      <button type="button" data-buddy-action="affirmation">Affirmation</button>
      <button type="button" data-buddy-action="facepick">Faces</button>
    </nav>
    <%# What now?: optionally focus the suggestion on a bucket. "Anything" is %>
    <%# the unfiltered "just tell me what to do" ask. %>
    <div class="byte-buddy-mood-popover" data-buddy-suggest-popover hidden>
      <span class="byte-buddy-mood-label">What now — which side?</span>
      <div class="byte-buddy-mood-choices">
        <button type="button" data-suggest="me">Me</button>
        <button type="button" data-suggest="home">Home</button>
        <button type="button" data-suggest="work">Work</button>
        <button type="button" data-suggest="anything">Anything</button>
      </div>
    </div>
    <%# Brain-dump: pick a bucket, then the NEXT message you send is filed as %>
    <%# an idea. "Anything" lets Buddy sort + summarize it for you. %>
    <div class="byte-buddy-mood-popover" data-buddy-stash-popover hidden>
      <span class="byte-buddy-mood-label">Stash an idea to…</span>
      <div class="byte-buddy-mood-choices">
        <button type="button" data-stash="me">Me</button>
        <button type="button" data-stash="home">Home</button>
        <button type="button" data-stash="work">Work</button>
        <button type="button" data-stash="anything">Anything</button>
      </div>
    </div>
    <div class="byte-buddy-mood-popover" data-buddy-mood-popover hidden>
      <span class="byte-buddy-mood-label">How are you feeling?</span>
      <div class="byte-buddy-mood-choices">
        <button type="button" data-mood="great">Great</button>
        <button type="button" data-mood="good">Good</button>
        <button type="button" data-mood="okay">Okay</button>
        <button type="button" data-mood="low">Low</button>
        <button type="button" data-mood="rough">Rough</button>
      </div>
    </div>
    <%# Debug-only picker: switch theme (Byte/Moss) and preview any face,
        including ones not wired into the mood system. Remove once done. %>
    <% face_names = ->(theme) {
         Dir[Rails.root.join("app/assets/images/buddy/#{theme}/face_*.png")]
           .map { |p| File.basename(p, ".png").delete_prefix("face_") }.sort
       } %>
    <div class="byte-buddy-face-popover" data-buddy-face-popover hidden>
      <span class="byte-buddy-mood-label">Debug: theme + face</span>
      <div class="byte-buddy-face-themes" data-buddy-face-themes>
        <button type="button" data-buddy-theme-set="byte">Byte</button>
        <button type="button" data-buddy-theme-set="moss">Moss</button>
      </div>
      <%# One grid per theme; JS shows the one matching the live theme so the
          picker only ever offers faces that theme actually has. %>
      <% %w[byte moss].each do |theme| %>
        <div class="byte-buddy-face-choices" data-buddy-face-choices data-face-theme="<%= theme %>"<%= " hidden".html_safe unless buddy_page_theme == theme %>>
          <% face_names.call(theme).each do |f| %>
            <button type="button" data-face="<%= f %>"><%= f.tr('_', ' ') %></button>
          <% end %>
        </div>
      <% end %>
    </div>
  </section>

  <%# Slim strip glued to the bottom of the header showing the effective %>
  <%# cwd (defaults to Portfolio) and the currently-adopted Claude session %>
  <%# name, if any. Visually part of the header block — subtle secondary %>
  <%# context, not a separate section. %>
  <div class="byte-pwd-bar" data-byte-pwd data-visible="true">
    <span class="byte-pwd-icon" aria-hidden="true">›</span>
    <span class="byte-pwd-path" data-byte-pwd-path><%= short_home(@conversation.metadata['cwd'] || "~/code/Portfolio") %></span>
    <span class="byte-pwd-session" data-byte-pwd-session<%= " hidden" if @conversation.metadata['claude_session_name'].blank? %>>
      <span class="byte-pwd-sep" aria-hidden="true">·</span>
      <span data-byte-pwd-session-name><%= @conversation.metadata['claude_session_name'] %></span>
    </span>
    <%# Permission mode toggle — Claude-mode only. "auto" = the Mac approves %>
    <%# tool calls without prompting (for long unattended features). %>
    <% perm_mode = @conversation.metadata['permission_mode'] == 'auto' ? 'auto' : 'ask' %>
    <button type="button" class="byte-pwd-mode" data-byte-pwd-mode data-mode="<%= perm_mode %>"
            title="Permission mode — tap to toggle auto-approve"
            <%= 'hidden'.html_safe unless @conversation.mode == 'claude' %>>
      <span class="byte-pwd-mode-dot" aria-hidden="true"></span>
      <span data-byte-pwd-mode-label><%= perm_mode %></span>
    </button>
  </div>

  <%# Preload every face for the active theme so an expression change never %>
  <%# flashes blank while the PNG/SVG fetches — they land in the browser %>
  <%# cache up front, so the CSS background swap is instant. Off-screen (not %>
  <%# display:none) to guarantee the fetch. %>
  <% buddy_theme = buddy_page_theme.presence || "byte" %>
  <div class="byte-buddy-preload" aria-hidden="true">
    <% Dir[Rails.root.join("app/assets/images/buddy/#{buddy_theme}/face_*.{png,svg}")].sort.each do |p| %>
      <img src="<%= image_path("buddy/#{buddy_theme}/#{File.basename(p)}") %>" alt="" width="1" height="1" decoding="async">
    <% end %>
  </div>

  <main class="byte-thread" data-byte-thread aria-live="polite" aria-relevant="additions">
    <%# Older-history loading indicator. Hidden by default; JS toggles %>
    <%# when a paginated fetch is in flight or "no more" is confirmed. %>
    <div class="byte-thread-loader" data-byte-loader hidden>loading…</div>
  </main>

  <%# Floating jump-to-newest. Visible while user is scrolled off the %>
  <%# bottom; the count reflects messages received while scrolled up. %>
  <button type="button" class="byte-jump-btn" data-byte-jump aria-label="Jump to newest">
    <span class="byte-jump-arrow" aria-hidden="true">↓</span>
    <span class="byte-jump-count" data-byte-jump-count></span>
  </button>

  <template data-byte-message-tpl>
    <article class="byte-msg">
      <%# Cancel affordance — only revealed for messages still held in the %>
      <%# queue (Buddy asleep / offline). JS shows it; tapping drops the %>
      <%# message before it dispatches. %>
      <button type="button" class="byte-msg-cancel" data-msg-cancel aria-label="Cancel message" hidden>✕</button>
      <div class="byte-msg-attachments" data-attachments></div>
      <%# Collapsible thoughts (Claude's intermediate reasoning + tool %>
      <%# uses). Hidden entirely for non-Claude messages. %>
      <details class="byte-msg-thoughts" data-thoughts hidden>
        <summary data-thoughts-summary>Thinking</summary>
        <div class="byte-msg-thoughts-body" data-thoughts-body></div>
      </details>
      <%# Cross-user relay attribution header. Incoming: the sending Buddy's %>
      <%# icon + name. Outgoing (your Buddy passed something along): your own %>
      <%# Buddy's icon, an arrow, then the destination Buddy's icon + name. %>
      <%# Hidden unless the message carries relay_peer metadata. %>
      <div class="byte-msg-peer" data-peer hidden>
        <img class="byte-msg-peer-icon" data-peer-from-icon alt="" aria-hidden="true" hidden>
        <span class="byte-msg-peer-arrow" data-peer-arrow hidden>→</span>
        <img class="byte-msg-peer-icon" data-peer-icon alt="" aria-hidden="true">
        <span class="byte-msg-peer-name" data-peer-name></span>
      </div>
      <div class="byte-msg-body" data-body></div>
      <%# Activity-chip footnote: which tool ran and with what. Its own element %>
      <%# so it can sit quietly under the receipt instead of competing with it. %>
      <div class="byte-msg-activity-detail" data-activity-detail hidden></div>
      <div class="byte-msg-meta">
        <time data-time></time>
        <span class="byte-msg-state" data-state></span>
      </div>
    </article>
  </template>

  <%# Persistent sleeping chip — pinned above the composer while Buddy is %>
  <%# asleep (usage cap) or the realtime channel is down. Stays until Byte %>
  <%# wakes; messages sent meanwhile queue below it with a cancel ✕. %>
  <div class="byte-sleep-chip" data-byte-sleep-chip hidden>
    <span class="byte-sleep-chip-dot" aria-hidden="true">💤</span>
    <span class="byte-sleep-chip-text" data-byte-sleep-text></span>
  </div>

  <%# Slash-command autocomplete popover. Positioned above the composer, %>
  <%# shown when the input's first char is `/`. JS fills / hides it. %>
  <div class="byte-slash-popover" data-byte-slash-popover hidden role="listbox" aria-label="Slash commands"></div>

  <form class="byte-composer" data-byte-composer autocomplete="off" data-mode="<%= @conversation.mode %>">
    <%# Pending-image tray. Full-width first row (the composer wraps), holds a %>
    <%# thumbnail chip per picked/pasted/dropped image while it uploads to %>
    <%# /byte/uploads. Hidden until something's in it; JS owns its contents. %>
    <div class="byte-attach-tray" data-byte-attach-tray hidden></div>
    <%# Hidden file picker driven by the attach button below. %>
    <input type="file" class="byte-attach-input" data-byte-file accept="image/*" multiple hidden aria-hidden="true">
    <%# Single mode-adaptive avatar to the left of the input: %>
    <%#   Claude  → Byte image %>
    <%#   Jarvis  → Ardesian favicon (proxy for the Jarvis mark) %>
    <%#   Bash    → `$` in lime monospace %>
    <%#   Buddy   → speech-bubble glyph in violet %>
    <%# CSS on `.byte-composer[data-mode="…"]` toggles which child is visible. %>
    <span class="byte-composer-avatar" data-byte-composer-avatar>
      <img class="byte-composer-avatar-img byte-composer-avatar-claude"
           src="<%= asset_path('byte_favicon/byte.png') %>" alt="Byte">
      <img class="byte-composer-avatar-img byte-composer-avatar-jarvis"
           data-byte-composer-avatar-jarvis src="" alt="Jarvis">
      <span class="byte-composer-avatar-bash">$</span>
      <span class="byte-composer-avatar-buddy">💬</span>
    </span>
    <%# Bash is a shell REPL — auto-capitalize/correct/spellcheck mangle %>
    <%# commands, flags, and paths, so they're off in that mode. JS keeps %>
    <%# these in sync on conversation switch (conversations.js). %>
    <% bash_mode = @conversation.mode.to_s == "bash" %>
    <textarea
      class="byte-input"
      data-byte-input
      rows="1"
      placeholder="Say something to <%= buddy_page_theme == 'moss' ? 'Moss' : 'Byte' %>…"
      autocapitalize="<%= bash_mode ? 'none' : 'sentences' %>"
      autocorrect="<%= bash_mode ? 'off' : 'on' %>"
      spellcheck="<%= bash_mode ? 'false' : 'true' %>"
      enterkeyhint="enter"
    ></textarea>
    <%# Attach an image. Bash is a shell REPL — no images there — so CSS hides %>
    <%# this button in bash mode. %>
    <button type="button" class="byte-attach" data-byte-attach aria-label="Attach image">
      <svg viewBox="0 0 24 24" width="21" height="21" aria-hidden="true">
        <path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"
              d="M4 17V6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6M4 17l4.5-4.5a2 2 0 0 1 2.8 0L16 17M14 13l1.8-1.8a2 2 0 0 1 2.8 0L20 13"/>
        <circle cx="9" cy="9" r="1.6" fill="currentColor"/>
      </svg>
    </button>
    <button type="submit" class="byte-send" data-byte-send aria-label="Send">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
        <path fill="currentColor" d="M3.4 20.6 22 12 3.4 3.4l-.1 6.7L17 12 3.3 13.9Z"/>
      </svg>
    </button>
  </form>
</div>

  <%# Slide-in conversations drawer + backdrop. Hidden by default; %>
  <%# .open on both elements when active. %>
  <aside class="byte-drawer" data-byte-drawer aria-hidden="true">
    <div class="byte-drawer-header">
      <span class="byte-drawer-title">Conversations</span>
      <button type="button" class="byte-drawer-close" data-byte-drawer-close aria-label="Close">×</button>
    </div>
    <button type="button" class="byte-new-convo" data-byte-new-convo>+ New conversation</button>
    <ul class="byte-convo-list" data-byte-convo-list></ul>

    <%# Saved routines — a phrase that runs a whole sequence. Read-only here on %>
    <%# purpose: the STEPS are tool calls with validated arguments, so they get %>
    <%# written by talking to Byte. This is for reviewing and pruning them. %>
    <section class="byte-routines" data-byte-routines hidden>
      <h2 class="byte-routines-title">Routines</h2>
      <ul class="byte-routine-list" data-byte-routine-list></ul>
    </section>
    <%# Build fingerprint pinned to the bottom of the drawer so you can %>
    <%# eyeball whether a "hard reload" actually landed a fresh shell. %>
    <%# `shell` = COMMIT_SHA of the deployed HTML at page-render time; %>
    <%# `sw` = version reported by the currently-active service worker %>
    <%# (may lag behind if the SW cached an older shell). Both should %>
    <%# match on a real fresh load. %>
    <footer class="byte-drawer-version" data-byte-version-footer>
      <div><span class="k">shell</span> <span class="v" data-byte-version-shell><%= COMMIT_SHA[0, 7] %></span></div>
      <div><span class="k">sw</span> <span class="v" data-byte-version-sw>…</span></div>
      <div><span class="k">app-h</span> <span class="v" data-byte-version-apph>…</span></div>
      <div><span class="k">vv-h</span> <span class="v" data-byte-version-vvh>…</span></div>
      <div><span class="k">win-h</span> <span class="v" data-byte-version-winh>…</span></div>
    </footer>
  </aside>
  <div class="byte-drawer-backdrop" data-byte-drawer-backdrop aria-hidden="true"></div>

  <%# New-conversation dialog. Native <dialog> for accessibility + %>
  <%# built-in dismiss behaviour. %>
  <dialog class="byte-modal" data-byte-new-modal>
    <form class="byte-modal-form basic" data-byte-new-form method="dialog" autocomplete="off">
      <h3 class="byte-modal-title">New conversation</h3>
      <label class="byte-modal-label">
        Name
        <input type="text" class="byte-modal-input" name="name" placeholder="Optional (defaults to mode name)">
      </label>
      <label class="byte-modal-label">
        Mode
        <select class="byte-modal-input" name="mode">
          <option value="claude" selected>Claude — AI conversation</option>
          <option value="bash">Bash — shell commands, no prefix</option>
          <option value="jarvis">Jarvis — automation commands</option>
          <option value="buddy">Buddy — conversational LLM chat</option>
        </select>
      </label>
      <div class="byte-modal-actions">
        <button type="button" class="byte-modal-btn" data-byte-new-cancel>Cancel</button>
        <button type="submit" class="byte-modal-btn byte-modal-btn-primary">Create</button>
      </div>
    </form>
  </dialog>

  <%# Per-conversation menu (rename/archive/adopt Claude session). %>
  <dialog class="byte-modal" data-byte-convo-menu>
    <div class="byte-modal-form basic">
      <h3 class="byte-modal-title" data-byte-menu-title>Conversation</h3>
      <div class="byte-menu-list">
        <button type="button" class="byte-menu-btn" data-byte-menu-rename>Rename…</button>
        <button type="button" class="byte-menu-btn" data-byte-menu-adopt>Adopt Claude session…</button>
        <button type="button" class="byte-menu-btn byte-menu-btn-danger" data-byte-menu-archive>Archive</button>
      </div>
      <div class="byte-modal-actions">
        <button type="button" class="byte-modal-btn" data-byte-menu-close>Close</button>
      </div>
    </div>
  </dialog>

  <%# Adopt-session picker. Populated from the Mac's /byte/claude_sessions. %>
  <dialog class="byte-modal byte-modal-wide" data-byte-adopt-modal>
    <div class="byte-modal-form basic">
      <h3 class="byte-modal-title">Adopt Claude session</h3>
      <p class="byte-modal-hint" data-byte-adopt-hint>Loading…</p>
      <ul class="byte-adopt-list" data-byte-adopt-list></ul>
      <div class="byte-modal-actions">
        <button type="button" class="byte-modal-btn" data-byte-adopt-close>Close</button>
      </div>
    </div>
  </dialog>

<script id="byte-bootstrap" type="application/json">
  <%= raw JSON.generate(
    conversation:  @conversation.as_wire,
    conversations: @conversations.map(&:as_wire),
    messages:      @messages.map(&:as_wire),
    buddy_sleep: {
      sleep_until: (@conversation.buddy_sleep_until&.iso8601 if ::Buddy::SleepGuard.sleeping?(current_user)),
      wake_string: (::Buddy::SleepGuard.wake_string(current_user) if ::Buddy::SleepGuard.sleeping?(current_user)),
    },
  ) %>
</script>
