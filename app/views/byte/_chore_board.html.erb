<%# The chore board's pad: one group of chores as circles big enough to hit
    without looking, in place of the kiosk's routine buttons.

    Unlike the routine pad next door, the cells are built ONLY by
    buddy/chore_board.js — not server-rendered here as well. The set changes
    under this screen all day (a tap from a phone, somebody else in the
    household, the 4am reset bringing a new day's chores in), so the client has
    to be able to build a cell from scratch anyway; rendering them twice would
    mean two implementations of the same circle that have to agree, which is
    the trap the routine pad's own comment warns about.

    Nothing is waited on for the first paint: `data-board-items` on .byte-app
    carries the serialized set — chores and triggers alike — so the script
    paints from the page it arrived in and only then goes and asks whether
    anything changed. %>
<section class="byte-board" data-byte-board>
  <%# Shown while the live connection is down (index.js stamps
      data-connection on .byte-app), so a wall that has quietly stopped
      hearing about presses elsewhere says so instead of looking current. %>
  <div class="byte-board-offline" role="status">
    <span class="byte-board-offline-dot" aria-hidden="true"></span>Disconnected · reconnecting…
  </div>
  <div class="byte-board-pad" data-board-pad role="list"></div>

  <%# Two different kinds of nothing, and they want different sentences. No TAG
      means nobody has told this screen what it looks after, which is a setting
      to go and change; an empty tag means everything due is done, which is the
      good one and the whole point of the board. %>
  <p class="byte-board-empty" data-board-empty hidden></p>

  <%# Which group this screen looks after. The control is the tag itself rather
      than a gear, for the same reason the companion picker is the pet's own
      face: what it changes is legible without a label. %>
  <%# Beside it, the board's own chat: it swaps the pad for this thread and its
      composer (rendered by show.html.erb, hidden on a kiosk until this is
      open), so the board can be set up by talking to its pet. Owner-only - the
      turn runs as the owner, and a message from anyone else would land in
      their own thread instead. %>
  <div class="byte-board-corner">
    <button type="button" class="byte-board-tag" data-board-tag-toggle
            aria-label="Choose which chores this screen looks after"
            title="Choose which chores this screen looks after"><%= Array(@board_tags).join(", ").presence || "Pick groups" %></button>
    <% if @board_owned %>
      <button type="button" class="byte-board-chat-toggle" data-board-chat-toggle
              aria-expanded="false"
              aria-label="Talk to <%= Buddy::Themes.name_for(@conversation.buddy_theme) %> about this board"
              title="Talk to <%= Buddy::Themes.name_for(@conversation.buddy_theme) %> about this board">
        <span class="byte-board-chat-open" aria-hidden="true">💬</span>
        <span class="byte-board-chat-close" aria-hidden="true">← Board</span>
      </button>
    <% end %>
  </div>
  <div class="byte-board-tag-picker" data-board-tag-picker hidden>
    <%# Taps save the moment they're made; typed fields save with their own
        button. The panel's border says which state it's in - orange while
        something typed hasn't been saved, a brief flash when a save lands -
        and a tap anywhere outside puts it away. %>
    <%# The board's own name, heading the panel it names. Owner-only. %>
    <% if @board_owned %>
      <form class="byte-board-rename byte-board-name" data-board-rename-form
            data-url="<%= byte_conversation_path(@conversation) %>">
        <input type="text" class="byte-msg-form-input" data-board-rename-input
               value="<%= @conversation.display_name %>" maxlength="60"
               autocomplete="off" autocorrect="off" autocapitalize="words"
               spellcheck="false" aria-label="Board name">
        <button type="submit" class="byte-board-rename-save" data-board-rename-save>Rename</button>
      </form>
    <% end %>

    <%# Rebuilt by chore_board.js on every open, so nothing that has to survive
        goes inside it. %>
    <div class="byte-board-tag-list" data-board-tag-list></div>

    <% if @board_owned %>
      <%# What this board keeps OFF, as a search: a chore it matches stays off
          even when a group above (or "All") brings it. Each term hides on its
          own; parentheses join terms into one. %>
      <form class="byte-board-hidden" data-board-hidden-form
            data-url="<%= byte_board_hidden_path %>">
        <span class="byte-board-tag-label">Hidden on this board</span>
        <div class="byte-board-rename">
          <input type="text" class="byte-msg-form-input" data-board-hidden-input
                 value="<%= @conversation.hidden_chore_filter %>"
                 placeholder='"Puppy Fed" group:home'
                 autocomplete="off" autocorrect="off" autocapitalize="off"
                 spellcheck="false" aria-label="Hide chores matching">
          <button type="submit" class="byte-board-rename-save" data-board-hidden-save>Save</button>
        </div>
        <p class="byte-board-bb-error" data-board-hidden-error hidden></p>
      </form>
    <% end %>

    <%# How big the circles are drawn on THIS screen - a phone and a wall tablet
        showing the same board want different sizes, so it is kept on the
        device rather than the board. %>
    <div class="byte-board-scale">
      <span class="byte-board-tag-label">Circle size on this screen</span>
      <div class="byte-setting-control">
        <button type="button" class="byte-drawer-step" data-board-scale-smaller aria-label="Smaller circles">−</button>
        <span class="byte-setting-value" data-board-scale-value>100%</span>
        <button type="button" class="byte-drawer-step" data-board-scale-bigger aria-label="Bigger circles">+</button>
      </div>
    </div>

    <%# Whose chores this board shows. Owner-only (set in #board), so a member
        looking at a shared board doesn't get it. Default is just the owner; the
        owner can add a housemate's chores - even ones they wouldn't normally see
        - or drop their own, to make a board that's all about someone else. A tick
        saves straightaway and the pad re-scopes, like the groups above. %>
    <% if @board_owned && Array(@board_members_options).size > 1 %>
      <div class="byte-board-members" data-board-members-section>
        <span class="byte-board-tag-label">Whose chores</span>
        <div class="byte-board-members-list">
          <% @board_members_options.each do |m| %>
            <label class="byte-board-member">
              <input type="checkbox" data-board-member value="<%= m[:id] %>"
                     <%= "checked" if Array(@board_member_ids).include?(m[:id]) %>>
              <span><%= m[:name] %></span>
            </label>
          <% end %>
        </div>
      </div>
    <% end %>

    <%# Credit buttons for THIS group: custom circles that mark a chore done and
        credit a chosen person. Managed here, in the one control the board already
        has, rather than behind new chrome over the circles. The whole section
        hides until a group is picked, since a button has to belong to one. %>
    <div class="byte-board-buttons" data-board-buttons-section hidden>
      <div class="byte-board-buttons-head">
        <span class="byte-board-tag-label">Credit buttons on this board</span>
        <button type="button" class="byte-board-bb-new" data-bb-new>+ New</button>
      </div>
      <div class="byte-board-buttons-list" data-board-buttons-list></div>
    </div>

    <%# Chores pinned to this board: on it whatever its groups are and whether
        or not they're due, like the Dailies list keeps a chore on Today. A
        pinned chore is still an ordinary circle - skip, wave off, the lot.
        Owner-only, like the other knobs. %>
    <% if @board_owned %>
      <div class="byte-board-buttons byte-board-pins" data-board-pins-section
           data-url="<%= byte_board_pins_path %>">
        <div class="byte-board-buttons-head">
          <span class="byte-board-tag-label">Pinned on this board</span>
          <button type="button" class="byte-board-bb-new" data-board-pin-add>+ Pin</button>
        </div>
        <div class="byte-board-buttons-list" data-board-pins-list></div>
      </div>
    <% end %>

    <%# Who can open the board, whether its pet dreams of chores, and who a
        press is done by: whoever's signed in, the person who uses the board,
        or nobody yet with the owner asked who it was. Owner-only,
        like the rest of the knobs, and here rather than on the index card: a
        board is managed from the board. Each saves on its own. %>
    <% if @board_owned %>
      <div class="byte-board-settings" data-board-settings
           data-share-url="<%= byte_board_shared_path %>"
           data-chore-dreams-url="<%= byte_board_chore_dreams_path %>"
           data-doer-url="<%= byte_board_doer_path %>">
        <label class="byte-board-member">
          <input type="checkbox" data-board-share <%= "checked" if @conversation.shared? %>>
          <span>Shared with the household</span>
        </label>
        <%# Hot-chore dreams have several knobs, so they live in their own dialog;
            this row says how they're set and opens it. %>
        <div class="byte-modal-label">
          Hot-chore dreams
          <button type="button" class="byte-modal-input byte-board-setting-open" data-board-dream-open>
            <span data-board-dream-summary></span>
          </button>
        </div>
        <label class="byte-modal-label">
          Chores done here are done by
          <select class="byte-modal-input" data-board-doer>
            <option value="" <%= "selected" if @board_doer.blank? %>>Whoever's signed in</option>
            <% Array(@board_members_options).each do |m| %>
              <option value="<%= m[:id] %>" <%= "selected" if @board_doer == m[:id].to_s %>><%= m[:name] %></option>
            <% end %>
            <option value="ask" <%= "selected" if @board_doer == "ask" %>>Ask me each time</option>
          </select>
        </label>
      </div>
    <% end %>

    <%# The way back. A board has no header and no composer - that is the point
        on a wall - and a screen you can walk into with no way out is a screen
        people close the tab on. Boards are their own kind of thread now, not
        chats, so this leads to the board index rather than the chat. Hung off
        the one control that is already here rather than adding a second piece
        of chrome over the circles. %>
    <%# Beside it, faintly, which build this screen is running - a number that
        climbs with every deploy, so a wall that hasn't taken one reads as
        behind at a glance. %>
    <div class="byte-board-foot">
      <a class="byte-board-leave" href="<%= byte_board_path %>">← All boards</a>
      <span class="byte-board-version" title="Board id # build this screen is running"><%= @conversation.id %>#<%= BUILD_NUMBER %></span>
    </div>
  </div>

  <%# Adding or editing a credit button: its own dialog, like Byte's other
      forms, opened by "+ New" or a tap on a button in the list. The form is
      reused for both, so there is one set of fields to get right; closing it
      drops the draft, since every open starts fresh. %>
  <%# The pace of the pet's hot-chore dreams (Buddy::BoardDream). Saved as a
      whole; closing it unsaved puts the fields back. %>
  <% if @board_owned %>
    <% pace = @conversation.dream_pace %>
    <dialog class="byte-modal" data-board-dream-dialog>
      <form class="byte-modal-form basic" data-board-dream-form autocomplete="off">
        <h3 class="byte-modal-title">Hot-chore dreams</h3>
        <p class="byte-modal-hint">Now and then the pet thinks of a hot chore that still needs doing.</p>
        <label class="byte-modal-label">
          Dreams
          <select class="byte-modal-input" name="on">
            <option value="true" <%= "selected" if @conversation.chore_dreams? %>>On</option>
            <option value="false" <%= "selected" unless @conversation.chore_dreams? %>>Off</option>
          </select>
        </label>
        <label class="byte-modal-label">
          A new draw every
          <select class="byte-modal-input" name="every">
            <% Buddy::BoardDream::EVERY_MINUTES.each do |m| %>
              <option value="<%= m %>" <%= "selected" if m == pace[:every] %>><%= board_minutes_label(m) %></option>
            <% end %>
          </select>
        </label>
        <label class="byte-modal-label">
          Chance a draw shows nothing
          <select class="byte-modal-input" name="blank">
            <% Buddy::BoardDream::BLANK_PERCENT.each do |pct| %>
              <option value="<%= pct %>" <%= "selected" if pct == pace[:blank] %>><%= pct.zero? ? "Never" : "#{pct}%" %></option>
            <% end %>
          </select>
        </label>
        <label class="byte-modal-label">
          After a dream, rest for
          <select class="byte-modal-input" name="rest">
            <% Buddy::BoardDream::REST_MINUTES.each do |m| %>
              <option value="<%= m %>" <%= "selected" if m == pace[:rest] %>><%= m.zero? ? "No rest" : board_minutes_label(m) %></option>
            <% end %>
          </select>
        </label>
        <div class="byte-board-quiet">
          <label class="byte-modal-label">
            Quiet from
            <select class="byte-modal-input" name="quiet_from">
              <option value="" <%= "selected" if pace[:quiet_from].nil? %>>Off</option>
              <% Buddy::BoardDream::HOURS.each do |h| %>
                <option value="<%= h %>" <%= "selected" if h == pace[:quiet_from] %>><%= board_hour_label(h) %></option>
              <% end %>
            </select>
          </label>
          <label class="byte-modal-label">
            Until
            <select class="byte-modal-input" name="quiet_to">
              <option value="" <%= "selected" if pace[:quiet_to].nil? %>>Off</option>
              <% Buddy::BoardDream::HOURS.each do |h| %>
                <option value="<%= h %>" <%= "selected" if h == pace[:quiet_to] %>><%= board_hour_label(h) %></option>
              <% end %>
            </select>
          </label>
        </div>
        <div class="byte-modal-actions">
          <button type="button" class="byte-modal-btn" data-board-dream-cancel>Cancel</button>
          <button type="submit" class="byte-modal-btn byte-modal-btn-primary">Save</button>
        </div>
      </form>
    </dialog>
  <% end %>

  <dialog class="byte-modal" data-bb-dialog>
    <form class="byte-modal-form basic byte-board-button-form" data-board-button-form autocomplete="off">
      <h3 class="byte-modal-title" data-bb-title>New credit button</h3>
      <label class="byte-modal-label">
        Label
        <input type="text" class="byte-modal-input" data-bb-label
               placeholder="e.g. Dishes, by me" maxlength="60" required>
      </label>

      <%# Completes: a type-to-find chore picker rather than a select of every
          chore in the house - the same "search to narrow it" the chores page
          leans on, so a chore can actually be found. The hidden input carries
          the chosen id; the text field is only for searching. %>
      <label class="byte-modal-label">
        Completes
        <%# The board's chore picker (searches names and aliases, shows icons);
            the hidden input carries the chosen id. %>
        <button type="button" class="byte-modal-input byte-board-chore-choice" data-bb-chore-pick>Pick a chore…</button>
        <input type="hidden" data-bb-chore>
      </label>

      <label class="byte-modal-label">
        Credits
        <select class="byte-modal-input" data-bb-credit></select>
      </label>

      <label class="byte-modal-label">
        Color
        <input type="color" class="byte-modal-input" data-bb-color value="#94A3B8">
      </label>

      <%# Which groups this button belongs to, comma-separated. Defaults to the
          groups the board is watching, so a button for the board you're on
          needs no thought; widen or narrow it to put the button on others. %>
      <label class="byte-modal-label">
        Groups
        <input type="text" class="byte-modal-input" data-bb-tags placeholder="Home, Morning">
      </label>

      <input type="hidden" data-bb-id value="">
      <p class="byte-board-bb-error" data-bb-error hidden></p>
      <div class="byte-modal-actions">
        <button type="button" class="byte-modal-btn" data-bb-cancel>Cancel</button>
        <button type="submit" class="byte-modal-btn byte-modal-btn-primary" data-bb-save>Add button</button>
      </div>
    </form>
  </dialog>

  <%# Picking a chore - a pin, what a credit button completes. The Chores
      page's search over a grid of each chore's own icon (see
      buddy/board_chore_picker.js). %>
  <dialog class="byte-modal byte-board-chore-picker" data-board-chore-picker>
    <div class="byte-modal-form basic">
      <h3 class="byte-modal-title" data-bcp-title>Pick a chore</h3>
      <input type="search" class="byte-modal-input" data-bcp-search
             placeholder="Search chores…" autocomplete="off"
             data-1p-ignore="true" data-lpignore="true">
      <div class="byte-board-chore-grid" data-bcp-grid></div>
      <p class="byte-board-tag-empty" data-bcp-empty hidden>No matches.</p>
      <div class="byte-modal-actions">
        <button type="button" class="byte-modal-btn" data-bcp-cancel>Cancel</button>
      </div>
    </div>
  </dialog>
</section>
