<%= meta_title "Interview Tracker" %>
<%= meta_description "Every place you applied, and everything that happened after." %>

<%
  # Chips are links carrying the same page with one filter written in, so the
  # bar always says exactly what is on screen. `live` is the default and the
  # reason rejections don't pile up in your face; Stale is the pile it hands
  # the wall's leftovers to, counted so it is never a disappearance.
  filters = [
    { key: "live", label: "Live", count: @live_count },
    { key: "active", label: "Active", count: @counts["active"].to_i },
    { key: "offer", label: "Offers", count: @counts["offer"].to_i },
    { key: "rejected", label: "Rejected", count: @counts["rejected"].to_i },
    { key: "closed", label: "Closed", count: @counts["closed"].to_i },
    { key: "ghosted", label: "Ghosted", count: @counts["ghosted"].to_i },
    { key: "stale", label: "Stale", count: @stale_count },
    { key: "all", label: "All", count: @counts.values.sum },
  ]
%>

<div class="wide-container interviews-page" data-interviews>
  <div class="app-card-container">
    <div class="app-card-title">
      Interview Tracker
      <div class="subtitle">
        Every place you applied, and everything that happened after.
      </div>
    </div>

    <div class="app-card-body">
      <div class="app-card-inner">
        <%# The top of the page is what you have to DO. An interview is already
           booked; one of these is an application that stops moving until you
           act, and until this strip existed the commonest of them - an ask for
           your availability - had nowhere above the fold to appear at all. %>
        <% if @waiting.any? %>
          <div class="interview-waiting">
            <h3>Waiting on you</h3>
            <ul>
              <% @waiting.each do |note| %>
                <li>
                  <span class="waiting-what"><%= note.owed %></span>
                  <%= link_to note.job_application.label, interview_path(note.job_application) %>
                  <span class="waiting-age"><%= waiting_age(note.occurred_at) %></span>
                  <% if note.url.present? %>
                    <%= link_to "read the mail", note.url, class: "waiting-link" %>
                  <% end %>
                </li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <%# Above what you merely owe people: an interview is the one thing here
           you have to turn up to. %>
        <% if @interviews.any? %>
          <div class="interview-booked">
            <h3>Interviews booked</h3>
            <ul>
              <% @interviews.each do |note| %>
                <li>
                  <span class="booked-when"><%= interview_day(note.follow_up_at) %></span>
                  <%= link_to note.job_application.label, interview_path(note.job_application) %>
                  <% if note.spoke_to.present? %>
                    <span class="field-hint">with <%= note.spoke_to %></span>
                  <% end %>
                  <%# Why one in the past is still here: it is held until the
                     timeline says something about it, so the line has to ask
                     for that rather than read as a date that slipped. %>
                  <% if note.follow_up_at.past? %>
                    <span class="field-hint">how did it go?</span>
                  <% end %>
                </li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <% if @follow_ups.any? %>
          <%# What you owe someone, across every application. Each one is also
             a task on the calendar — that answers "what's today", not "what am
             I chasing". %>
          <div class="interview-followups">
            <h3>Following up</h3>
            <ul>
              <% @follow_ups.each do |note| %>
                <li>
                  <span class="followup-when <%= "is-due" if note.follow_up_at <= Time.current.end_of_day %>">
                    <%= interview_day(note.follow_up_at, at_time: false) %>
                  </span>
                  <%= link_to note.job_application.company, interview_path(note.job_application) %>
                  <%# A follow-up usually has words on it; when it doesn't, its
                     tag is what there is to say. %>
                  <span class="field-hint">
                    <%= note.body.present? ? truncate(note.body, length: 70) : note.tag_label %>
                  </span>
                </li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <%# Where you STAND, which is the one question the rest of the page
           cannot answer. The three strips above are obligations and the wall
           below sorts by what was touched most recently - and most of what
           touches a row is a machine, so an application nobody has ever
           answered sits at the top of the wall on the strength of a job-alert
           digest. These are only the ones a person on their side has moved.
           A table rather than a list of sentences: every column is a value to
           compare down the page, which is what a table is for. %>
        <% if @in_play.any? %>
          <div class="interview-standing">
            <h3>Where you stand</h3>
            <table>
              <thead>
                <tr>
                  <%# "Reached", not "Stage": the FURTHEST rung, so a fresh
                     booking after an interview does not make the row read
                     shallower than it is. %>
                  <th>Reached</th>
                  <th class="num">Interactions</th>
                  <th>Company</th>
                  <th>Move</th>
                  <th class="num">Last</th>
                </tr>
              </thead>
              <tbody>
                <% @in_play.each do |job| %>
                  <% owed = job.owed_now %>
                  <tr>
                    <td><%= job.engagement_label %></td>
                    <td class="num"><%= job.interaction_count %></td>
                    <td><%= link_to job.label, interview_path(job) %></td>
                    <%# Whose move, off the last beat - the same reading the
                       strip at the top takes. One word, because the strip at
                       the top is where the task itself is named. %>
                    <td class="<%= "is-yours" if owed.present? %>">
                      <%= owed.present? ? "you" : "them" %>
                    </td>
                    <td class="num"><%= standing_age(job.engaged_at) %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% end %>

        <%# The exact complement of the table above, and the number a job search
           mostly consists of: applied, receipted by a machine, never answered
           by anybody. A figure rather than a list - there is nothing to do
           about any one of them, and eighty rows would bury the four that are
           moving.

           The second number is what makes the first readable. Most of a recent
           batch has simply not had time yet, so a big total with a big recent
           share inside it is a normal week rather than a dead board. %>
        <% if @silence[:total].positive? %>
          <div class="interview-silence">
            <strong><%= @silence[:total] %></strong> never answered
            <span class="field-hint">
              <%= @silence[:recent] %> of them applied in the past month
            </span>
          </div>
        <% end %>

        <%# One form for both halves of "pick a job, or name a new one, then
           write the note". The controller decides which happened, so this
           still works if the fieldset toggle never runs. %>
        <details class="interview-capture" <%= "open" if @live_jobs.empty? %>>
          <summary>+ Log something</summary>

          <%= form_with url: interviews_path, method: :post, local: true, data: { capture_form: true } do %>
            <div class="form-fields">
              <div class="form-field">
                <%= label_tag :job_application_id, "Which job" %>
                <%= select_tag :job_application_id,
                      options_for_select(@live_jobs.map { |job| [job.label, job.id] }),
                      include_blank: "+ A new one…",
                      data: { capture_picker: true } %>
              </div>

              <%# Only shown when "a new one" is selected. Source and url are
                 the initial application's, which is why they sit here and not
                 in the note below. %>
              <div class="capture-new" data-capture-new>
                <%= fields_for :job_application, @new_job do |f| %>
                  <%# Logo first, then the name — where a logo goes. The square
                     takes an emoji typed straight into it, a paste, a dropped
                     image, or a pick from the shared icon modal; an image
                     detours through the cropper so what gets stored is a 128px
                     square.

                     The scope wraps the row AND that cropper: `.identity-row`
                     is a flex row, and a panel opened inside it would be
                     squeezed in beside the name rather than sitting under the
                     pair. %>
                  <div class="logo-control" data-logo-scope>
                    <div class="identity-row">
                      <%= render "shared/icon_stack",
                            name: "job_application[logo]",
                            value: @new_job.logo,
                            label: "Company logo — type an emoji, paste or drop an image" %>

                      <div class="identity-names">
                        <div class="form-field">
                          <%= f.label :company %>
                          <%= f.text_field :company, placeholder: "Acme", data: { capture_company: true } %>
                        </div>

                        <div class="form-field">
                          <%= f.label :role, "Role" %>
                          <%= f.text_field :role, placeholder: "Staff Engineer" %>
                        </div>
                      </div>
                    </div>

                    <%= render "logo_picker", save_label: "Use this crop" %>
                  </div>

                  <div class="split-fields">
                    <div class="form-field">
                      <%= f.label :source, "Source" %>
                      <%= f.text_field :source, placeholder: "LinkedIn" %>
                    </div>

                    <div class="form-field">
                      <%= f.label :url, "Listing URL" %>
                      <%= f.url_field :url, placeholder: "https://…" %>
                    </div>
                  </div>
                <% end %>
              </div>

              <%= fields_for :job_note, JobNote.new(occurred_at: Time.current) do |f| %>
                <%= render "note_fields", f: f, note_extras_open: false %>
              <% end %>

              <div class="form-submission">
                <%= submit_tag "Save" %>
                <span class="field-hint">A new company with no note is fine — the timeline can start later.</span>
              </div>
            </div>
          <% end %>
        </details>

        <%# Ranked, not just filtered: the company you typed comes first even when
           something touched more recently mentions it in a note. Carries the
           status chip along so the two narrow together. %>
        <form class="basic interview-search" method="get" action="<%= interviews_path %>">
          <% if @filter != "live" %>
            <input type="hidden" name="status" value="<%= @filter %>">
          <% end %>
          <input type="search" name="q" value="<%= @query %>"
                 placeholder="Search companies, notes, people, links…"
                 autocomplete="off" data-1p-ignore="true" data-lpignore="true">
          <button type="submit">Search</button>
          <% if @query.present? %>
            <span class="interview-search-count"><%= pluralize(@jobs.size, "match") %></span>
            <%= link_to "clear", interviews_path(status: (@filter unless @filter == "live")),
                  class: "interview-search-clear" %>
          <% end %>
        </form>

        <div class="interview-filters">
          <% filters.each do |filter| %>
            <%= link_to interviews_path(status: (filter[:key] unless filter[:key] == "live"), q: @query.presence),
                  class: "interview-chip #{"is-on" if @filter == filter[:key]}" do %>
              <%= filter[:label] %> <span class="chip-count"><%= filter[:count] %></span>
            <% end %>
          <% end %>
        </div>

        <% if @jobs.empty? %>
          <div class="interview-empty">
            <% if @query.present? %>
              Nothing matches &ldquo;<%= @query %>&rdquo;<%= " among #{@filter} applications" unless @filter == "live" %>.
              <%= link_to "Search them all", interviews_path(q: @query, status: :all) %>.
            <% elsif @filter != "all" && @counts.values.sum.positive? %>
              Nothing here yet. Try <%= link_to "all applications", interviews_path(status: :all) %>.
            <% else %>
              Nothing here yet. Log the first one above.
            <% end %>
          </div>
        <% else %>
          <div class="interview-grid">
            <% @jobs.each do |job| %>
              <%= render "job_card", job: job %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
