<%= meta_title @job.label %>
<%= meta_description "Interview tracker — #{@job.company}." %>

<%# The only way back — this app has no global nav — so it goes above the card
   where a back link goes, not under the timeline. `btn` at the top is what the
   other detail pages here use for exactly this. %>
<div class="wide-container interview-back-row">
  <%= link_to "← All applications", interviews_path, class: :btn %>
</div>

<%# The whole page is the logo scope: the square lives up in the title bar, in
   front of the company name, and the cropper it can open is down in the body.
   `data-logo-url` is what says there's a record to save to — a change to the
   square PATCHes rather than waiting for a submit. %>
<div class="wide-container interviews-page interview-show" data-interviews
     data-logo-scope data-logo-url="<%= interview_path(@job) %>"
     data-interview-job="<%= @job.id %>"
     style="--job-color: <%= @job.color %>;">
  <div class="app-card-container">
    <div class="app-card-title">
      <div class="job-identity">
        <%= render "shared/icon_stack",
              name: "job_application[logo]",
              value: @job.logo,
              size: "lg",
              label: "Company logo — type an emoji, paste or drop an image" %>

        <div class="job-identity-names">
          <%= @job.company %>
          <div class="subtitle">
            <%= @job.role.presence || "No role recorded" %>
          </div>
        </div>
      </div>
    </div>

    <div class="app-card-body">
      <div class="app-card-inner">
        <%= render "logo_picker", save_label: "Use this crop" %>

        <%# Nothing to stand on with an empty timeline, and the page already
           says so where the notes would be - unless what the job pays or where
           it is has been written down, which is worth a panel on its own
           before anybody has replied. %>
        <% if @notes.any? || @job.terms.any? %>
          <%= render "standing", job: @job %>
        <% end %>

        <%= render "rubric", job: @job %>

        <div class="job-header">
          <%= form_with model: @job, url: interview_path(@job), method: :patch, local: true,
                class: "basic job-status-form" do |f| %>
            <%= f.label :status, "Status" %>
            <%= f.select :status,
                  JobApplication.statuses.keys.map { |status| [status.humanize, status] },
                  {}, data: { status_select: true } %>
            <%= submit_tag "Update", class: "btn", data: { status_submit: true } %>
          <% end %>

          <div class="job-meta">
            <% if @job.source.present? %>
              <span>via <%= @job.source %></span>
            <% end %>
            <% if @job.url.present? %>
              <a href="<%= @job.url %>" target="_blank" rel="noopener">the listing</a>
            <% end %>
            <%# The employer's listing is dead weeks later as often as not. The
               local one is the working copy — the description as it was
               scraped, the score and why, the answers already given, the letter
               that was sent — and it only opens on his own machine, which is
               where the timeline is being read. %>
            <% if @job.jobhunt_url.present? %>
              <a href="<%= @job.jobhunt_url %>" target="_blank" rel="noopener">the local posting</a>
            <% end %>
            <span>tracked since <%= @job.created_at.strftime("%b %-d, %Y") %></span>
          </div>
        </div>

        <details class="job-details">
          <summary>Edit details</summary>
          <%= form_with model: @job, url: interview_path(@job), method: :patch, local: true do |f| %>
            <div class="form-fields">
              <div class="split-fields">
                <div class="form-field">
                  <%= f.label :company %>
                  <%= f.text_field :company %>
                </div>

                <div class="form-field">
                  <%= f.label :role, "Role" %>
                  <%= f.text_field :role %>
                </div>
              </div>

              <div class="split-fields">
                <div class="form-field">
                  <%= f.label :location, "Location" %>
                  <%= f.text_field :location, placeholder: "Remote · Salt Lake City, 4 days in office" %>
                </div>

                <div class="form-field">
                  <%= f.label :pay, "Pay" %>
                  <%= f.text_field :pay, placeholder: "160-170 + commissions" %>
                </div>
              </div>

              <div class="split-fields">
                <div class="form-field">
                  <%= f.label :source, "Source" %>
                  <%= f.text_field :source %>
                </div>

                <div class="form-field">
                  <%= f.label :url, "Listing URL" %>
                  <%= f.url_field :url %>
                </div>
              </div>

              <%# The names this employer's mail actually arrives under. A
                 vendor here is what stops its mail opening a row of its own —
                 see JobApplication::MAX_KNOWN_AS. %>
              <div class="form-field">
                <%= f.label :known_as_lines, "Also known as" %>
                <%= f.text_area :known_as_lines, rows: 3,
                      placeholder: "Institutional Capital Network\naccurate.com" %>
                <span class="field-hint">
                  One per line. A company name the mail might use instead, or the mail
                  domain of a service they hand part of the process to &mdash; a background
                  check, a signature service. Mail from one lands here rather than opening
                  an application of its own.
                </span>
              </div>

              <div class="form-field">
                <%= f.label :color, "Calendar colour" %>
                <%= f.color_field :color %>
                <span class="field-hint">Follow-ups from this job wear this colour on your agenda.</span>
              </div>

              <div class="form-submission">
                <%= submit_tag "Save" %>
                <%= link_to "Delete application", interview_path(@job), method: :delete, class: "btn danger",
                      data: { confirm: "Delete #{@job.company} and all #{pluralize(@notes.size, "note")}? This cannot be undone." } %>
              </div>
            </div>
          <% end %>
        </details>

        <%# Two rows for one application — jobhunt's and one opened off the ATS
           receipt — keep turning up. Either page works: the one jobhunt
           recorded is kept whichever side it's merged from. %>
        <% if @merge_candidates.any? %>
          <details class="job-details job-merge">
            <summary>Merge a duplicate</summary>
            <%= form_with url: merge_interview_path(@job), method: :post, local: true do |f| %>
              <div class="form-fields">
                <div class="form-field">
                  <%= f.label :other_id, "Merge with" %>
                  <%= f.select :other_id,
                        grouped_options_for_select(
                          @merge_candidates.transform_values { |jobs|
                            jobs.map { |job|
                              ["#{job.label} · ##{job.id} · #{pluralize(job.notes.size, "note")}", job.id]
                            }
                          },
                        ) %>
                  <span class="field-hint">
                    The one jobhunt recorded is kept, whichever page you merge from; with
                    neither or both, this one is. Every note moves onto it and the other is
                    deleted. An Applied beat within an hour after the receipt moves to 5
                    minutes before it.
                  </span>
                </div>

                <div class="form-submission">
                  <%= submit_tag "Merge", class: "btn danger",
                        data: { confirm: "Merge these two? Every note moves onto one and the other is deleted." } %>
                </div>
              </div>
            <% end %>
          </details>
        <% end %>

        <%# Writing comes before reading on this page: you open it because
           something just happened. The timeline below it runs newest first, so
           what you just added lands directly under the form. %>
        <details class="note-new" open>
          <summary>+ Add a note</summary>
          <%= form_with model: @note, url: interview_notes_path(@job), method: :post, local: true,
                multipart: true do |f| %>
            <div class="form-fields">
              <%= render "note_fields", f: f, note_extras_open: false %>

              <%# ONE SUBMIT FOR THE CONVERSATION AND THE BEAT SAYING IT
                 HAPPENED. They are one thing that happened, and logging them
                 separately meant writing the interview, saving, scrolling to
                 the panel below, and picking the beat back out of a dropdown
                 to say which one the recording was of. Closed, because most
                 beats are a sentence and have no recording at all. %>
              <details class="note-transcript-new">
                <summary>+ With a recording</summary>
                <%= render "transcript_intake", id: "note", notes: nil %>
              </details>

              <div class="form-submission">
                <%= submit_tag "Add note" %>
              </div>
            </div>
          <% end %>
        </details>

        <%= render "preps", job: @job, preps: @preps %>

        <%= render "transcripts", job: @job, transcripts: @transcripts, notes: @notes %>

        <h3 class="notes-heading">Timeline</h3>

        <% if @notes.empty? %>
          <div class="interview-empty">Nothing logged yet. Write the first note above.</div>
        <% else %>
          <ul class="interview-notes">
            <% @notes.each do |note| %>
              <%= render "note", note: note, job: @job, move_targets: @move_targets %>
            <% end %>
          </ul>
        <% end %>
      </div>
    </div>
  </div>
</div>
