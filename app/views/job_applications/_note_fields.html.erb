<%# The fields of a note, shared by the index's capture form, the show page's
   add form, and each note's own edit form. Everything below the body is
   optional and lives behind a <details> — a note is usually a sentence and a
   date, and a wall of empty inputs above it makes it feel like paperwork. %>
<div class="note-fields" data-note-fields>
  <div class="form-field">
    <%= f.label :body, "What happened" %>
    <%= f.text_area :body, rows: 3, placeholder: "Applied through their careers page. Job looks like mostly Rails." %>
  </div>

  <div class="split-fields">
    <div class="form-field">
      <%= f.label :tag, "Type" %>
      <%# Offered in the order these happen, each saying who causes it: half the
         list is the same moment seen from his side and theirs, and the names
         alone do not separate them. See JobNote::TAG_ORIGINS. %>
      <%= f.select :tag, JobNote.tag_options, {}, data: { note_tag: true } %>
    </div>

    <div class="form-field">
      <%= f.label :occurred_at, "When" %>
      <%= f.datetime_field :occurred_at,
            value: (f.object.occurred_at || Time.current).strftime("%Y-%m-%dT%H:%M") %>
    </div>
  </div>

  <%# The line the timeline shows with the beat collapsed. Above the extras
     rather than inside them: every beat has one, and a mail filed by Buddy
     arrives with it already written. %>
  <div class="form-field">
    <%= f.label :summary, "In one line" %>
    <%= f.text_field :summary, maxlength: JobNote::MAX_SUMMARY,
          placeholder: "Hiring manager round booked for Tue 3pm with Erik Brown" %>
    <span class="field-hint">Optional. The first line of what happened is used when this is blank.</span>
  </div>

  <%# RATED, NOT CLASSIFIED. Only shown for a beat he was actually in - see
     JobNote::CONVERSATIONS - because a slider under an ATS receipt is a number
     that means nothing. The tag decides, so JS shows and hides it as the Type
     dropdown moves; with no JS it is simply always there, which is the right
     way round for a field nobody is obliged to fill in. %>
  <div class="note-sentiment" data-note-sentiment
       data-conversation-tags="<%= JobNote::CONVERSATIONS.join(" ") %>">
    <div class="split-fields">
      <% JobNote::SENTIMENT.each do |field, question| %>
        <%# THE SCALE STARTS BELOW ZERO, AND THAT POSITION IS "NOT RATED".
           A range input always submits something - left alone it sits at the
           midpoint and posts a 5 - so with a plain 0-10 slider, editing the
           BODY of an interview beat would quietly invent a rating for it. The
           bottom notch is the unrated one and `JobNote` turns it back into nil,
           which is what keeps an unanswered question out of the average. 0 is a
           real score and stays one: "that was a disaster". %>
        <div class="form-field note-scale">
          <%= f.label field, question %>
          <div class="scale-row">
            <%= f.range_field field,
                  in:    JobNote::SENTIMENT_UNRATED..JobNote::SENTIMENT_CEILING,
                  step:  1,
                  value: f.object[field] || JobNote::SENTIMENT_UNRATED,
                  data:  { sentiment_slider: true, unrated: JobNote::SENTIMENT_UNRATED } %>
            <output class="scale-score" data-sentiment-score>
              <%= f.object[field] || "–" %>
            </output>
          </div>
        </div>
      <% end %>
    </div>
    <span class="field-hint">
      Out of <%= JobNote::SENTIMENT_CEILING %>, and only if you want to - all
      the way left is unrated, which is not the same as a zero. These average
      across the whole application.
    </span>
  </div>

  <details class="note-extras" <%= "open" if note_extras_open %>>
    <summary>Details &amp; follow-up</summary>

    <div class="split-fields">
      <div class="form-field">
        <%= f.label :spoke_to, "Spoke to" %>
        <%= f.text_field :spoke_to, placeholder: "Dana, recruiter" %>
      </div>

      <div class="form-field">
        <%= f.label :duration_minutes, "Duration (minutes)" %>
        <%= f.number_field :duration_minutes, min: 1, max: 1440, placeholder: "30" %>
      </div>
    </div>

    <div class="split-fields">
      <div class="form-field">
        <%= f.label :source, "Source" %>
        <%= f.text_field :source, placeholder: "LinkedIn" %>
      </div>

      <div class="form-field">
        <%= f.label :url, "Link" %>
        <%= f.url_field :url, placeholder: "https://…" %>
      </div>
    </div>

    <%# One date field, two meanings, and the label says which — on a Scheduled
       note it's the interview and goes on the agenda as an event; on anything
       else it's a chase you owe them and goes on as a task. Either way the
       agenda's own notifications do the reminding, and clearing the field takes
       the row back off. The label is swapped by JS; with none it reads as the
       common case. %>
    <div class="form-field">
      <%= f.label :follow_up_at, "Follow up on", data: { followup_label: true } %>
      <%= f.datetime_field :follow_up_at,
            value: f.object.follow_up_at&.strftime("%Y-%m-%dT%H:%M") %>
      <span class="field-hint" data-followup-hint>Optional. Goes on your agenda as a task.</span>
    </div>
  </details>
</div>
