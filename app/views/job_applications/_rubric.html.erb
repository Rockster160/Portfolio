<%# THE PROCESS: what is between applying and an answer, and how much of it has
   happened. The panel above says where this application stands; this says how
   far along it is, which is the other half of the same question and the one a
   timeline read bottom-up is worst at answering.

   Every search starts not knowing the rounds, so the list starts as the four
   that are always there. The company names its own later — "30 minutes with
   the team, then a live coding exercise, then the CEO for an hour" — and then
   the list is theirs. See JobApplication::DEFAULT_RUBRIC. %>
<%
  steps = job.rubric_steps
  done = steps.count(&:done?)
  next_up = steps.index { |step| !step.done? }
%>
<div class="job-rubric">
  <%= form_with url: rubric_interview_path(job), method: :patch, local: true do |f| %>
    <%# Tells an unchecked box from an absent form - see the controller. %>
    <%= hidden_field_tag "rubric[ticking]", 1 %>

    <div class="rubric-head">
      <h4>Process</h4>
      <span class="field-hint"><%= done %> of <%= steps.size %></span>
    </div>

    <ol class="rubric-steps">
      <% steps.each_with_index do |step, index| %>
        <li class="rubric-step <%= "is-done" if step.done? %> <%= "is-next" if index == next_up %>">
          <%# A step a BEAT answered is ticked and locked: the timeline is the
             record of it, and unticking it here would be overruled the moment
             the page reloaded. The way to say an interview didn't happen is to
             delete the interview. Everything else is his to tick. %>
          <label for="rubric-step-<%= index %>">
            <%= check_box_tag "rubric[done][]", index, step.done?,
                  id: "rubric-step-#{index}",
                  disabled: (step.done? && !step.by_hand),
                  title: ("Ticked by the timeline" if step.done? && !step.by_hand) %>
            <span class="rubric-name"><%= step.name %></span>
          </label>

          <span class="rubric-when">
            <% if step.done? %>
              <%= step.done_at.strftime("%b %-d") %>
            <% elsif step.tag.present? %>
              ticks on <%= JobNote::TAG_LABELS[step.tag].to_s.downcase %>
            <% end %>
          </span>
        </li>
      <% end %>
    </ol>

    <div class="rubric-save">
      <%= submit_tag "Save ticks", class: :btn %>
    </div>
  <% end %>

  <details class="job-details rubric-edit">
    <summary>Change the steps</summary>
    <%= form_with url: rubric_interview_path(job), method: :patch, local: true do |f| %>
      <div class="form-fields">
        <div class="form-field">
          <%= label_tag "rubric_lines", "One step per line" %>
          <%= text_area_tag "rubric[lines]", job.rubric_lines,
                id: "rubric_lines", rows: steps.size + 2 %>
          <span class="field-hint">
            Paste what they told you &mdash; bullets and numbering are fine. A step that
            still reads the same keeps its tick, so adding the rounds they just named
            doesn't undo the ones already answered. A step named after a beat (a recruiter
            screen, a take-home, an interview, an offer) ticks itself off when you log
            that beat; anything else you tick by hand. Empty it to go back to the standard
            four.
          </span>
        </div>

        <div class="form-submission">
          <%= submit_tag "Save steps" %>
        </div>
      </div>
    <% end %>
  </details>
</div>
