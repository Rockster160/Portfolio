<%# One entry in an application's timeline.
   A ROW IS ONE LINE. Every beat keeps the whole message now - a confirmation
   mail with its agenda, a rejection with its boilerplate - and twelve of those
   printed in full is a mailbox rather than a history. So the row is the date,
   the tag and one line saying what it was, and the message itself is behind the
   arrow. The edit form is behind its own, for the same reason it always was:
   the overwhelmingly common thing to do with a note is read it. %>
<li class="interview-note" id="note-<%= note.id %>">
  <div class="note-head">
    <span class="note-tag note-tag-<%= note.tag %>"><%= note.tag_label %></span>
    <span class="note-when"><%= note.occurred_at.strftime("%b %-d, %Y · %-I:%M %p") %></span>
    <% if note.spoke_to.present? %>
      <span class="note-meta">with <%= note.spoke_to %></span>
    <% end %>
    <% if note.duration_label.present? %>
      <span class="note-meta"><%= note.duration_label %></span>
    <% end %>
    <% if note.source.present? %>
      <span class="note-meta">via <%= note.source %></span>
    <% end %>
    <%# How it went, on the row. The two numbers rather than their mean: the
       whole reason there are two is that they disagree. %>
    <% note.sentiment.each do |field, score| %>
      <span class="note-score" title="<%= JobNote::SENTIMENT[field] %>">
        <%= field == :did_well ? "did" : "liked" %>
        <strong><%= score %></strong>/<%= JobNote::SENTIMENT_CEILING %>
      </span>
    <% end %>
  </div>

  <%# Above everything the beat says, not under it. A note that keeps the whole
     message runs to several screens, and a link to the mail it came from is no
     use at the far end of one - nor behind the arrow that hides it. %>
  <% if note.url.present? %>
    <a class="note-link" href="<%= note.url %>" target="_blank" rel="noopener"><%= note.url %></a>
  <% end %>

  <div class="note-headline"><%= note.headline %></div>

  <%# Open only when there is more than the headline to show. A beat whose body
     IS its headline - most things he types by hand - gets no arrow at all,
     rather than one that opens onto the same sentence again. %>
  <% if note.more_to_read? %>
    <details class="note-full">
      <summary>The whole of it</summary>

      <%# Printed verbatim, not through `simple_format`. The indentation someone
         typed to hang sub-notes under a line is part of what they wrote, and
         HTML collapses it on sight — the CSS holds it instead. `note_body`
         changes nothing about the text; it only makes the links in it
         clickable. %>
      <div class="note-body"><%= note_body(note.body) %></div>
    </details>
  <% end %>

  <%# The recording of THIS conversation, where there is one. On the beat rather
     than only in the list further down the page: a call and the transcript of
     that call are one thing that happened, and the transcript was a separate
     section you had to know to go and look in. %>
  <% note.transcripts.ordered.each do |transcript| %>
    <details class="note-transcript">
      <summary>
        <%= transcript.label %>
        <span class="note-meta">
          <%= pluralize(transcript.turns.size, "turn") %>
          <%= "· #{transcript.spoken_minutes} min" if transcript.spoken_minutes %>
        </span>
      </summary>

      <%# The conversation itself, and a link to the page that can CHANGE it.
         Naming speakers and moving turns is editing, which has its own page -
         this is for reading it where it happened. %>
      <%= link_to "Name the speakers, fix the turns →",
            interview_transcript_path(job, transcript), class: "note-link" %>

      <ol class="note-turns">
        <% transcript.turns.each do |turn| %>
          <li class="<%= "is-mine" if transcript.mine?(turn["speaker"]) %>">
            <span class="turn-who"><%= transcript.name_for(turn["speaker"]) %></span>
            <span class="turn-said"><%= turn["text"] %></span>
          </li>
        <% end %>
      </ol>
    </details>
  <% end %>

  <%# The same field, saying two different things: on a scheduled note the date
     is the interview itself, everywhere else it's a chase you owe them. %>
  <% if note.follow_up_at.present? %>
    <div class="note-followup <%= "is-interview" if note.scheduled? %>">
      <%= note.scheduled? ? "Interview" : "Follow up" %>
      <%= interview_day(note.follow_up_at) %>
      <% if note.follow_up_item.present? %>
        <span class="field-hint">· on your agenda</span>
      <% end %>
    </div>
  <% end %>

  <details class="note-edit">
    <summary>Edit</summary>
    <%# `namespace` prefixes every generated id. Without it each note's edit
       form emits the same `job_note_body` as the add form below, and every
       label on the page points at whichever one the browser found first. %>
    <%= form_with model: note, url: interview_note_path(job, note), method: :patch, local: true,
          namespace: "note#{note.id}" do |f| %>
      <%= render "note_fields", f: f, note_extras_open: true %>
      <%# WHOSE application this is. On a mail that arrived for a company the
         board holds more than once the row was a guess, and the beat has to be
         movable without being retyped - the alternative is a second copy on
         the right row and the guess left standing on the wrong one.

         Only on an existing beat's own form: the two forms that CREATE one
         already name the application another way. %>
      <div class="form-field note-move">
        <%= f.label :job_application_id, "On which application" %>
        <%= f.select :job_application_id,
              move_targets.map { |row| [row.label, row.id] },
              {}, data: { note_move: true } %>
      </div>
      <div class="form-submission">
        <%= submit_tag "Save note" %>
        <%= link_to "Delete", interview_note_path(job, note), method: :delete, class: "btn danger",
              data: { confirm: "Delete this note? Any follow-up it put on your agenda goes too." } %>
      </div>
    <% end %>
  </details>
</li>
