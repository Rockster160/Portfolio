<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.ardesian.buddy.refresh</string>
		<string>com.ardesian.buddy.flush</string>
	</array>
	<key>BuddyAppGroup</key>
	<string>$(BUDDY_APP_GROUP)</string>
	<key>BuddyKeychainGroup</key>
	<string>$(AppIdentifierPrefix)$(BUDDY_BUNDLE_ID)</string>
	<key>BuddyServerURL</key>
	<string>$(BUDDY_SERVER_URL)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Buddy</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.ardesian.buddy</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>buddy</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSAlarmKitUsageDescription</key>
	<string>Timers and alarms ring full screen, even on silent, like the Clock app.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Shows the battery level of your headphones and other connected accessories.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Shows your calendar in your agenda, and lets your Jil tasks use it.</string>
	<key>NSCameraUsageDescription</key>
	<string>Take a photo to send in a message.</string>
	<key>NSContactsUsageDescription</key>
	<string>Lets Buddy and your Jil tasks know who people are.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Logs your workouts with their type, duration and calories, and can send daily totals like steps and sleep.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Buddy doesn't save anything to Health.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>With Always, arriving and leaving places works even when the app is closed.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Lets your Jil tasks act on where you are, like when you get home.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Dictate a message.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Attach a photo from your library to a message.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>Shows your reminders in your lists, and lets your Jil tasks use them.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Turns what you say into a message.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSSupportsLiveActivitiesFrequentUpdates</key>
	<true/>
	<key>NSUserActivityTypes</key>
	<array>
		<string>com.ardesian.buddy.command</string>
	</array>
	<key>UIAppFonts</key>
	<array>
		<string>terminess-reg.ttf</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
		<string>fetch</string>
		<string>processing</string>
		<string>location</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>WKAppBoundDomains</key>
	<array>
		<string>ardesian.com</string>
		<string>byte.ardesian.com</string>
		<string>localhost</string>
		<string>byte.localhost</string>
	</array>
</dict>
</plist>
